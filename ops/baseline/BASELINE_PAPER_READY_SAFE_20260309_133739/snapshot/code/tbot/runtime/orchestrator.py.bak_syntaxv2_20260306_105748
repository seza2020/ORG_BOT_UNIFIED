def _safe_emit_meta(kind: str, payload: dict, level: str="INFO"):
    try:
        from tbot.meta.meta import meta
        from tbot.meta.announce import announce
        from tbot.meta.events import make_event
        ev = make_event(level=level, kind=kind, payload=payload)
        meta.emit(ev)
        announce.emit(ev)
    except Exception:
        # fallback: no-op
        pass

def compute_regime(snapshot: dict) -> dict:
    # placeholder – keep deterministic schema
    return {"regime": snapshot.get("regime", "UNKNOWN"), "confidence": float(snapshot.get("confidence", 0.0)), "alpha_mode": "ON"}

def build_core_context(snapshot: dict, regime: dict) -> dict:
    # placeholder – keep deterministic schema
    return {"bias": snapshot.get("bias", "FLAT"), "trend_strength": float(snapshot.get("trend_strength", 0.0)), "reason": "core_ctx_clean_v2"}

def compute_alpha_mode(core_ctx: dict, regime: dict) -> dict:
    # placeholder rule: alpha ON unless trend_strength too weak
    ts = float(core_ctx.get("trend_strength", 0.0))
    th = 0.35
    if ts < th:
        return {"mode": "OFF", "cap_ratio": 0.0, "reason": f"alpha_off_trend_weak(ts={ts:.3f},th={th})"}
    return {"mode": "ON", "cap_ratio": 1.0, "reason": "alpha_on_clean_v2"}

def _call_strategy(mod, ctx: dict, alpha_mode: dict):
    # support multiple strategy APIs safely
    if hasattr(mod, "generate_signal"):
        return mod.generate_signal(ctx)
    if hasattr(mod, "get_signal"):
        return mod.get_signal(ctx)
    if hasattr(mod, "eval_signal"):
        return mod.eval_signal(ctx, alpha_mode=alpha_mode)
    return None


def run_loop(args):
    """
    Minimal institutional restore patch (Option A):
      - boot / heartbeat / regime / core_context / alpha_mode / strategy_result
      - controlled placeholder plan generation
      - writes shadow_plans.jsonl only as auditable shadow plan, no order execution
    """
    import os, json, time
    from tbot.market.market_provider import build_market_snapshot

    runroot = os.getenv("TBOT_RUNROOT") or os.path.join(os.getcwd(), "runtime", "paper")
    logdir = os.path.join(runroot, "logs")
    os.makedirs(logdir, exist_ok=True)
    meta_path = os.path.join(logdir, "meta_events.jsonl")
    shadow_path = os.path.join(logdir, "shadow_plans.jsonl")

    def emit(kind, payload, level="INFO"):
        row = {
            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
            "level": level,
            "kind": kind,
            "run_id": getattr(args, "run_id", None),
            "payload": payload,
        }
        with open(meta_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
")

    def write_shadow(plan: dict):
        with open(shadow_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(plan, ensure_ascii=False) + "
")

    iters = int(getattr(args, "iters", 5) or 5)
    sleep_s = float(getattr(args, "sleep", 0.5) or 0.5)
    symbols = getattr(args, "symbols", None) or ["SPY","QQQ","IWM","NVDA","AAPL","TSLA"]

    boot_payload = {"iters": iters, "sleep": sleep_s, "symbols": list(symbols)}
    print("boot", boot_payload)
    emit("boot", boot_payload)

    for i in range(iters):
        snap = build_market_snapshot(symbols)

        hb = {"i": i, "has_snapshot": bool(snap is not None)}
        print("heartbeat", hb)
        emit("heartbeat", hb)

        if not snap:
            if sleep_s > 0:
                time.sleep(sleep_s)
            continue

        try:
            regime = compute_regime(snap)
            emit("regime", regime)
        except Exception as e:
            regime = {"regime": "ERROR", "confidence": 0.0, "reason": f"regime_exception:{e}"}
            emit("regime", regime, level="ERROR")

        try:
            core_ctx = build_core_context(snap, regime)
            emit("core_context", core_ctx)
        except Exception as e:
            core_ctx = {"bias": "FLAT", "trend_strength": 0.0, "reason": f"core_context_exception:{e}"}
            emit("core_context", core_ctx, level="ERROR")

        try:
            alpha = compute_alpha_mode(core_ctx, regime)
            emit("alpha_mode", alpha)
        except Exception as e:
            alpha = {"mode": "OFF", "cap_ratio": 0.0, "reason": f"alpha_mode_exception:{e}"}
            emit("alpha_mode", alpha, level="ERROR")

        strategy_result = {
            "symbol_count": len(symbols),
            "snapshot_ok": True,
            "regime": regime.get("regime"),
            "bias": core_ctx.get("bias"),
            "alpha_mode": alpha.get("mode"),
            "reason": "option_a_min_pipeline_v1"
        }
        emit("strategy_result", strategy_result)

        # controlled placeholder shadow plan
        if alpha.get("mode") == "ON":
            plan = {
                "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
                "run_id": getattr(args, "run_id", None),
                "sid": "A_MIN_PIPELINE",
                "symbol": symbols[0] if symbols else "SPY",
                "side": "BUY",
                "entry": None,
                "stop": None,
                "tp": None,
                "rr": None,
                "confidence": float(regime.get("confidence", 0.0)),
                "reason": "placeholder_shadow_plan_option_a"
            }
            emit("plan_created", plan)
            try:
                write_shadow(plan)
                emit("shadow_written", {"symbol": plan["symbol"], "sid": plan["sid"]})
            except Exception as e:
                emit("shadow_written", {"error": str(e)}, level="ERROR")

        if sleep_s > 0:
            time.sleep(sleep_s)

    shut = {"rc": 0, "iters": iters}
    print("shutdown", shut)
    emit("shutdown", shut)
    return 0

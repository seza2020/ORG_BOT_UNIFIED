import time
import traceback

# --- optional event emit (best-effort) ---
def _safe_emit_meta(kind: str, payload: dict, level: str="INFO"):
    try:
        from tbot.meta.meta import meta
        from tbot.meta.announce import announce
        from tbot.meta.events import make_event
        ev = make_event(level=level, kind=kind, payload=payload)
        meta.emit(ev)
        announce.emit(ev)
    except Exception:
        # fallback: no-op
        pass

def compute_regime(snapshot: dict) -> dict:
    # placeholder – keep deterministic schema
    return {"regime": snapshot.get("regime", "UNKNOWN"), "confidence": float(snapshot.get("confidence", 0.0)), "alpha_mode": "ON"}

def build_core_context(snapshot: dict, regime: dict) -> dict:
    # placeholder – keep deterministic schema
    return {"bias": snapshot.get("bias", "FLAT"), "trend_strength": float(snapshot.get("trend_strength", 0.0)), "reason": "core_ctx_clean_v2"}

def compute_alpha_mode(core_ctx: dict, regime: dict) -> dict:
    # placeholder rule: alpha ON unless trend_strength too weak
    ts = float(core_ctx.get("trend_strength", 0.0))
    th = 0.35
    if ts < th:
        return {"mode": "OFF", "cap_ratio": 0.0, "reason": f"alpha_off_trend_weak(ts={ts:.3f},th={th})"}
    return {"mode": "ON", "cap_ratio": 1.0, "reason": "alpha_on_clean_v2"}

def _call_strategy(mod, ctx: dict, alpha_mode: dict):
    # support multiple strategy APIs safely
    if hasattr(mod, "generate_signal"):
        return mod.generate_signal(ctx)
    if hasattr(mod, "get_signal"):
        return mod.get_signal(ctx)
    if hasattr(mod, "eval_signal"):
        return mod.eval_signal(ctx, alpha_mode=alpha_mode)
    return None

def run_loop(args):
    \"\"\"Enterprise-stable run loop (MarketSnapshot-aware, indentation-safe).
    هدف: پایداری Runtime + لاگ‌های قابل ممیزی. استراتژی‌ها بعداً روی این سوار می‌شوند.
    \"\"\"
    import os, time, traceback

    # ---- config / defaults ----
    iters = int(getattr(args, "iters", 10) or 10)
    sleep_sec = float(getattr(args, "sleep", 0.5) or 0.5)

    # canonical symbols (until config wiring is restored)
    symbols = ["SPY","QQQ","IWM","NVDA","AAPL","TSLA"]

    # ---- build snapshot (supports both signatures) ----
    snapshot = None
    try:
        from tbot.market.market_provider import build_market_snapshot
        try:
            snapshot = build_market_snapshot(symbols)
        except TypeError:
            snapshot = build_market_snapshot()
    except Exception:
        snapshot = None

    # ---- compute regime / core_context / alpha_mode (best-effort) ----
    regime = {"regime":"UNKNOWN","confidence":0.0,"alpha_mode":"ON"}
    core_ctx = {"snapshot": snapshot, "reason":"core_ctx_runloop_rebuild_v1"}
    alpha_mode = {"mode":"OFF","reason":"init"}

    try:
        if "compute_regime" in globals():
            regime = compute_regime(snapshot)
    except Exception:
        pass

    try:
        if "build_core_context" in globals():
            core_ctx = build_core_context(snapshot, regime)
    except Exception:
        pass

    try:
        if "compute_alpha_mode" in globals():
            alpha_mode = compute_alpha_mode(core_ctx, regime)
    except Exception:
        pass

    # ---- minimal observability (stdout + optional meta/announce emitters if present) ----
    def _safe_emit(kind, payload):
        ev = {"kind": kind, "payload": payload}
        try:
            if "make_event" in globals():
                ev = make_event(level="INFO", kind=kind, payload=payload)
        except Exception:
            ev = {"kind": kind, "payload": payload}
        try:
            if "meta" in globals() and hasattr(meta, "emit"):
                meta.emit(ev)
        except Exception:
            pass
        try:
            if "announce" in globals() and hasattr(announce, "emit"):
                announce.emit(ev)
        except Exception:
            pass
        try:
            print(kind, payload)
        except Exception:
            pass

    _safe_emit("boot", {"iters": iters, "sleep": sleep_sec, "symbols": symbols})

    # ---- loop ----
    i = 0
    while True:
        if i >= iters:
            break
        try:
            _safe_emit("heartbeat", {"i": i, "has_snapshot": snapshot is not None})
            time.sleep(sleep_sec)
        except Exception:
            _safe_emit("loop_exception", {"i": i, "err": traceback.format_exc()})
            time.sleep(min(1.0, sleep_sec))
        i += 1

    _safe_emit("shutdown", {"rc": 0, "iters": iters})
    return 0


\ndef _tbot_runloop_guard(args):\n    import time\n    \n\n    while True:\n        try:\n            _orig(args)\n        except Exception as e:\n            print("TBOT_RUN_LOOP_CRASH", e)\n        time.sleep(5)\n\nimport time\nimport traceback\n\n\n# ==== TBOT_META_EVENTS_CANON_V1 BEGIN ====\nimport json as _tbot_json\nimport os as _tbot_os\nfrom datetime import datetime as _tbot_dt\n\ndef _tbot_meta_path() -> str:\n    rr = _tbot_os.getenv("TBOT_RUNROOT") or "."\n    return _tbot_os.path.join(rr, "logs", "meta_events.jsonl")\n\ndef _tbot_meta_emit(kind: str, payload: dict, level: str = "INFO") -> None:\n    try:\n        p = _tbot_meta_path()\n        d = _tbot_os.path.dirname(p) or "."\n        _tbot_os.makedirs(d, exist_ok=True)\n        row = {\n            "ts": _tbot_dt.utcnow().isoformat(timespec="seconds") + "Z",\n            "level": level,\n            "kind": kind,\n            "payload": payload,\n        }\n        with open(p, "a", encoding="utf-8") as f:\n            f.write(_tbot_json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")\n    except Exception:\n        pass\n# ==== TBOT_META_EVENTS_CANON_V1 END ====\n\n# --- optional event emit (best-effort) ---\n# ==== TBOT_META_EVENTS_WIRE_V2B BEGIN ====\nimport os as _tbot_os\nimport json as _tbot_json\nimport datetime as _tbot_dt\n\ndef _tbot_meta_events_path() -> str:\n    rr = _tbot_os.getenv("TBOT_RUNROOT", ".")\n    return _tbot_os.path.join(rr, "logs", "meta_events.jsonl")\n\ndef _tbot_meta_emit(kind: str, payload: dict, level: str="INFO", run_id: str="") -> None:\n    try:\n        p = _tbot_meta_events_path()\n        _tbot_os.makedirs(_tbot_os.path.dirname(p), exist_ok=True)\n        row = {\n            "ts": _tbot_dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),\n            "level": level,\n            "kind": kind,\n            "run_id": run_id,\n            "payload": payload or {},\n        }\n        with open(p, "a", encoding="utf-8") as f:\n            f.write(_tbot_json.dumps(row, ensure_ascii=False) + "\n")\n    except Exception:\n        pass\n# ==== TBOT_META_EVENTS_WIRE_V2B END ====\ndef _snapshot_value(snapshot, key: str, default=None):\n    # dict-like\n    try:\n        if hasattr(snapshot, "get"):\n            return snapshot.get(key, default)\n    except Exception:\n        pass\n\n    # attribute-like\n    try:\n        if hasattr(snapshot, key):\n            v = getattr(snapshot, key)\n            return default if v is None else v\n    except Exception:\n        pass\n\n    # nested common patterns\n    for attr in ("data", "payload", "snapshot", "__dict__"):\n        try:\n            base = getattr(snapshot, attr, None)\n            if isinstance(base, dict) and key in base:\n                v = base.get(key, default)\n                return default if v is None else v\n        except Exception:\n            pass\n\n    # heuristic fallbacks for current pipeline\n    if key == "regime":\n        return default if default is not None else "UNKNOWN"\n    if key == "confidence":\n        return default if default is not None else 0.0\n    if key == "bias":\n        return default if default is not None else "FLAT"\n    if key == "trend_strength":\n        return default if default is not None else 0.0\n\n    return default\n\ndef _iter_marketsnaps(snapshot):\n    # MarketSnapshot looks like object with symbol attrs: SPY, QQQ, ...\n    for name in dir(snapshot):\n        if name.startswith("_"):\n            continue\n        try:\n            val = getattr(snapshot, name)\n        except Exception:\n            continue\n        if callable(val):\n            continue\n        # Heuristic: MarketSnap has these fields\n        if all(hasattr(val, k) for k in ("last", "vwap", "ema_fast", "ema_slow")):\n            yield name, val\n\ndef _snapshot_feature_summary(snapshot):\n    rows = []\n    for sym, ms in _iter_marketsnaps(snapshot):\n        try:\n            last = float(getattr(ms, "last", 0.0) or 0.0)\n            vwap = float(getattr(ms, "vwap", 0.0) or 0.0)\n            ema_fast = float(getattr(ms, "ema_fast", 0.0) or 0.0)\n            ema_slow = float(getattr(ms, "ema_slow", 0.0) or 0.0)\n\n            ema_denom = max(abs(ema_slow), 1e-9)\n            vwap_denom = max(abs(vwap), 1e-9)\n\n            ema_delta = (ema_fast - ema_slow) / ema_denom\n            vwap_delta = (last - vwap) / vwap_denom\n\n            rows.append({\n                "symbol": sym,\n                "last": last,\n                "vwap": vwap,\n                "ema_fast": ema_fast,\n                "ema_slow": ema_slow,\n                "ema_delta": ema_delta,\n                "vwap_delta": vwap_delta,\n            })\n        except Exception:\n            continue\n    return rows\n\ndef _derive_snapshot_features(snapshot):\n    rows = _snapshot_feature_summary(snapshot)\n    if not rows:\n        return {\n            "regime": "UNKNOWN",\n            "confidence": 0.0,\n            "bias": "FLAT",\n            "trend_strength": 0.0,\n            "n": 0,\n        }\n\n    bull = sum(1 for r in rows if r["ema_delta"] > 0 and r["vwap_delta"] > 0)\n    bear = sum(1 for r in rows if r["ema_delta"] < 0 and r["vwap_delta"] < 0)\n    n = len(rows)\n\n    avg_abs_ema = sum(abs(r["ema_delta"]) for r in rows) / n\n    avg_abs_vwap = sum(abs(r["vwap_delta"]) for r in rows) / n\n    trend_strength = max(0.0, min(1.0, (avg_abs_ema * 40.0) + (avg_abs_vwap * 15.0)))\n\n    dominance = abs(bull - bear) / max(n, 1)\n    confidence = max(0.0, min(1.0, 0.5 * dominance + 0.5 * trend_strength))\n\n    if bull > bear:\n        bias = "LONG"\n        regime = "BULL"\n    elif bear > bull:\n        bias = "SHORT"\n        regime = "BEAR"\n    else:\n        bias = "FLAT"\n        regime = "RANGE"\n\n    return {\n        "regime": regime,\n        "confidence": float(confidence),\n        "bias": bias,\n        "trend_strength": float(trend_strength),\n        "n": n,\n    }\n\ndef _safe_emit_meta(kind: str, payload: dict, level: str="INFO"):\n    try:\n        from tbot.meta.meta import meta\n        from tbot.meta.announce import announce\n        from tbot.meta.events import make_event\n        ev = make_event(level=level, kind=kind, payload=payload)\n        meta.emit(ev)\n        announce.emit(ev)\n    except Exception:\n        # fallback: no-op\n        pass\n\ndef compute_regime(snapshot) -> dict:\n    f = _derive_snapshot_features(snapshot)\n    return {\n        "regime": f["regime"],\n        "confidence": float(f["confidence"]),\n        "alpha_mode": "ON"\n    }\n\ndef build_core_context(snapshot, regime: dict) -> dict:\n    f = _derive_snapshot_features(snapshot)\n    return {\n        "bias": f["bias"],\n        "trend_strength": float(f["trend_strength"]),\n        "reason": "core_ctx_marketsnap_features_v1"\n    }\n\ndef compute_alpha_mode(core_ctx: dict, regime: dict) -> dict:\n    # placeholder rule: alpha ON unless trend_strength too weak\n    ts = float(core_ctx.get("trend_strength", 0.0))\n    th = 0.28\n    if ts < th:\n        return {"mode": "OFF", "cap_ratio": 0.0, "reason": f"alpha_off_trend_weak(ts={ts:.3f},th={th})"}\n    return {"mode": "ON", "cap_ratio": 1.0, "reason": "alpha_on_clean_v2"}\n\ndef _call_strategy(mod, ctx: dict, alpha_mode: dict):\n    # support multiple strategy APIs safely\n    if hasattr(mod, "generate_signal"):\n        return mod.generate_signal(ctx)\n    if hasattr(mod, "get_signal"):\n        return mod.get_signal(ctx)\n    if hasattr(mod, "eval_signal"):\n        return mod.eval_signal(ctx, alpha_mode=alpha_mode)\n    return None\n\n\ndef run_loop(args):\n    """\n    Shadow plan hardening v2:\n      - regime / core_context / alpha_mode / strategy_result\n      - signal_eval / risk_check / gate_decision / plan_created / shadow_written\n      - side aligned with bias\n      - entry / stop / tp / rr derived from MarketSnapshot\n      - shadow-only, no live/paper execution\n    """\n    import os, json, time\n    from tbot.market.market_provider import build_market_snapshot\n\n    runroot = os.getenv("TBOT_RUNROOT") or os.path.join(os.getcwd(), "runtime", "paper")\n    logdir = os.path.join(runroot, "logs")\n    os.makedirs(logdir, exist_ok=True)\n\n    meta_path = os.path.join(logdir, "meta_events.jsonl")\n    shadow_path = os.path.join(logdir, "shadow_plans.jsonl")\n\n    def emit(kind, payload, level="INFO"):\n        row = {\n            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),\n            "level": level,\n            "kind": kind,\n            "run_id": getattr(args, "run_id", None),\n            "payload": payload,\n        }\n        with open(meta_path, "a", encoding="utf-8") as f:\n            f.write(json.dumps(row, ensure_ascii=False) + "\n")\n\n    def write_shadow(plan: dict):\n        with open(shadow_path, "a", encoding="utf-8") as f:\n            f.write(json.dumps(plan, ensure_ascii=False) + "\n")\n\n    def snapshot_rows(snapshot):\n        rows = []\n        for name in dir(snapshot):\n            if name.startswith("_"):\n                continue\n            try:\n                val = getattr(snapshot, name)\n            except Exception:\n                continue\n            if callable(val):\n                continue\n            if all(hasattr(val, k) for k in ("last", "vwap", "ema_fast", "ema_slow")):\n                try:\n                    last = float(getattr(val, "last", 0.0) or 0.0)\n                    vwap = float(getattr(val, "vwap", 0.0) or 0.0)\n                    ema_fast = float(getattr(val, "ema_fast", 0.0) or 0.0)\n                    ema_slow = float(getattr(val, "ema_slow", 0.0) or 0.0)\n\n                    ema_denom = max(abs(ema_slow), 1e-9)\n                    vwap_denom = max(abs(vwap), 1e-9)\n\n                    ema_delta = (ema_fast - ema_slow) / ema_denom\n                    vwap_delta = (last - vwap) / vwap_denom\n\n                    rows.append({\n                        "symbol": name,\n                        "last": last,\n                        "vwap": vwap,\n                        "ema_fast": ema_fast,\n                        "ema_slow": ema_slow,\n                        "ema_delta": ema_delta,\n                        "vwap_delta": vwap_delta,\n                        "score": abs(ema_delta) + abs(vwap_delta),\n                    })\n                except Exception:\n                    continue\n        return rows\n\n    def build_shadow_candidate(snapshot, regime, core_ctx):\n        rows = snapshot_rows(snapshot)\n        if not rows:\n            return None\n\n        bias = str(core_ctx.get("bias", "FLAT")).upper()\n        if bias == "LONG":\n            eligible = [r for r in rows if r["ema_delta"] > 0 and r["vwap_delta"] > 0]\n            side = "BUY"\n        elif bias == "SHORT":\n            eligible = [r for r in rows if r["ema_delta"] < 0 and r["vwap_delta"] < 0]\n            side = "SELL"\n        else:\n            return None\n\n        if not eligible:\n            return None\n\n        best = sorted(eligible, key=lambda x: x["score"], reverse=True)[0]\n\n        entry = float(best["last"])\n        if side == "BUY":\n            stop = min(best["vwap"], best["ema_fast"], best["ema_slow"])\n            if stop >= entry:\n                stop = entry * 0.995\n            risk = entry - stop\n            tp = entry + (1.6 * risk)\n        else:\n            stop = max(best["vwap"], best["ema_fast"], best["ema_slow"])\n            if stop <= entry:\n                stop = entry * 1.005\n            risk = stop - entry\n            tp = entry - (1.6 * risk)\n\n        risk = abs(risk)\n        if risk <= 0:\n            return None\n\n        rr = abs(tp - entry) / risk\n\n        return {\n            "ts": time.strftime("%Y-%m-%d %H:%M:%S"),\n            "run_id": getattr(args, "run_id", None),\n            "sid": "A_HARDENED_SHADOW",\n            "symbol": best["symbol"],\n            "side": side,\n            "entry": round(entry, 6),\n            "stop": round(stop, 6),\n            "tp": round(tp, 6),\n            "rr": round(float(rr), 4),\n            "confidence": round(float(regime.get("confidence", 0.0)), 4),\n            "bias": bias,\n            "reason": "shadow_harden_v2",\n        }\n\n    iters = int(getattr(args, "iters", 5) or 5)\n    sleep_s = float(getattr(args, "sleep", 0.5) or 0.5)\n    symbols = getattr(args, "symbols", None) or ["SPY", "QQQ", "IWM", "NVDA", "AAPL", "TSLA"]\n\n    min_conf = float(getattr(args, "gate_min_conf", 0.55) or 0.55)\n    min_rr = float(getattr(args, "gate_min_rr", 1.5) or 1.5)\n    max_plans_per_day = int(getattr(args, "gate_max_plans_per_day", 15) or 15)\n\n    plans_today = 0\n\n    boot_payload = {\n        "iters": iters,\n        "sleep": sleep_s,\n        "symbols": list(symbols),\n        "gate_min_conf": min_conf,\n        "gate_min_rr": min_rr,\n        "gate_max_plans_per_day": max_plans_per_day,\n    }\n    print("boot", boot_payload)\n    emit("boot", boot_payload)\n\n    for i in range(iters):\n        snap = build_market_snapshot(symbols)\n\n        hb = {"i": i, "has_snapshot": bool(snap is not None)}\n        print("heartbeat", hb)\n        emit("heartbeat", hb)\n\n        if not snap:\n            emit("gate_decision", {"allow": False, "reasons": ["no_snapshot"]})\n            if sleep_s > 0:\n                time.sleep(sleep_s)\n            continue\n\n        try:\n            regime = compute_regime(snap)\n            emit("regime", regime)\n        except Exception as e:\n            regime = {"regime": "ERROR", "confidence": 0.0, "reason": f"regime_exception:{e}"}\n            emit("regime", regime, level="ERROR")\n\n        try:\n            core_ctx = build_core_context(snap, regime)\n            emit("core_context", core_ctx)\n        except Exception as e:\n            core_ctx = {"bias": "FLAT", "trend_strength": 0.0, "reason": f"core_context_exception:{e}"}\n            emit("core_context", core_ctx, level="ERROR")\n\n        try:\n            alpha = compute_alpha_mode(core_ctx, regime)\n            emit("alpha_mode", alpha)\n        except Exception as e:\n            alpha = {"mode": "OFF", "cap_ratio": 0.0, "reason": f"alpha_mode_exception:{e}"}\n            emit("alpha_mode", alpha, level="ERROR")\n\n        candidate = build_shadow_candidate(snap, regime, core_ctx)\n\n        emit("signal_eval", {\n            "candidate_exists": bool(candidate),\n            "bias": core_ctx.get("bias"),\n            "regime": regime.get("regime"),\n            "alpha_mode": alpha.get("mode"),\n        })\n\n        strategy_result = {\n            "symbol_count": len(symbols),\n            "snapshot_ok": True,\n            "regime": regime.get("regime"),\n            "bias": core_ctx.get("bias"),\n            "alpha_mode": alpha.get("mode"),\n            "reason": "shadow_harden_v2"\n        }\n        emit("strategy_result", strategy_result)\n\n        allow = True\n        reasons = []\n\n        if alpha.get("mode") != "ON":\n            allow = False\n            reasons.append("alpha_off")\n\n        bias = str(core_ctx.get("bias", "FLAT")).upper()\n        if bias not in ("LONG", "SHORT"):\n            allow = False\n            reasons.append("bias_invalid")\n\n        conf = float(regime.get("confidence", 0.0) or 0.0)\n        if conf < min_conf:\n            allow = False\n            reasons.append(f"conf_below_min({conf:.3f}<{min_conf:.3f})")\n\n        if candidate is None:\n            allow = False\n            reasons.append("no_candidate")\n\n        if candidate is not None:\n            rr = float(candidate.get("rr", 0.0) or 0.0)\n            if rr < min_rr:\n                allow = False\n                reasons.append(f"rr_below_min({rr:.3f}<{min_rr:.3f})")\n\n        if plans_today >= max_plans_per_day:\n            allow = False\n            reasons.append("max_plans_per_day_hit")\n\n        emit("risk_check", {\n            "allow": allow,\n            "confidence": conf,\n            "plans_today": plans_today,\n            "candidate_rr": None if candidate is None else candidate.get("rr"),\n        })\n\n        emit("gate_decision", {\n            "allow": allow,\n            "reasons": reasons if reasons else ["pass"],\n        })\n\n        if allow and candidate is not None:\n            emit("plan_created", candidate)\n            try:\n                write_shadow(candidate)\n                plans_today += 1\n                emit("shadow_written", {"symbol": candidate["symbol"], "sid": candidate["sid"]})\n            except Exception as e:\n                emit("shadow_written", {"error": str(e)}, level="ERROR")\n\n        if sleep_s > 0:\n            time.sleep(sleep_s)\n\n    shut = {"rc": 0, "iters": iters, "plans_today": plans_today}\n    print("shutdown", shut)\n    emit("shutdown", shut)\n    return 0\n
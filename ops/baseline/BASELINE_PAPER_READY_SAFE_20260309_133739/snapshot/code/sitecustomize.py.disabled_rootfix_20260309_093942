import builtins
import importlib
import json
import os
import sys
import traceback
from datetime import datetime

def _log(kind, payload=None):
    try:
        runroot = os.environ.get("TBOT_RUNROOT", r"C:\alpaca-bot\ORG_BOT_UNIFIED")
        path = os.path.join(runroot, "runtime", "paper", "logs", "spawn_origin_tracer_v1.jsonl")
        row = {
            "ts": datetime.utcnow().isoformat() + "Z",
            "kind": kind,
            "pid": os.getpid(),
            "ppid": os.getppid(),
            "executable": sys.executable,
            "argv": sys.argv,
            "cwd": os.getcwd(),
            "payload": payload or {},
            "stack": traceback.format_stack(limit=25),
        }
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row, ensure_ascii=False, default=str) + "\n")
    except Exception:
        pass

_log("sitecustomize_loaded", {})

# ---- import tracing ----
try:
    _orig_import = builtins.__import__

    def _logged_import(name, globals=None, locals=None, fromlist=(), level=0):
        _log("import", {
            "name": name,
            "fromlist": list(fromlist) if fromlist else [],
            "level": level,
        })
        return _orig_import(name, globals, locals, fromlist, level)

    builtins.__import__ = _logged_import
except Exception as e:
    _log("patch_error", {"target": "__import__", "error": repr(e)})

try:
    _orig_import_module = importlib.import_module

    def _logged_import_module(name, package=None):
        _log("importlib.import_module", {"name": name, "package": package})
        return _orig_import_module(name, package)

    importlib.import_module = _logged_import_module
except Exception as e:
    _log("patch_error", {"target": "importlib.import_module", "error": repr(e)})

# ---- CreateProcess ----
try:
    import _winapi
    _orig_CreateProcess = _winapi.CreateProcess

    def _logged_CreateProcess(*args, **kwargs):
        _log("_winapi.CreateProcess", {"args": args, "kwargs": kwargs})
        return _orig_CreateProcess(*args, **kwargs)

    _winapi.CreateProcess = _logged_CreateProcess
except Exception as e:
    _log("patch_error", {"target": "_winapi.CreateProcess", "error": repr(e)})

# ---- subprocess ----
try:
    import subprocess
    _orig_popen = subprocess.Popen

    class _LoggedPopen(_orig_popen):
        def __init__(self, *args, **kwargs):
            _log("subprocess.Popen", {"args": args, "kwargs": kwargs})
            super().__init__(*args, **kwargs)

    subprocess.Popen = _LoggedPopen
except Exception as e:
    _log("patch_error", {"target": "subprocess.Popen", "error": repr(e)})

try:
    import subprocess
    _orig_run = subprocess.run

    def _logged_run(*args, **kwargs):
        _log("subprocess.run", {"args": args, "kwargs": kwargs})
        return _orig_run(*args, **kwargs)

    subprocess.run = _logged_run
except Exception as e:
    _log("patch_error", {"target": "subprocess.run", "error": repr(e)})

# ---- os.spawn* ----
try:
    import os as _os_mod

    def _patch_spawn_name(_name):
        if not hasattr(_os_mod, _name):
            return
        _orig = getattr(_os_mod, _name)

        def _logged_spawn(*args, **kwargs):
            _log("os." + _name, {"args": args, "kwargs": kwargs})
            return _orig(*args, **kwargs)

        setattr(_os_mod, _name, _logged_spawn)

    for _nm in ["spawnv","spawnve","spawnvp","spawnvpe","spawnl","spawnle","spawnlp","spawnlpe"]:
        _patch_spawn_name(_nm)
except Exception as e:
    _log("patch_error", {"target": "os.spawn*", "error": repr(e)})

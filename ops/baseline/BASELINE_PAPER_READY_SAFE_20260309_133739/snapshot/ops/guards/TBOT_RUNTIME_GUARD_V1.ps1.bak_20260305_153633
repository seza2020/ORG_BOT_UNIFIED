param(
  [Parameter(Mandatory=$true)][string]$RunRoot   # PAPER / SHADOW
  [Parameter(Mandatory=$true)][string]\,
  [Parameter(Mandatory=$true)][string]\
)

$ErrorActionPreference = "Stop"
$rt = Join-Path $Root ("runtime\" + $Profile.ToLower())
$logs = Join-Path $rt "logs"
if(!(Test-Path $logs)){ New-Item -ItemType Directory -Force $logs | Out-Null }

function WL([string]\){
  $p = Join-Path $logs "ops_guard.log"
  Add-Content -LiteralPath $p -Value (("{0} {1}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss.fff"), \))
}

# 1) Hard bind to venv python
if(!(Test-Path $PyExe)){ WL("GUARD_FAIL VENV_PY_MISSING=$PyExe"); exit 41 }

# 2) Check existing tbot.main processes
$procs = Get-CimInstance Win32_Process -Filter "Name='python.exe'" |
  Where-Object { \.CommandLine -match "tbot\.main" }

if(\.Count -gt 0){
  WL(("GUARD_BLOCK EXISTING_TBOT_COUNT={0}" -f \.Count))
  \ | ForEach-Object { WL(("EXISTING PID={0} PPID={1} CMD={2}" -f \.ProcessId, \.ParentProcessId, \.CommandLine)) }
  exit 33
}

WL("GUARD_PASS OK")
exit 0


# ORG_UNIFIED_SHADOW_RUN.ps1 (English-only)
$ErrorActionPreference="Stop"
Set-StrictMode -Version Latest

$ROOT   = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$CODE   = Join-Path $ROOT "code"
$RUN    = Join-Path $ROOT "runtime\shadow"
$LOGDIR = Join-Path $RUN  "logs"
New-Item -ItemType Directory -Force -Path $LOGDIR | Out-Null

$wrapLog = Join-Path $ROOT "runtime\logs\tasks\ORG_UNIFIED_SHADOW_RUN.log"
New-Item -ItemType Directory -Force -Path (Split-Path $wrapLog) | Out-Null

. (Join-Path $ROOT "ops\task_wrappers\_LIB_SINGLE_INSTANCE.ps1")

Set-Location $CODE

$env:TBOT_RUNROOT = $RUN
$env:TBOT_LOGDIR  = $LOGDIR
$env:TBOT_META_ENGINE_PATH = (Join-Path $LOGDIR "meta_engine.jsonl")

$shadowPlans = Join-Path $LOGDIR "shadow_plans.jsonl"

$mutexes = Enter-OrgUnifiedSingleInstance -Profile "SHADOW" -RuntimeRoot $RUN -WrapperLogPath $wrapLog
if($null -eq $mutexes){ exit 0 }

try {
  $py = Join-Path $ROOT ".venv\Scripts\python.exe"

  & $py -u -m tbot.main --run --iters 999999999 --sleep 0.1 `
    --gate_cooldown_sec 300 --gate_max_plans_per_day 15 --gate_min_rr 1.5 --gate_min_conf 0.55 --gate_max_risk_usd 500 `
    --shadow --shadow_risk_usd 50 --shadow_path $shadowPlans

  $ec = $LASTEXITCODE
  ("[DONE] EXITCODE={0}" -f $ec) | Out-File -FilePath $wrapLog -Append -Encoding utf8
  exit $ec
}
finally{
  try {
    if($mutexes -is [object[]] -and $mutexes.Count -ge 2){
      $mutexes[1].ReleaseMutex() | Out-Null
      $mutexes[0].ReleaseMutex() | Out-Null
    } elseif($mutexes -is [System.Threading.Mutex]) {
      $mutexes.ReleaseMutex() | Out-Null
    }
  } catch {}
}




$ErrorActionPreference="Stop"

$logDir="C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\logs\tasks"
New-Item -ItemType Directory -Force -Path $logDir | Out-Null

$mainLog   = Join-Path $logDir "ORG_UNIFIED_SHADOW_RUN.log"
$wrapperLog= Join-Path $logDir "ORG_UNIFIED_SHADOW_RUN.wrapper.log"

function WL([string]$msg){
  $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
  Add-Content -Encoding UTF8 -LiteralPath $wrapperLog -Value ("[@{0}] {1}" -f $ts, $msg)
}

# --- Single-instance guard (keep lock for whole run) ---
$mutexName = "Global\ORG_UNIFIED_SHADOW_RUN_MUTEX"
$mutex = $null
$hasLock = $false

try {
  $mutex = New-Object System.Threading.Mutex($false, $mutexName)
  $hasLock = $mutex.WaitOne(0)
  if(-not $hasLock){
    WL ("SKIP duplicate run (mutex busy): {0}" -f $mutexName)
    exit 0
  }

  WL ("LOCK_ACQUIRED: {0}" -f $mutexName)

  $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
  Add-Content -Encoding UTF8 -LiteralPath $mainLog -Value ("[@{0}] START ORG_UNIFIED_SHADOW_RUN profile=SHADOW" -f $ts)

  & "C:\alpaca-bot\ORG_BOT_UNIFIED\ops\RUN_PROFILE.ps1" -Profile "SHADOW" 2>&1 |
    Tee-Object -FilePath $mainLog -Append | Out-Null

  $ec = $LASTEXITCODE
  $ts2 = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
  Add-Content -Encoding UTF8 -LiteralPath $mainLog -Value ("[@{0}] EXITCODE ORG_UNIFIED_SHADOW_RUN = {1}" -f $ts2, $ec)
  Add-Content -Encoding UTF8 -LiteralPath $mainLog -Value ("[@{0}] DONE ORG_UNIFIED_SHADOW_RUN" -f $ts2)

  WL ("DONE exitcode={0}" -f $ec)
  exit $ec

} catch {
  WL ("ERROR_FULL: {0}" -f $_.Exception.ToString())
  throw
} finally {
  if($hasLock -and $mutex){
    try { $mutex.ReleaseMutex() | Out-Null } catch {}
    WL ("LOCK_RELEASED: {0}" -f $mutexName)
  }
  if($mutex){ try { $mutex.Dispose() } catch {} }
}


param()

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$U       = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$CODE    = Join-Path $U "code"
$RUNTIME = Join-Path $U "runtime\paper"
$LOGS    = Join-Path $RUNTIME "logs"
$STATE   = Join-Path $RUNTIME "state"
$PY      = Join-Path $CODE ".venv\Scripts\python.exe"

New-Item -ItemType Directory -Force $LOGS, $STATE | Out-Null

$guardLog = Join-Path $LOGS "rootfix_launch_guard.jsonl"
$owner    = Join-Path $STATE "paper_launch_owner.json"
$mutexName = "Global\ORG_BOT_UNIFIED_PAPER_SINGLETON_V1"

function Write-GuardEvent {
  param(
    [string]$kind,
    [hashtable]$payload
  )
  $obj = [ordered]@{
    ts      = (Get-Date).ToString("o")
    kind    = $kind
    payload = $payload
  }
  ($obj | ConvertTo-Json -Depth 8 -Compress) | Add-Content -LiteralPath $guardLog -Encoding UTF8
}

function Get-TbotProcesses {
  try {
    return Get-CimInstance Win32_Process -Filter "Name='python.exe'" |
      Where-Object { $_.CommandLine -match "tbot\.main" } |
      Select-Object ProcessId, ParentProcessId, Name, CommandLine
  } catch {
    return @()
  }
}

$created = $false
$mtx = New-Object System.Threading.Mutex($true, $mutexName, [ref]$created)

if (-not $created) {
  Write-GuardEvent -kind "duplicate_blocked_mutex" -payload @{
    reason = "MUTEX_ALREADY_HELD"
    wrapper_pid = $PID
  }
  exit 91
}

try {
  $existing = @(Get-TbotProcesses)
  if ($existing.Count -gt 0) {
    $existing | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $STATE "paper_duplicate_seen.json") -Encoding UTF8
    Write-GuardEvent -kind "duplicate_blocked_existing_tbot" -payload @{
      reason = "TBOT_ALREADY_RUNNING"
      count  = $existing.Count
      wrapper_pid = $PID
    }
    exit 92
  }

  Set-Location $CODE
  $env:PYTHONPATH   = $CODE
  $env:TBOT_RUNROOT = $RUNTIME

  $ownerObj = [ordered]@{
    ts         = (Get-Date).ToString("o")
    wrapper_pid = $PID
    python     = $PY
    cwd        = $CODE
    runroot    = $RUNTIME
    command    = "$PY -m tbot.main --run"
  }
  $ownerObj | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $owner -Encoding UTF8

  Write-GuardEvent -kind "launch_begin" -payload @{
    wrapper_pid = $PID
    python      = $PY
    cwd         = $CODE
    runroot     = $RUNTIME
  }

  $p = Start-Process -FilePath $PY `
    -ArgumentList @("-m","tbot.main","--run") `
    -WorkingDirectory $CODE `
    -PassThru

  Write-GuardEvent -kind "launch_child_started" -payload @{
    wrapper_pid = $PID
    child_pid   = $p.Id
  }

  Wait-Process -Id $p.Id

  $exitCode = $null
  try {
    $p.Refresh()
    $exitCode = $p.ExitCode
  } catch {}

  Write-GuardEvent -kind "launch_child_exited" -payload @{
    wrapper_pid = $PID
    child_pid   = $p.Id
    exit_code   = $exitCode
  }

  exit 0
}
finally {
  try {
    if (Test-Path $owner) { Remove-Item -LiteralPath $owner -Force -ErrorAction SilentlyContinue }
  } catch {}
  try { $mtx.ReleaseMutex() | Out-Null } catch {}
  try { $mtx.Dispose() } catch {}
}

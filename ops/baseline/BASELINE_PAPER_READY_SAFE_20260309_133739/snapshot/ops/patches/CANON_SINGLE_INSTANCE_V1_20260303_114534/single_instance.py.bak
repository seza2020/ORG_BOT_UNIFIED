from __future__ import annotations

# ORG_BOT_UNIFIED — Single Instance Enforcement (Windows-first, fallback to file lock)
# Goals:
# - Deterministic mutex name (sanitized) to avoid ERROR_INVALID_NAME (123)
# - If mutex creation fails, fallback to file lock (still enforces single-instance)
# - Second instance exits with code 86 (hard block)

import os
import re
import sys
import time
import json
from typing import Optional


def _sanitize_mutex_name(name: str) -> str:
    try:
        if not isinstance(name, str):
            name = str(name)
        # Win32 mutex names: keep safe set; replace others
        name = re.sub(r"[^A-Za-z0-9_\-:\\]", "_", name)
        # avoid empty/too-long
        if not name:
            return r"Local\TBOT_MUTEX_FALLBACK"
        return name[:240] if len(name) > 240 else name
    except Exception:
        return r"Local\TBOT_MUTEX_FALLBACK"


def _build_mutex_name(profile: str, runroot: str) -> str:
    base = f"Local\\TBOT_ORG_UNIFIED::{profile}::{runroot}"
    return _sanitize_mutex_name(base)


def _try_mutex_acquire(name: str) -> Optional[int]:
    """
    Returns: handle int if acquired or already held by this process context, else None.
    If mutex exists (another instance), this function will exit(86).
    """
    try:
        import ctypes
        from ctypes import wintypes

        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)

        CreateMutexW = kernel32.CreateMutexW
        CreateMutexW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.LPCWSTR]
        CreateMutexW.restype = wintypes.HANDLE

        GetLastError = kernel32.GetLastError
        GetLastError.argtypes = []
        GetLastError.restype = wintypes.DWORD

        # Create/Open
        h = CreateMutexW(None, False, name)
        if not h:
            err = ctypes.get_last_error()
            sys.stderr.write(f"[SINGLE_INSTANCE] CreateMutexW failed err={err} name={name}\n")
            return None

        err = GetLastError()
        # ERROR_ALREADY_EXISTS = 183
        if err == 183:
            sys.stderr.write(f"[SINGLE_INSTANCE] MUTEX_ALREADY_EXISTS name={name} -> exit 86\n")
            raise SystemExit(86)

        sys.stderr.write(f"[SINGLE_INSTANCE] MUTEX_ACQUIRED name={name}\n")
        return int(h)
    except SystemExit:
        raise
    except Exception as e:
        sys.stderr.write(f"[SINGLE_INSTANCE] MUTEX_EXCEPTION {type(e).__name__}: {e}\n")
        return None


def _file_lock_acquire(lock_path: str) -> None:
    """
    Cross-run fallback. Uses exclusive create. Second instance exits 86.
    """
    os.makedirs(os.path.dirname(lock_path), exist_ok=True)
    pid = os.getpid()
    payload = {"pid": pid, "ts": time.time(), "argv": sys.argv}

    try:
        fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        owner = "UNKNOWN"
        try:
            with open(lock_path, "r", encoding="utf-8") as f:
                owner = f.read().strip()
        except Exception:
            owner = "UNREADABLE_LOCK"
        sys.stderr.write(f"[SINGLE_INSTANCE] FILE_LOCK_EXISTS path={lock_path} owner={owner} -> exit 86\n")
        raise SystemExit(86)

    try:
        os.write(fd, json.dumps(payload).encode("utf-8"))
    finally:
        try:
            os.close(fd)
        except Exception:
            pass


def enforce_single_instance(profile: str = "PAPER") -> None:
    """
    Call once, early in the process.
    Enforces single instance for the given profile/runroot.
    """
    runroot = os.environ.get("TBOT_RUNROOT") or os.environ.get("RUNROOT")
    if not runroot:
        # Last resort: assume project layout
        cwd = os.getcwd()
        runroot = os.path.join(cwd, "runtime", profile.lower())

    runroot = os.path.abspath(runroot)
    lockdir = os.path.join(runroot, "state", "locks")
    mutex_name = _build_mutex_name(profile=profile.upper(), runroot=runroot)

    # 1) Try mutex
    h = _try_mutex_acquire(mutex_name)

    # 2) Fallback to file lock if mutex failed for any reason (including err=123)
    if h is None:
        lock_path = os.path.join(lockdir, f"TBOT_SINGLE_INSTANCE_{profile.upper()}.lock")
        _file_lock_acquire(lock_path)
        sys.stderr.write(f"[SINGLE_INSTANCE] FILE_LOCK_ACQUIRED path={lock_path}\n")

    # Note: We intentionally do NOT release locks during runtime.
    # OS will release mutex handle on process exit. File lock is removed only if we implement cleanup,
    # but exclusive-create lock is safe enough for this phase; we can add a stale-lock reaper later.

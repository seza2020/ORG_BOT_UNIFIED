# _LIB_SINGLE_INSTANCE.ps1  (English-only code/comments)
Set-StrictMode -Version Latest

function Enter-OrgUnifiedSingleInstance {
  param(
    [Parameter(Mandatory=$true)][ValidateSet("PAPER","SHADOW")] [string]$Profile,
    [Parameter(Mandatory=$true)] [string]$RuntimeRoot,
    [Parameter(Mandatory=$true)] [string]$WrapperLogPath
  )

  $lockDir = Join-Path $RuntimeRoot "state\locks"
  New-Item -ItemType Directory -Force -Path $lockDir | Out-Null

  # Global mutex: blocks duplicates across users + SYSTEM
  $mutexName = "Global\ORG_BOT_UNIFIED_$Profile"
  $createdNew = $false
  $mutex = New-Object System.Threading.Mutex($true, $mutexName, [ref]$createdNew)

  if(-not $createdNew){
    "[SINGLE_INSTANCE] BLOCKED: mutex already held: $mutexName" | Out-File -FilePath $WrapperLogPath -Append -Encoding utf8
    return $null
  }

  # Secondary guard: process scan
  $needle = "-m tbot.main"
  $procs = Get-CimInstance Win32_Process -Filter "Name='python.exe' OR Name='pythonw.exe'" |
    Where-Object { $_.CommandLine -and $_.CommandLine -like "*$needle*" }

  $isShadow = ($Profile -eq "SHADOW")
  $match = $procs | Where-Object {
    if($isShadow){ $_.CommandLine -like "* --shadow *" } else { $_.CommandLine -notlike "* --shadow *" }
  }

  if($match.Count -gt 0){
    "[SINGLE_INSTANCE] BLOCKED: existing process(es) detected: $($match.Count)" | Out-File -FilePath $WrapperLogPath -Append -Encoding utf8
    try { $mutex.ReleaseMutex() } catch {}
    return $null
  }

  return $mutex
}
param(
  [Parameter(Mandatory=$true)][string]$TargetFile,
  [string]$PatchSpecPath,
  [string]$PatchLabel = "manual_patch",
  [switch]$PromoteOnPass,
  [switch]$SkipRuntimeAudit,
  [switch]$SkipJsonSanity,
  [switch]$SkipPathAudit,
  [switch]$NoApply,
  [switch]$Force
)

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$script:CurrentStage = "BOOT"

function New-Dir {
  param([Parameter(Mandatory=$true)][string]$Path)
  if (!(Test-Path $Path)) {
    New-Item -ItemType Directory -Force -Path $Path | Out-Null
  }
}

function Read-JsonFile {
  param([Parameter(Mandatory=$true)][string]$Path)
  if (!(Test-Path $Path)) { throw "JSON_FILE_NOT_FOUND=$Path" }
  return (Get-Content -LiteralPath $Path -Raw -Encoding UTF8 | ConvertFrom-Json -Depth 100)
}

function Write-JsonFile {
  param(
    [Parameter(Mandatory=$true)][string]$Path,
    [Parameter(Mandatory=$true)]$Object
  )
  ($Object | ConvertTo-Json -Depth 100) | Set-Content -LiteralPath $Path -Encoding UTF8
}

function Save-Text {
  param(
    [Parameter(Mandatory=$true)][string]$Path,
    [Parameter(Mandatory=$true)][AllowEmptyString()][string]$Text
  )
  $dir = Split-Path -Parent $Path
  if ($dir) { New-Dir $dir }
  Set-Content -LiteralPath $Path -Encoding UTF8 -Value $Text
}

function Export-ObjectCsv {
  param(
    [Parameter(Mandatory=$true)]$Obj,
    [Parameter(Mandatory=$true)][string]$Path
  )
  $dir = Split-Path -Parent $Path
  if ($dir) { New-Dir $dir }
  @($Obj) | Export-Csv -NoTypeInformation -Encoding UTF8 -Path $Path
}

function Get-FileSha256 {
  param([Parameter(Mandatory=$true)][string]$Path)
  if (!(Test-Path $Path)) { return $null }
  return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash
}

function Get-TbotProcesses {
  param([Parameter(Mandatory=$true)][string]$Pattern)
  try {
    $items = Get-CimInstance Win32_Process -Filter "Name='python.exe'" -ErrorAction Stop
    return @(
      $items | Where-Object {
        $_.CommandLine -and ($_.CommandLine -match $Pattern)
      }
    )
  } catch {
    return @()
  }
}

function Test-PythonCompile {
  param(
    [Parameter(Mandatory=$true)][string]$PythonExe,
    [Parameter(Mandatory=$true)][string]$FilePath,
    [Parameter(Mandatory=$true)][string]$OutTxt
  )

  $psi = New-Object System.Diagnostics.ProcessStartInfo
  $psi.FileName = $PythonExe
  $psi.Arguments = ('-m py_compile "{0}"' -f $FilePath)
  $psi.RedirectStandardOutput = $true
  $psi.RedirectStandardError  = $true
  $psi.UseShellExecute = $false
  $psi.CreateNoWindow = $true

  $p = [System.Diagnostics.Process]::Start($psi)
  $stdout = $p.StandardOutput.ReadToEnd()
  $stderr = $p.StandardError.ReadToEnd()
  $p.WaitForExit()

  Save-Text -Path $OutTxt -Text (($stdout + "`r`n" + $stderr).Trim())

  return [pscustomobject]@{
    exit_code = $p.ExitCode
    success   = ($p.ExitCode -eq 0)
  }
}

function Invoke-JsonSanity {
  param(
    [Parameter(Mandatory=$true)][string[]]$Files,
    [Parameter(Mandatory=$true)][int]$TailLines,
    [Parameter(Mandatory=$true)][string]$OutDir
  )

  New-Dir $OutDir
  $results = @()

  foreach ($f in @($Files)) {
    $path = [string]$f
    $row = [ordered]@{
      file = $path
      exists = (Test-Path $path)
      checked_lines = 0
      bad_json_lines = 0
      error = $null
    }

    if ($row.exists) {
      try {
        $lines = @(Get-Content -LiteralPath $path -Encoding UTF8 | Where-Object { $_.Trim() -ne "" })
        if ($TailLines -gt 0 -and $lines.Count -gt $TailLines) {
          $start = $lines.Count - $TailLines
          $lines = $lines[$start..($lines.Count - 1)]
        }

        $row.checked_lines = @($lines).Count
        $bad = 0

        foreach ($line in @($lines)) {
          try {
            $null = ([string]$line | ConvertFrom-Json -Depth 100)
          } catch {
            $bad++
          }
        }

        $row.bad_json_lines = $bad
      } catch {
        $row.error = $_.Exception.Message
      }
    }

    $results += [pscustomobject]$row
  }

  Export-ObjectCsv -Obj $results -Path (Join-Path $OutDir "json_sanity.csv")
  return @($results)
}

function Invoke-PathAudit {
  param(
    [Parameter(Mandatory=$true)][string[]]$Roots,
    [Parameter(Mandatory=$true)][string]$LegacyRoot,
    [Parameter(Mandatory=$true)][string]$OutDir
  )

  New-Dir $OutDir
  $allRows = @()
  $trueHits = @()

  foreach ($root in @($Roots)) {
    $r = [string]$root
    if ([string]::IsNullOrWhiteSpace($r)) { continue }
    if (!(Test-Path $r)) { continue }

    $files = @(
      Get-ChildItem -LiteralPath $r -Recurse -File -Force -ErrorAction SilentlyContinue |
      Where-Object { $_.Extension -in @(".ps1",".cmd",".bat",".txt",".json",".xml",".yaml",".yml",".md") }
    )

    foreach ($file in @($files)) {
      try {
        $content = Get-Content -LiteralPath $file.FullName -Raw -Encoding UTF8
        $literalCount = 0

        if ($null -ne $content -and $content.Contains($LegacyRoot)) {
          $literalCount = ([regex]::Matches($content, [regex]::Escape($LegacyRoot))).Count
        }

        $row = [pscustomobject]@{
          file = $file.FullName
          legacy_hit = ($literalCount -gt 0)
          literal_count = $literalCount
          error = $null
        }

        $allRows += $row
        if ($literalCount -gt 0) { $trueHits += $row }
      } catch {
        $allRows += [pscustomobject]@{
          file = $file.FullName
          legacy_hit = $false
          literal_count = 0
          error = $_.Exception.Message
        }
      }
    }
  }

  Export-ObjectCsv -Obj $allRows -Path (Join-Path $OutDir "literal_path_audit.csv")
  return @($trueHits)
}

function Backup-File {
  param(
    [Parameter(Mandatory=$true)][string]$File,
    [Parameter(Mandatory=$true)][string]$BackupDir
  )
  New-Dir $BackupDir
  $name = [System.IO.Path]::GetFileName($File)
  $dest = Join-Path $BackupDir ($name + ".bak")
  Copy-Item -LiteralPath $File -Destination $dest -Force
  return $dest
}

function Apply-PatchSpec {
  param(
    [Parameter(Mandatory=$true)][string]$TargetFile,
    [Parameter(Mandatory=$true)][string]$PatchSpecPath,
    [Parameter(Mandatory=$true)][string]$EvidenceDir
  )

  if (!(Test-Path $PatchSpecPath)) { throw "PATCH_SPEC_NOT_FOUND=$PatchSpecPath" }

  $raw = Get-Content -LiteralPath $PatchSpecPath -Raw -Encoding UTF8
  Save-Text -Path (Join-Path $EvidenceDir "patch_spec.json") -Text $raw
  $spec = $raw | ConvertFrom-Json -Depth 100
  $content = Get-Content -LiteralPath $TargetFile -Raw -Encoding UTF8

  foreach ($op in @($spec.operations)) {
    $type = [string]$op.type

    switch ($type) {
      "replace_literal" {
        $find = [string]$op.find
        $replace = [string]$op.replace
        if (-not $content.Contains($find)) {
          throw "PATCH_LITERAL_NOT_FOUND=$find"
        }
        $content = $content.Replace($find, $replace)
      }
      "regex_replace" {
        $pattern = [string]$op.pattern
        $replace = [string]$op.replace
        $multiple = $false
        if ($null -ne $op.multiple) { $multiple = [bool]$op.multiple }

        $rx = [regex]::new($pattern)
        $before = $content

        if ($multiple) {
          $content = $rx.Replace($content, $replace)
        } else {
          $content = $rx.Replace($content, $replace, 1)
        }

        if ($content -eq $before) {
          throw "PATCH_REGEX_NO_CHANGE=$pattern"
        }
      }
      "prepend" {
        $content = ([string]$op.text) + $content
      }
      "append" {
        $content = $content + ([string]$op.text)
      }
      "overwrite_from_file" {
        $src = [string]$op.source_file
        if (!(Test-Path $src)) {
          throw "OVERWRITE_SOURCE_NOT_FOUND=$src"
        }
        $content = Get-Content -LiteralPath $src -Raw -Encoding UTF8
      }
      default {
        throw "UNKNOWN_PATCH_OP=$type"
      }
    }
  }

  Save-Text -Path (Join-Path $EvidenceDir "target_after_patch_preview.txt") -Text $content
  Set-Content -LiteralPath $TargetFile -Encoding UTF8 -Value $content
}

$script:CurrentStage = "LOAD_POLICY"
$ScriptRoot = Split-Path -Parent $MyInvocation.MyCommand.Path
$PolicyPath = Join-Path $ScriptRoot "PATCH_TRANSACTION_POLICY_V1.json"
$policy = Read-JsonFile -Path $PolicyPath

$ProjectRoot = [string]$policy.project_root
$LegacyRoot = [string]$policy.legacy_root
$PythonExe = [string]$policy.canonical_python
$AuditRoot = [string]$policy.audit_root
$EvidenceRoot = [string]$policy.evidence_root
$ApprovedRegistry = [string]$policy.approved_registry
$BaselinePointer = [string]$policy.baseline_pointer
$RuntimePattern = [string]$policy.runtime_controls.tbot_process_match
$MaxTbot = [int]$policy.runtime_controls.max_allowed_tbot_processes
$JsonTail = [int]$policy.observability.json_tail_lines
$LogsRoot = [string]$policy.logs_root

if (!(Test-Path $TargetFile)) { throw "TARGET_FILE_NOT_FOUND=$TargetFile" }
if (!(Test-Path $PythonExe)) { throw "CANONICAL_PYTHON_NOT_FOUND=$PythonExe" }

$script:CurrentStage = "INIT_TX"
$ts = Get-Date -Format "yyyyMMdd_HHmmss"
$tx = "PATCH_TX_{0}" -f $ts

$TxAudit = Join-Path $AuditRoot $tx
$TxEvid = Join-Path $EvidenceRoot $tx
$TxBackup = Join-Path $TxEvid "backup"
$TxBefore = Join-Path $TxEvid "before"
$TxAfter = Join-Path $TxEvid "after"
$TxChecks = Join-Path $TxEvid "checks"
$TxBundle = Join-Path $TxEvid ($tx + ".zip")

foreach ($d in @($TxAudit,$TxEvid,$TxBackup,$TxBefore,$TxAfter,$TxChecks)) {
  New-Dir $d
}

$initial = [ordered]@{
  tx_id = $tx
  started_at = (Get-Date).ToString("s")
  target_file = $TargetFile
  patch_spec_path = $PatchSpecPath
  patch_label = $PatchLabel
  project_root = $ProjectRoot
  legacy_root = $LegacyRoot
  python = $PythonExe
  promote_on_pass = [bool]$PromoteOnPass
  no_apply = [bool]$NoApply
  status = "STARTED"
  rollback_performed = $false
  fail_reason = $null
}
Write-JsonFile -Path (Join-Path $TxAudit "tx_init.json") -Object $initial

$script:CurrentStage = "PRE_SNAPSHOT"
Copy-Item -LiteralPath $TargetFile -Destination (Join-Path $TxBefore ([System.IO.Path]::GetFileName($TargetFile))) -Force
$backupFile = Backup-File -File $TargetFile -BackupDir $TxBackup
$beforeHash = Get-FileSha256 -Path $TargetFile

$procBefore = Get-TbotProcesses -Pattern $RuntimePattern
$procBefore | Select-Object ProcessId, ParentProcessId, Name, CommandLine |
  Export-Csv -NoTypeInformation -Encoding UTF8 -Path (Join-Path $TxChecks "process_before.csv")

try { cmd /c "where python" > (Join-Path $TxChecks "where_python.txt") 2>&1 } catch {}
try { cmd /c "where pwsh" > (Join-Path $TxChecks "where_pwsh.txt") 2>&1 } catch {}
try { schtasks /query /fo LIST /v > (Join-Path $TxChecks "tasks_inventory.txt") 2>$null } catch {}

$preState = [ordered]@{
  target_file = $TargetFile
  target_hash_before = $beforeHash
  backup_file = $backupFile
  process_count_before = @($procBefore).Count
}
Write-JsonFile -Path (Join-Path $TxAudit "pre_state.json") -Object $preState

$rollbackNeeded = $false
$pass = $false
$runtimeFail = $null
$compileResult = $null

try {
  $script:CurrentStage = "APPLY_OR_COPY"

  if ($NoApply) {
    Copy-Item -LiteralPath $TargetFile -Destination (Join-Path $TxAfter ([System.IO.Path]::GetFileName($TargetFile))) -Force
  } else {
    if (-not $PatchSpecPath) { throw "PATCH_SPEC_REQUIRED_UNLESS_NOAPPLY" }
    Apply-PatchSpec -TargetFile $TargetFile -PatchSpecPath $PatchSpecPath -EvidenceDir $TxEvid
    Copy-Item -LiteralPath $TargetFile -Destination (Join-Path $TxAfter ([System.IO.Path]::GetFileName($TargetFile))) -Force
  }

  $script:CurrentStage = "COMPILE_CHECK"
  $compileResult = Test-PythonCompile -PythonExe $PythonExe -FilePath $TargetFile -OutTxt (Join-Path $TxChecks "compile_check.txt")
  if (-not $compileResult.success) { throw "COMPILE_FAILED" }

  if (-not $SkipRuntimeAudit) {
    $script:CurrentStage = "RUNTIME_AUDIT"
    $procAfter = Get-TbotProcesses -Pattern $RuntimePattern
    $procAfter | Select-Object ProcessId, ParentProcessId, Name, CommandLine |
      Export-Csv -NoTypeInformation -Encoding UTF8 -Path (Join-Path $TxChecks "process_after.csv")

    if (@($procAfter).Count -gt $MaxTbot) {
      throw "DUAL_PID_OR_MULTI_PID_DETECTED"
    }
  }

  if (-not $SkipJsonSanity) {
    $script:CurrentStage = "JSON_SANITY"
    $jsonFiles = @()

    foreach ($rf in @($policy.observability.required_logs)) {
      $jsonFiles += (Join-Path $LogsRoot ([string]$rf))
    }
    foreach ($of in @($policy.observability.optional_logs)) {
      $jsonFiles += (Join-Path $LogsRoot ([string]$of))
    }

    $jsonResults = Invoke-JsonSanity -Files @($jsonFiles) -TailLines $JsonTail -OutDir (Join-Path $TxChecks "json_sanity")
    $bad = @($jsonResults | Where-Object { $_.bad_json_lines -gt 0 })
    if ($bad.Count -gt 0) {
      throw "JSON_SANITY_FAILED"
    }
  }

  if (-not $SkipPathAudit) {
    $script:CurrentStage = "PATH_AUDIT"
    $roots = @()
    foreach ($r in @($policy.path_controls.task_wrapper_roots)) {
      $roots += [string]$r
    }

    $pathHits = @(Invoke-PathAudit -Roots @($roots) -LegacyRoot $LegacyRoot -OutDir (Join-Path $TxChecks "path_audit"))
    $pathHitCount = @($pathHits | Where-Object { $null -ne $_ -and $_.legacy_hit -eq $true }).Count
    Save-Text -Path (Join-Path $TxChecks "path_audit\path_audit_count.txt") -Text ("path_hit_count=" + $pathHitCount)

    if ($pathHitCount -gt 0 -and -not $Force) {
      throw "LEGACY_PATH_HIT_DETECTED"
    }
  }

  $script:CurrentStage = "PASS_FINALIZE"
  $pass = $true
}
catch {
  $rollbackNeeded = $true
  $runtimeFail = ("STAGE={0} :: {1}" -f $script:CurrentStage, $_.Exception.Message)
}

$script:CurrentStage = "ROLLBACK_BLOCK"
$rollbackState = [ordered]@{
  rollback_needed = $rollbackNeeded
  rollback_performed = $false
  restore_hash = $null
  restore_verified = $false
  fail_reason = $runtimeFail
}

if ($rollbackNeeded) {
  Copy-Item -LiteralPath $backupFile -Destination $TargetFile -Force
  $restoreHash = Get-FileSha256 -Path $TargetFile
  $rollbackState.rollback_performed = $true
  $rollbackState.restore_hash = $restoreHash
  $rollbackState.restore_verified = ($restoreHash -eq $beforeHash)
}

Write-JsonFile -Path (Join-Path $TxAudit "rollback_state.json") -Object $rollbackState

$script:CurrentStage = "SUMMARY"
$afterHash = Get-FileSha256 -Path $TargetFile
$finalStatus = if ($pass) { "PASS" } else { "FAIL" }

$summary = [ordered]@{
  tx_id = $tx
  started_at = $initial.started_at
  finished_at = (Get-Date).ToString("s")
  target_file = $TargetFile
  patch_label = $PatchLabel
  patch_spec_path = $PatchSpecPath
  before_hash = $beforeHash
  after_hash = $afterHash
  compile_success = if ($compileResult) { [bool]$compileResult.success } else { $false }
  rollback_performed = [bool]$rollbackState.rollback_performed
  rollback_verified = [bool]$rollbackState.restore_verified
  final_status = $finalStatus
  fail_reason = $runtimeFail
  process_limit = $MaxTbot
  promote_requested = [bool]$PromoteOnPass
  promoted = $false
}
Write-JsonFile -Path (Join-Path $TxAudit "summary.json") -Object $summary

if ($pass -and $PromoteOnPass) {
  $reg = @()

  if (Test-Path $ApprovedRegistry) {
    try {
      $rawReg = Get-Content -LiteralPath $ApprovedRegistry -Raw -Encoding UTF8
      if ($rawReg.Trim()) {
        $reg = @($rawReg | ConvertFrom-Json -Depth 100)
      }
    } catch {
      $reg = @()
    }
  }

  $entry = [pscustomobject]@{
    tx_id = $tx
    approved_at = (Get-Date).ToString("s")
    target_file = $TargetFile
    patch_label = $PatchLabel
    after_hash = $afterHash
    patch_spec_path = $PatchSpecPath
    status = "APPROVED"
  }

  $reg = @($reg) + @($entry)
  Write-JsonFile -Path $ApprovedRegistry -Object $reg
  Write-JsonFile -Path $BaselinePointer -Object ([ordered]@{
    version = "BASELINE_POINTER_V1"
    last_approved_tx = $tx
    last_approved_file = $TargetFile
    last_approved_hash = $afterHash
    updated_at = (Get-Date).ToString("s")
  })

  $summary.promoted = $true
  Write-JsonFile -Path (Join-Path $TxAudit "summary.json") -Object $summary
}

$script:CurrentStage = "BUNDLE"
if (Test-Path $TxBundle) { Remove-Item -LiteralPath $TxBundle -Force }
Compress-Archive -Path (Join-Path $TxEvid "*") -DestinationPath $TxBundle -CompressionLevel Optimal -Force

"`n=== PATCH TRANSACTION RESULT ==="
"TX_ID=$tx"
"STATUS=$finalStatus"
"TARGET_FILE=$TargetFile"
"PATCH_LABEL=$PatchLabel"
"PATCH_SPEC_PATH=$PatchSpecPath"
"ROLLBACK_PERFORMED=$($rollbackState.rollback_performed)"
"ROLLBACK_VERIFIED=$($rollbackState.restore_verified)"
"PROMOTED=$($summary.promoted)"
"FAIL_REASON=$runtimeFail"
"EVIDENCE_DIR=$TxEvid"
"AUDIT_DIR=$TxAudit"
"BUNDLE=$TxBundle"

from __future__ import annotations

import argparse
import os
import sys
# ==== TBOT_CHILD_SPAWN_BLOCK_V1 BEGIN ====
# Institutional hard guard: prevent dual python processes spawned by runtime/wrapper/subprocess on Windows.
# Override only if explicitly allowed:
#   TBOT_ALLOW_CHILD_SPAWN=1
import os as _os
import sys as _sys

def _tbot_parent_is_python() -> bool:
    try:
        ppid = _os.getppid()
        if not ppid or ppid <= 1:
            return False
        # Use PowerShell-less / dependency-less check: query parent image name via ctypes
        import ctypes as _ct
        from ctypes import wintypes as _wt

        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        OpenProcess = _ct.windll.kernel32.OpenProcess
        CloseHandle = _ct.windll.kernel32.CloseHandle
        QueryFullProcessImageNameW = _ct.windll.kernel32.QueryFullProcessImageNameW

        h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, int(ppid))
        if not h:
            return False
        try:
            buf = _ct.create_unicode_buffer(4096)
            size = _wt.DWORD(len(buf))
            ok = QueryFullProcessImageNameW(h, 0, buf, _ct.byref(size))
            if not ok:
                return False
            path = (buf.value or "").lower()
            return path.endswith("\\python.exe")
        finally:
            CloseHandle(h)
    except Exception:
        # Fail-closed: if we cannot reliably tell, do not allow child spawn
        return True

if _os.environ.get("TBOT_ALLOW_CHILD_SPAWN", "0") != "1":
    if _tbot_parent_is_python():
        print("TBOT_CHILD_SPAWN_BLOCKED parent_is_python=1 ppid=", _os.getppid())
        raise SystemExit(86)
# ==== TBOT_CHILD_SPAWN_BLOCK_V1 END ====
import traceback

BANNER = "TBOT Trading Runtime (Enterprise CLI)"


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tbot.main", description=BANNER)
    p.add_argument("--smoke", action="store_true", help="print identity/session info and exit 0")
    p.add_argument("--run", action="store_true", help="run orchestrator loop")
    p.add_argument("--iters", type=int, default=999999, help="max iterations")
    p.add_argument("--sleep", type=float, default=0.5, help="sleep seconds")
    return p


def smoke() -> int:
    print("TBOT_SMOKE_OK")
    print("CWD=", os.getcwd())
    print("PYTHONPATH=", os.environ.get("PYTHONPATH"))
    print("TBOT_RUNROOT=", os.environ.get("TBOT_RUNROOT"))
    print("SYS_EXEC=", sys.executable)
    return 0


def _mp_guard_mainprocess() -> None:
    # ==== TBOT_MP_GUARD_V1 BEGIN ====
    # Prevent Windows multiprocessing 'spawn' child from running the bot logic.
    try:
        import multiprocessing as _mp
        if _mp.current_process().name != "MainProcess":
            print("TBOT_MP_CHILD_BLOCKED", _mp.current_process().name)
            raise SystemExit(0)
    except SystemExit:
        raise
    except Exception as _e:
        # If guard fails, fail-safe to avoid duplicate execution.
        print("TBOT_MP_GUARD_ERROR", repr(_e))
        raise SystemExit(86)
    # ==== TBOT_MP_GUARD_V1 END ====


def main(argv: list[str] | None = None) -> int:
    _mp_guard_mainprocess()

    parser = build_parser()
    args = parser.parse_args(argv)

    if args.smoke:
        return smoke()

    if not args.run:
        parser.print_help()
        return 0

    from tbot.runtime.orchestrator import run_loop
    run_loop(args)
    return 0


if __name__ == "__main__":
    try:
        import multiprocessing as _mp
        _mp.freeze_support()
    except Exception:
        pass

    try:
        rc = main()
        raise SystemExit(rc)
    except SystemExit:
        raise
    except Exception:
        print("TBOT_FATAL_EXCEPTION")
        traceback.print_exc()
        raise SystemExit(1)


# RUN_PAPER_EXECUTOR_TASK_V1 (CANON_NO_PARAM)
# Purpose: invoke EXECUTE_PLAN_SELECTION_PAPER_V2.ps1 under unified paper runroot, write logs to runtime\paper\logs\ops

$ErrorActionPreference="Stop"

# --- Canonical constants (do not rely on param; avoids parser break when anything precedes param) ---
$ROOT     = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$CODE     = Join-Path $ROOT "code"
$RUNROOT  = Join-Path $ROOT "runtime\paper"
$LOGDIR   = Join-Path $RUNROOT "logs"
$OPSLOG   = Join-Path $LOGDIR "ops"
$EXECSEL  = Join-Path $ROOT "code\tools\paper\EXECUTE_PLAN_SELECTION_PAPER_V2.ps1"

# --- Bind env (single source of truth) ---
Set-Location $CODE
$env:PYTHONPATH   = $CODE
$env:TBOT_ROOT    = $ROOT
$env:TBOT_CODE    = $CODE
$env:TBOT_RUNROOT = $RUNROOT
$env:TBOT_LOG_ROOT = $LOGDIR
$env:TBOT_OPS_LOG  = $OPSLOG

# --- Ensure dirs ---
New-Item -ItemType Directory -Force -Path $OPSLOG | Out-Null

# --- Executor runtime args (safe defaults) ---
$ProjectRoot = $ROOT
$RunRoot     = $RUNROOT
$MaxOrdersPerDay = 1
$MaxOrdersPerRun = 1
$DefaultQty      = 1
$DryRun          = 1

# --- Rolling append (daily) ---
$day = Get-Date -Format "yyyyMMdd"
$out = Join-Path $OPSLOG ("PAPER_EXEC_OUT_{0}.txt" -f $day)
$err = Join-Path $OPSLOG ("PAPER_EXEC_ERR_{0}.txt" -f $day)

if(!(Test-Path -LiteralPath $EXECSEL)){
  "MISSING_EXECUTE_PLAN_SELECTION=$EXECSEL" | Add-Content -LiteralPath $err -Encoding utf8
  exit 2
}

& "C:\Program Files\PowerShell\7\pwsh.exe" -NoProfile -ExecutionPolicy Bypass 
  -File $EXECSEL 
  -ProjectRoot $ProjectRoot -RunRoot $RunRoot -MaxOrdersPerDay $MaxOrdersPerDay -MaxOrdersPerRun $MaxOrdersPerRun -DefaultQty $DefaultQty -DryRun $DryRun 
  1>> $out 2>> $err

"EXITCODE=$LASTEXITCODE" | Add-Content -LiteralPath $out -Encoding utf8
"WROTE_OUT=$out"
"WROTE_ERR=$err"

import time
import traceback

# --- optional event emit (best-effort) ---
def _safe_emit_meta(kind: str, payload: dict, level: str="INFO"):
    try:
        from tbot.meta.meta import meta
        from tbot.meta.announce import announce
        from tbot.meta.events import make_event
        ev = make_event(level=level, kind=kind, payload=payload)
        meta.emit(ev)
        announce.emit(ev)
    except Exception:
        # fallback: no-op
        pass

def compute_regime(snapshot: dict) -> dict:
    # placeholder – keep deterministic schema
    return {"regime": snapshot.get("regime", "UNKNOWN"), "confidence": float(snapshot.get("confidence", 0.0)), "alpha_mode": "ON"}

def build_core_context(snapshot: dict, regime: dict) -> dict:
    # placeholder – keep deterministic schema
    return {"bias": snapshot.get("bias", "FLAT"), "trend_strength": float(snapshot.get("trend_strength", 0.0)), "reason": "core_ctx_clean_v2"}

def compute_alpha_mode(core_ctx: dict, regime: dict) -> dict:
    # placeholder rule: alpha ON unless trend_strength too weak
    ts = float(core_ctx.get("trend_strength", 0.0))
    th = 0.35
    if ts < th:
        return {"mode": "OFF", "cap_ratio": 0.0, "reason": f"alpha_off_trend_weak(ts={ts:.3f},th={th})"}
    return {"mode": "ON", "cap_ratio": 1.0, "reason": "alpha_on_clean_v2"}

def _call_strategy(mod, ctx: dict, alpha_mode: dict):
    # support multiple strategy APIs safely
    if hasattr(mod, "generate_signal"):
        return mod.generate_signal(ctx)
    if hasattr(mod, "get_signal"):
        return mod.get_signal(ctx)
    if hasattr(mod, "eval_signal"):
        return mod.eval_signal(ctx, alpha_mode=alpha_mode)
    return None

def run_loop(args):
    """
    Contract required by tbot.main:
      from tbot.runtime.orchestrator import run_loop
      run_loop(args)
    """
    sleep_sec = float(getattr(args, "sleep", 0.5) or 0.5)
    iters = int(getattr(args, "iters", 999999) or 999999)
    shadow_enabled = bool(getattr(args, "shadow", False))

    _safe_emit_meta("boot", {"iters": iters, "sleep": sleep_sec, "shadow": shadow_enabled})

    # imports inside run_loop to avoid import-time explosions
    try:
        from tbot.market.market_provider import build_market_snapshot
    except Exception as e:
        _safe_emit_meta("fatal", {"where": "import.build_market_snapshot", "err": repr(e)}, level="ERROR")
        raise

    # gate import (best-effort; if missing, we still run signal_eval + log)
    gate_fn = None
    try:
        from tbot.gate.gate import gate_accept_plan
        gate_fn = gate_accept_plan
    except Exception:
        gate_fn = None

    # strategies (best-effort)
    strategies = []
    for modname in ["tbot.strategies.s01","tbot.strategies.s08","tbot.strategies.s11","tbot.strategies.s12"]:
        try:
            import importlib
            strategies.append(importlib.import_module(modname))
        except Exception as e:
            _safe_emit_meta("warn", {"where": "import.strategy", "mod": modname, "err": repr(e)}, level="WARN")

    for i in range(iters):
        try:
        symbols = ["SPY","QQQ","IWM","NVDA","AAPL","TSLA"]
        snapshot = build_market_snapshot(symbols)
        snapshot = build_market_snapshot(symbols)
            regime = compute_regime(snapshot)
            core_ctx = build_core_context(snapshot, regime)
            alpha_mode = compute_alpha_mode(core_ctx, regime)

            _safe_emit_meta("regime", regime)
            _safe_emit_meta("core_context", core_ctx)
            _safe_emit_meta("alpha_mode", alpha_mode)

            if alpha_mode.get("mode") != "ON":
                time.sleep(sleep_sec)
                continue

            # evaluate strategies
            for mod in strategies:
                sid = getattr(mod, "SID", getattr(mod, "sid", mod.__name__))
                _safe_emit_meta("signal_eval", {"sid": str(sid)})

                sig = None
                try:
                    sig = _call_strategy(mod, {"snapshot": snapshot, "regime": regime, "core_context": core_ctx, "alpha_mode": alpha_mode}, alpha_mode)
                except Exception as e:
                    _safe_emit_meta("strategy_error", {"sid": str(sid), "err": repr(e)}, level="WARN")
                    continue

                if not sig:
                    _safe_emit_meta("strategy_result", {"sid": str(sid), "returned": "NONE", "reason": "NONE_NO_SIGNAL"})
                    continue

                _safe_emit_meta("strategy_result", {"sid": str(sid), "returned": "SIGNAL", "signal": str(type(sig).__name__)})

                # gate
                if gate_fn is not None:
                    try:
                        plan = gate_fn(sig)
                    except Exception as e:
                        _safe_emit_meta("gate_error", {"sid": str(sid), "err": repr(e)}, level="WARN")
                        plan = None
                    if plan:
                        _safe_emit_meta("plan", {"sid": str(sid), "accepted": True})
                else:
                    _safe_emit_meta("gate_skip", {"sid": str(sid), "reason": "gate_fn_unavailable"}, level="WARN")

            _safe_emit_meta("heartbeat", {"iter": i, "sleep": sleep_sec})
            time.sleep(sleep_sec)

        except Exception as e:
            _safe_emit_meta("fatal", {"where": "run_loop.iter", "iter": i, "err": repr(e)}, level="ERROR")
            traceback.print_exc()
            raise



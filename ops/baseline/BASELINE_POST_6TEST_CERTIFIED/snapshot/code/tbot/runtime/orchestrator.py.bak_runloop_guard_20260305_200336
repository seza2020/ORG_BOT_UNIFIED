# ==== TBOT_META_EVENTS_CANON_V1 BEGIN ====
import json as _tbot_json
import os as _tbot_os
from datetime import datetime as _tbot_dt

def _tbot_meta_path() -> str:
    rr = _tbot_os.getenv("TBOT_RUNROOT") or "."
    return _tbot_os.path.join(rr, "logs", "meta_events.jsonl")

def _tbot_meta_emit(kind: str, payload: dict, level: str = "INFO") -> None:
    try:
        p = _tbot_meta_path()
        d = _tbot_os.path.dirname(p) or "."
        _tbot_os.makedirs(d, exist_ok=True)
        row = {
            "ts": _tbot_dt.utcnow().isoformat(timespec="seconds") + "Z",
            "level": level,
            "kind": kind,
            "payload": payload,
        }
        with open(p, "a", encoding="utf-8") as f:
            f.write(_tbot_json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")
    except Exception:
        pass
# ==== TBOT_META_EVENTS_CANON_V1 END ====


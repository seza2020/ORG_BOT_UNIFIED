def _st(msg: str):
    try:
        os.makedirs(os.path.dirname(_SPAWN_TRACE), exist_ok=True)
        with open(_SPAWN_TRACE, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} pid={os.getpid()} ppid={os.getppid()} {msg}\n")
    except Exception:
        pass

_st("BOOT argv=" + repr(sys.argv))

# Patch subprocess.Popen to log stack
try:
    import subprocess as _sp
    _orig_popen = _sp.Popen
    def _popen_wrap(*a, **k):
        _st("SUBPROCESS_POPEN args=" + repr(a[:3]) + " kwargs_keys=" + repr(sorted(list(k.keys()))))
        _st("STACK\n" + "".join(traceback.format_stack(limit=60)))
        return _orig_popen(*a, **k)
    _sp.Popen = _popen_wrap
except Exception as _e:
    _st("SUBPROCESS_PATCH_FAIL " + repr(_e))

# Patch multiprocessing Process.start to log stack
try:
    import multiprocessing as _mp
    _orig_start = _mp.process.BaseProcess.start
    def _start_wrap(self, *a, **k):
        _st("MP_START name=" + repr(getattr(self,'name',None)) + " target=" + repr(getattr(self,'_target',None)))
        _st("STACK\n" + "".join(traceback.format_stack(limit=60)))
        return _orig_start(self, *a, **k)
    _mp.process.BaseProcess.start = _start_wrap
except Exception as _e:
    _st("MP_PATCH_FAIL " + repr(_e))

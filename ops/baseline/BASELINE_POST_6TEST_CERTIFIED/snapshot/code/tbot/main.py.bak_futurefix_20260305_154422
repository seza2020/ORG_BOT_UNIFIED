# === TBOT_SINGLE_INSTANCE_GUARD_PERM_V1 ===
# Permanent enterprise guard: prevents dual runtime (parent+child) for `python -m tbot.main --run` on Windows.
# Mechanism: Global mutex (handle kept alive) + atomic lockfile + evidence log.

import os, sys, time

_ROOT = r"C:\alpaca-bot\ORG_BOT_UNIFIED"
_LOG  = os.path.join(_ROOT, r"runtime\paper\logs\dualpid_guard_perm.log")
_LDIR = os.path.join(_ROOT, r"runtime\paper\state\locks")
_LFILE= os.path.join(_LDIR, "ORG_BOT_UNIFIED_TBOT_MAIN_RUN.lock")
_MUTEX= r"Global\ORG_BOT_UNIFIED_TBOT_MAIN_RUN"

# Keep mutex handle alive for lifetime of process (critical on Windows).
_MUTEX_HANDLE = None

def _log(msg: str) -> None:
    try:
        os.makedirs(os.path.dirname(_LOG), exist_ok=True)
        with open(_LOG, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} pid={os.getpid()} ppid={os.getppid()} {msg} argv={sys.argv!r}\n")
    except Exception:
        pass

def _is_run_mode() -> bool:
    return ("--run" in sys.argv)

def _acquire_mutex_or_exit() -> None:
    global _MUTEX_HANDLE
    try:
        import ctypes
        from ctypes import wintypes

        CreateMutexW = ctypes.windll.kernel32.CreateMutexW
        CreateMutexW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.LPCWSTR]
        CreateMutexW.restype  = wintypes.HANDLE

        GetLastError = ctypes.windll.kernel32.GetLastError

        h = CreateMutexW(None, True, _MUTEX)
        err = GetLastError()

        # ERROR_ALREADY_EXISTS = 183
        if h and err == 183:
            _log("BLOCK_MUTEX_ALREADY_EXISTS -> exit(0)")
            raise SystemExit(0)

        _MUTEX_HANDLE = h
        _log("ALLOW_MUTEX_ACQUIRED")
    except SystemExit:
        raise
    except Exception as e:
        # Fail-closed would be safer, but to avoid accidental downtime we fail-open and rely on lockfile.
        _log("WARN_MUTEX_FAIL_OPEN " + repr(e))

def _atomic_lockfile_or_exit() -> None:
    try:
        os.makedirs(_LDIR, exist_ok=True)

        # Atomic create: if exists => another instance already running.
        fd = os.open(_LFILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        try:
            os.write(fd, f"ts={time.strftime('%Y-%m-%dT%H:%M:%S')}\n".encode("utf-8"))
            os.write(fd, f"pid={os.getpid()}\n".encode("utf-8"))
            os.write(fd, f"ppid={os.getppid()}\n".encode("utf-8"))
        finally:
            os.close(fd)

        _log("ALLOW_LOCKFILE_CREATED")
    except FileExistsError:
        _log("BLOCK_LOCKFILE_EXISTS -> exit(0)")
        raise SystemExit(0)
    except SystemExit:
        raise
    except Exception as e:
        # If lockfile fails unexpectedly, rely on mutex (most robust on Windows).
        _log("WARN_LOCKFILE_FAIL_OPEN " + repr(e))

def _install_guard() -> None:
    if not _is_run_mode():
        return
    _acquire_mutex_or_exit()
    _atomic_lockfile_or_exit()
    _log("READY_GUARD_ACTIVE")

_install_guard()
# === END TBOT_SINGLE_INSTANCE_GUARD_PERM_V1 ===


import os, sys

def _tbot_detect_profile(argv):
    # Priority 1: explicit env
    p = (os.environ.get("TBOT_PROFILE") or os.environ.get("TBOT_MODE") or "").strip().upper()
    if p in ("PAPER","SHADOW","LIVE"):
        return p

    # Priority 2: argv hints
    a = " ".join(argv).lower()
    if "--shadow" in a or "shadow" in a:
        return "SHADOW"
    if "--paper" in a or "paper" in a:
        return "PAPER"
    if "--live" in a or "live" in a:
        return "LIVE"

    # Default
    return "PAPER"

def _tbot_install_mutex():
    if os.name != "nt":
        return

    try:
        import ctypes
        from ctypes import wintypes
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        CreateMutexW = kernel32.CreateMutexW
        CreateMutexW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.LPCWSTR]
        CreateMutexW.restype  = wintypes.HANDLE
        GetLastError = kernel32.GetLastError

        profile = _tbot_detect_profile(sys.argv)
        # Profile-aware mutex: PAPER/SHADOW/LIVE separated
        name = rf"Global\TBOT_ORG_BOT_UNIFIED_{profile}"

        h = CreateMutexW(None, False, name)
        if not h:
            sys.stderr.write("TBOT_MUTEX_FAIL\n")
            sys.exit(51)

        # ERROR_ALREADY_EXISTS = 183
        if GetLastError() == 183:
            sys.stderr.write("TBOT_MUTEX_ALREADY_EXISTS\n")
            sys.exit(33)

    except Exception:
        # fail-safe: if mutex install fails, do not risk dual runtime
        sys.stderr.write("TBOT_MUTEX_EXCEPTION\n")
        sys.exit(52)

_tbot_install_mutex()

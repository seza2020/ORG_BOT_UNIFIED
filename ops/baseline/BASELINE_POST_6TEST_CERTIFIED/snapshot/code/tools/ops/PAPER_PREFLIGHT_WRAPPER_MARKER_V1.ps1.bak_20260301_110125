param(
  [string]$Root    = "C:\alpaca-bot\org_bot",
  [string]$RunRoot = "C:\alpaca-bot\org_bot_runtime\paper"
)

$ErrorActionPreference="Stop"

$PW    = "C:\Program Files\PowerShell\7\pwsh.exe"
$PRE   = Join-Path $Root "tools\ops\PAPER_PREFLIGHT_CANON_V1.ps1"
$opsDir = Join-Path (Join-Path $RunRoot "logs") "ops"
New-Item -ItemType Directory -Force -Path $opsDir | Out-Null

$marker = Join-Path $opsDir "PREFLIGHT_OK.marker"
$ts = Get-Date -Format "yyyyMMdd_HHmmss"
$note = Join-Path (Join-Path $Root "logs\ops\audit") ("PAPER_PREFLIGHT_WRAPPER_" + $ts + ".txt")

"TS_LOCAL=$(Get-Date)" | Set-Content -Encoding UTF8 $note
"ROOT=$Root" | Add-Content -Encoding UTF8 $note
"RUNROOT=$RunRoot" | Add-Content -Encoding UTF8 $note
"PRE=$PRE" | Add-Content -Encoding UTF8 $note

if(!(Test-Path $PRE)){
  "NO_GO: MISSING_PRE=$PRE" | Add-Content -Encoding UTF8 $note
  exit 10
}

# Run real preflight
& $PW -NoProfile -ExecutionPolicy Bypass -File $PRE -Root $Root -RunRoot $RunRoot *>> $note 2>&1
$ec = $LASTEXITCODE
"PRE_EXIT=$ec" | Add-Content -Encoding UTF8 $note

if($ec -ne 0){
  "NO_GO: PREFLIGHT_FAILED" | Add-Content -Encoding UTF8 $note
  exit $ec
}

# Write marker on success
$payload = [pscustomobject]@{
  ts_local = (Get-Date).ToString("yyyy-MM-dd HH:mm:ss")
  kind     = "PREFLIGHT_OK"
  root     = $Root
  runroot  = $RunRoot
  note     = $note
}
$payload | ConvertTo-Json -Depth 6 | Set-Content -Encoding UTF8 -LiteralPath $marker

"[WRAP] WROTE_MARKER=$marker" | Add-Content -Encoding UTF8 $note
"[WRAP] NOTE=$note" | Add-Content -Encoding UTF8 $note

Write-Host ("[WRAP] OK MARKER=" + $marker)
Write-Host ("[WRAP] NOTE=" + $note)
exit 0

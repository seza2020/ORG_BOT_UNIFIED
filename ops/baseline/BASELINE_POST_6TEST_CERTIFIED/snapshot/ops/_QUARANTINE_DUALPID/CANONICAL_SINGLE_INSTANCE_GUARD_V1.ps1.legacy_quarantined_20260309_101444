param(
    [string]$UnifiedRoot = "C:\alpaca-bot\ORG_BOT_UNIFIED",
    [string]$Profile = "PAPER"
)

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$ops       = Join-Path $UnifiedRoot "ops"
$wrapdir   = Join-Path $ops "task_wrappers"
$runtime   = Join-Path $UnifiedRoot ("runtime\" + $Profile.ToLowerInvariant())
$logs      = Join-Path $runtime "logs"
$locks     = Join-Path $runtime "locks"
$downstream= Join-Path $wrapdir "ORG_UNIFIED_PAPER_RUN.ps1"
$lockFile  = Join-Path $locks "tbot_single_instance.lock.json"
$guardLog  = Join-Path $logs  "single_instance_guard_v1.jsonl"

New-Item -ItemType Directory -Force -Path $logs, $locks | Out-Null

function Write-GuardLog {
    param(
        [string]$Kind,
        [hashtable]$Payload
    )
    try {
        $obj = [ordered]@{
            ts      = (Get-Date).ToString("o")
            kind    = $Kind
            payload = $Payload
        }
        ($obj | ConvertTo-Json -Depth 8 -Compress) | Add-Content -LiteralPath $guardLog -Encoding UTF8
    } catch {}
}

function Get-TbotProcesses {
    try {
        return @(Get-CimInstance Win32_Process -Filter "Name='python.exe'" |
            Where-Object { $_.CommandLine -match "tbot\.main" } |
            Select-Object ProcessId, ParentProcessId, Name, CommandLine)
    } catch {
        return @()
    }
}

function Read-LockSafe {
    param([string]$Path)
    try {
        if (Test-Path -LiteralPath $Path) {
            return Get-Content -LiteralPath $Path -Raw -Encoding UTF8 | ConvertFrom-Json
        }
    } catch {}
    return $null
}

function Write-LockSafe {
    param(
        [string]$Path,
        [hashtable]$Payload
    )
    ($Payload | ConvertTo-Json -Depth 8) | Set-Content -LiteralPath $Path -Encoding UTF8
}

function Remove-LockSafe {
    param([string]$Path)
    try {
        if (Test-Path -LiteralPath $Path) {
            Remove-Item -LiteralPath $Path -Force
        }
    } catch {}
}

function Is-TbotPidAlive {
    param([int]$Pid)
    try {
        $p = Get-CimInstance Win32_Process -Filter "ProcessId=$Pid"
        if ($null -eq $p) { return $false }
        return ([string]$p.CommandLine -match "tbot\.main")
    } catch {
        return $false
    }
}

function Stop-AllTbot {
    try {
        Get-TbotProcesses | ForEach-Object {
            Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue
        }
    } catch {}
}

if (!(Test-Path -LiteralPath $downstream)) {
    Write-GuardLog -Kind "fatal_missing_downstream" -Payload @{ downstream = $downstream }
    exit 51
}

# -------- PRE-CHECK EXISTING PROCESS --------
$existing = @(Get-TbotProcesses)
if ($existing.Count -gt 0) {
    Write-GuardLog -Kind "launch_blocked_existing_process" -Payload @{
        existing_count = $existing.Count
        existing_pids  = @($existing | ForEach-Object { $_.ProcessId })
    }
    exit 90
}

# -------- LOCK PHASE --------
$lock = Read-LockSafe -Path $lockFile
if ($null -ne $lock) {
    $ownerPid = 0
    try { $ownerPid = [int]$lock.owner_pid } catch {}

    if ($ownerPid -gt 0 -and (Is-TbotPidAlive -Pid $ownerPid)) {
        Write-GuardLog -Kind "launch_blocked_live_lock_owner" -Payload @{
            owner_pid = $ownerPid
            lock_file = $lockFile
        }
        exit 91
    } else {
        Write-GuardLog -Kind "stale_lock_recovered" -Payload @{
            stale_owner_pid = $ownerPid
            lock_file       = $lockFile
        }
        Remove-LockSafe -Path $lockFile
    }
}

$lockPayload = [ordered]@{
    created_utc = (Get-Date).ToUniversalTime().ToString("o")
    owner_pid   = $PID
    wrapper_pid = $PID
    profile     = $Profile
    downstream  = $downstream
    user        = "$env:USERNAME"
    machine     = "$env:COMPUTERNAME"
}
Write-LockSafe -Path $lockFile -Payload $lockPayload

Write-GuardLog -Kind "lock_acquired" -Payload @{
    lock_file = $lockFile
    owner_pid = $PID
}

# -------- START DOWNSTREAM --------
$p = $null
try {
    $p = Start-Process -FilePath "C:\Program Files\PowerShell\7\pwsh.exe" `
        -ArgumentList @("-NoProfile","-ExecutionPolicy","Bypass","-File",$downstream) `
        -PassThru

    Write-GuardLog -Kind "downstream_started" -Payload @{
        downstream_pid = $p.Id
        downstream     = $downstream
    }

    Start-Sleep -Seconds 12

    $count12 = @(Get-TbotProcesses).Count
    Start-Sleep -Seconds 8
    $count20 = @(Get-TbotProcesses).Count

    if ($count12 -gt 1 -or $count20 -gt 1) {
        Write-GuardLog -Kind "post_launch_cert_fail_duplicate" -Payload @{
            count12 = $count12
            count20 = $count20
        }
        Stop-AllTbot
        Remove-LockSafe -Path $lockFile
        exit 92
    }

    if ($count20 -eq 0) {
        Write-GuardLog -Kind "post_launch_cert_fail_no_process" -Payload @{
            count12 = $count12
            count20 = $count20
        }
        Remove-LockSafe -Path $lockFile
        exit 93
    }

    Write-GuardLog -Kind "post_launch_cert_pass" -Payload @{
        count12 = $count12
        count20 = $count20
    }

    exit 0
}
catch {
    Write-GuardLog -Kind "guard_exception" -Payload @{
        error = $_.Exception.Message
    }
    Stop-AllTbot
    Remove-LockSafe -Path $lockFile
    exit 94
}

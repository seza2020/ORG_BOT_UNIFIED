$ErrorActionPreference = "Continue"

function _now_iso(){ (Get-Date).ToString("s") }
function _append_jsonl([string]$path, [hashtable]$obj){
  try{
    New-Item -ItemType Directory -Force (Split-Path $path) | Out-Null
    ($obj | ConvertTo-Json -Compress) + "
" | Add-Content -Encoding UTF8 -Path $path
  }catch{}
}

$ROOT   = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$RUNROOT= "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper"
$CODE   = Join-Path $ROOT "code"
$PY     = Join-Path $CODE ".venv\Scripts\python.exe"
$EV     = "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\logs\supervisor_events.jsonl"
$STATE  = "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\state\supervisor_state.json"
$LOCK   = Join-Path $RUNROOT "state\locks\SUPERVISOR_V3.lock"

# Crash-loop guard parameters
$WINDOW_SEC = 600   # 10 minutes
$MAX_RESTARTS = 5

# Acquire supervisor lock (single instance supervisor)
try{
  New-Item -ItemType Directory -Force (Split-Path $LOCK) | Out-Null
  if(Test-Path -LiteralPath $LOCK){
    # stale lock check
    $raw = ""
    try{ $raw = Get-Content -LiteralPath $LOCK -Raw }catch{}
    $pid = 0
    try{ $pid = ([int](($raw | ConvertFrom-Json).pid)) }catch{}
    if($pid -gt 0){
      try{ if(Get-Process -Id $pid -ErrorAction Stop){ return } }catch{}
    }
    try{ Remove-Item -Force $LOCK -ErrorAction SilentlyContinue }catch{}
  }
  @{ pid=$PID; ts=[double]([DateTimeOffset]::Now.ToUnixTimeSeconds()) } | ConvertTo-Json -Compress | Set-Content -Encoding UTF8 -Path $LOCK
}catch{
  return
}

# Ensure env is correct
$env:PYTHONPATH = $CODE
$env:TBOT_PROFILE = "paper"
$env:TBOT_RUNROOT = $RUNROOT

# Load state
$st = @{ restarts=@(); last_pid=0 }
try{
  if(Test-Path -LiteralPath $STATE){
    $st = Get-Content -LiteralPath $STATE -Raw | ConvertFrom-Json
  }
}catch{}

function _save_state(){
  try{
    New-Item -ItemType Directory -Force (Split-Path $STATE) | Out-Null
    ($st | ConvertTo-Json -Depth 6 -Compress) | Set-Content -Encoding UTF8 -Path $STATE
  }catch{}
}

# Check if bot already running (authoritative: tbot.main + RUNROOT)
$bot = $null
try{
  $bot = Get-CimInstance Win32_Process -Filter "Name='python.exe'" |
    Where-Object { $_.CommandLine -match "tbot\.main" -and $_.CommandLine -match [Regex]::Escape($RUNROOT) } |
    Select-Object -First 1
}catch{}

if($bot){
  _append_jsonl $EV @{ ts=_now_iso; kind="bot_alive"; pid=[int]$bot.ProcessId; runroot=$RUNROOT; root=$ROOT }
  _save_state
  return
}

# Crash-loop guard
$now = [double]([DateTimeOffset]::Now.ToUnixTimeSeconds())
$restarts = @()
try{
  foreach($t in $st.restarts){
    if([double]$t -ge ($now - $WINDOW_SEC)){ $restarts += [double]$t }
  }
}catch{}
if($restarts.Count -ge $MAX_RESTARTS){
  _append_jsonl $EV @{ ts=_now_iso; kind="crash_loop_guard"; action="stop"; restarts_in_window=$restarts.Count; window_sec=$WINDOW_SEC }
  $st.restarts = $restarts
  _save_state
  return
}

# Start bot (each run gets unique stdout/stderr to avoid file locks)
$stamp = (Get-Date -Format "yyyyMMdd_HHmmss")
$OUT = Join-Path $RUNROOT ("logs\supervised_bot_stdout_" + $stamp + ".log")
$ERR = Join-Path $RUNROOT ("logs\supervised_bot_stderr_" + $stamp + ".log")

$cmd = ""$PY" -X faulthandler -u -m tbot.main --run --iters 999999 --sleep 0.5"
_append_jsonl $EV @{ ts=_now_iso; kind="boot"; py=$PY; root=$ROOT; runroot=$RUNROOT }
_append_jsonl $EV @{ ts=_now_iso; kind="bot_start"; cmd=$cmd; root=$ROOT; runroot=$RUNROOT; out=$OUT; err=$ERR }

try{
  Start-Process -FilePath $PY -ArgumentList @("-X","faulthandler","-u","-m","tbot.main","--run","--iters","999999","--sleep","0.5") 
    -WorkingDirectory $ROOT -WindowStyle Hidden -RedirectStandardOutput $OUT -RedirectStandardError $ERR | Out-Null
}catch{
  _append_jsonl $EV @{ ts=_now_iso; kind="bot_start_failed"; err=($_.Exception.Message); root=$ROOT; runroot=$RUNROOT }
  return
}

# Update state
$st.restarts = @($restarts + @($now))
try{ $st.last_pid = 0 }catch{}
_save_state
_append_jsonl $EV @{ ts=_now_iso; kind="heartbeat"; root=$ROOT; runroot=$RUNROOT }

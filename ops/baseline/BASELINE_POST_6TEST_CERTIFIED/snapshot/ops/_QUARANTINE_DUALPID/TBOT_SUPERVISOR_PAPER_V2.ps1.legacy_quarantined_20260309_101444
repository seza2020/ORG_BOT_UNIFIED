$ErrorActionPreference='Continue'

function J([object]$o){ try { return ($o | ConvertTo-Json -Compress -Depth 12) } catch { return '{}' } }
function TS(){ return (Get-Date).ToString('yyyy-MM-ddTHH:mm:ss') }

$ROOT = 'C:\alpaca-bot\ORG_BOT_UNIFIED'
$CODE = 'C:\alpaca-bot\ORG_BOT_UNIFIED\code'
$PY   = 'C:\alpaca-bot\ORG_BOT_UNIFIED\code\.venv\Scripts\python.exe'
$RUNROOT = 'C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper'
$LOGDIR  = Join-Path $RUNROOT 'logs'
New-Item -ItemType Directory -Force $LOGDIR | Out-Null

$EV = Join-Path $LOGDIR 'supervisor_events.jsonl'
$STATE = Join-Path $LOGDIR 'supervisor_state.json'
$LOCK = Join-Path $LOGDIR 'supervisor_v2.lock'

function WriteEv([hashtable]$h){
  try{
    $h.ts = TS
    Add-Content -LiteralPath $EV -Encoding UTF8 -Value (J $h)
  } catch {}
}

# ----------------
# Supervisor single-instance lock
# ----------------
$lockFs = $null
try{
  $lockFs = [System.IO.File]::Open($LOCK, [System.IO.FileMode]::Create, [System.IO.FileAccess]::ReadWrite, [System.IO.FileShare]::None)
} catch {
  WriteEv @{ event='supervisor_skip'; reason='LOCK_HELD' }
  exit 0
}

# ----------------
# Fail-closed env binding
# ----------------
$env:PYTHONPATH = 'C:\alpaca-bot\ORG_BOT_UNIFIED\code'
$env:TBOT_PROFILE = 'paper'
$env:TBOT_RUNROOT = 'C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper'

if([string]::IsNullOrWhiteSpace($env:TBOT_RUNROOT) -or [string]::IsNullOrWhiteSpace($env:TBOT_PROFILE) -or [string]::IsNullOrWhiteSpace($env:PYTHONPATH)){
  WriteEv @{ event='abort'; reason='ENV_MISSING'; PYTHONPATH=$env:PYTHONPATH; TBOT_PROFILE=$env:TBOT_PROFILE; TBOT_RUNROOT=$env:TBOT_RUNROOT }
  exit 2
}

Set-Location $ROOT

# ----------------
# Load state (crash-loop guard)
# ----------------
$st = @{ window_sec = 900; max_fast_fails = 3; fail_times = @(); last_pid = 0 }
try{
  if(Test-Path -LiteralPath $STATE){
    $tmp = Get-Content -LiteralPath $STATE -Raw | ConvertFrom-Json
    if($tmp){ $st = @{
      window_sec = [int]($tmp.window_sec)
      max_fast_fails = [int]($tmp.max_fast_fails)
      fail_times = @($tmp.fail_times)
      last_pid = [int]($tmp.last_pid)
    } }
  }
} catch {}

function SaveState(){
  try{
    ($st | ConvertTo-Json -Depth 12) | Out-File -LiteralPath $STATE -Encoding UTF8
  } catch {}
}

# prune old fail times
try{
  $now = [DateTimeOffset]::Now.ToUnixTimeSeconds()
  $cut = $now - [int]$st.window_sec
  $st.fail_times = @($st.fail_times | Where-Object { [int64]$_ -ge $cut })
} catch {}

# ----------------
# Detect already-running bot
# ----------------
$bots = @()
try{
  $bots = Get-CimInstance Win32_Process -Filter "Name='python.exe'" |
    Where-Object { $_.CommandLine -match 'tbot\.main' -and $_.CommandLine -match 'ORG_BOT_UNIFIED' }
} catch {}

if($bots.Count -ge 1){
  WriteEv @{ event='heartbeat'; bot_running=True; bot_count=$bots.Count; pids=(@($bots | Select-Object -ExpandProperty ProcessId)) }
  SaveState
  exit 0
}

# ----------------
# Start bot (foreground run-loop)
# ----------------
$stdout = Join-Path $LOGDIR 'supervised_bot_stdout.log'
$stderr = Join-Path $LOGDIR 'supervised_bot_stderr.log'

$args = @('-X','faulthandler','-u','-m','tbot.main','--run','--iters','999999','--sleep','0.5')

WriteEv @{ event='boot'; root=$ROOT; runroot=$RUNROOT; py=$PY; cmd=('python ' + ($args -join ' ')) }

$p = $null
try{
  $p = Start-Process -FilePath $PY -WorkingDirectory $CODE -ArgumentList $args -PassThru -RedirectStandardOutput $stdout -RedirectStandardError $stderr
  $st.last_pid = [int]$p.Id
  SaveState
  WriteEv @{ event='bot_start'; pid=$p.Id }
} catch {
  WriteEv @{ event='bot_start_fail'; err=$_.Exception.Message }
  SaveState
  exit 1
}

Start-Sleep 5
$p.Refresh()
if($p.HasExited){
  # fast-fail
  try{
    $now = [DateTimeOffset]::Now.ToUnixTimeSeconds()
    $st.fail_times = @($st.fail_times + $now)
    SaveState
  } catch {}

  WriteEv @{ event='bot_exit_fast'; pid=$p.Id; exitcode=$p.ExitCode }

  # crash-loop policy
  $count = 0
  try{ $count = @($st.fail_times).Count } catch { $count = 0 }

  if($count -ge [int]$st.max_fast_fails){
    WriteEv @{ event='crash_loop_trip'; fast_fails=$count; window_sec=$st.window_sec; action='DISABLE_TASK' }
    try{
      schtasks /change /tn '\TBOT_SUPERVISOR_PAPER_V2' /disable | Out-Null
      WriteEv @{ event='task_disabled'; task='\TBOT_SUPERVISOR_PAPER_V2' }
    } catch {
      WriteEv @{ event='task_disable_fail'; task='\TBOT_SUPERVISOR_PAPER_V2'; err=$_.Exception.Message }
    }
    exit 1
  }

  exit 1
}

# alive
WriteEv @{ event='bot_alive'; pid=$p.Id }
SaveState
exit 0

$ErrorActionPreference='Continue'
$SUP='C:\alpaca-bot\ORG_BOT_UNIFIED\ops\tasks\TBOT_SUPERVISOR_PAPER_V1.ps1'
$RUNNER_LOG='C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\logs\supervisor_runner.log'
$TASK_OUT='C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\logs\supervisor_task_stdout.log'
$TASK_ERR='C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\logs\supervisor_task_stderr.log'

New-Item -ItemType Directory -Force (Split-Path $RUNNER_LOG) | Out-Null

Add-Content -LiteralPath $RUNNER_LOG -Value ("==== TASK_RUN " + (Get-Date).ToString('s') + " ====")

try{
  # run supervisor in-process so errors are visible
  pwsh -NoProfile -ExecutionPolicy Bypass -File $SUP *>> $TASK_OUT 2>> $TASK_ERR
} catch {
  Add-Content -LiteralPath $RUNNER_LOG -Value ("RUNNER_ERROR=" + $_.Exception.Message)
}

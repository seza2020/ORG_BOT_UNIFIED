  if($sec -and (Test-Path $sec)){ . $sec }
}

. (Join-Path $ProjectRoot "tools\paper\ALPACA_PAPER_REST_V1.ps1")

$ops   = Join-Path $RunRoot "logs\ops"
$led   = Join-Path $RunRoot "logs\ledger"
$state = Join-Path $RunRoot "state\paper_exec"
New-Item -ItemType Directory -Force -Path $ops,$led,$state | Out-Null

# Determine ISO day (prefer newest LEDGER_REAL_YYYYMMDD.jsonl)
if([string]::IsNullOrWhiteSpace($IsoDayOverride)){
  $lf = Get-ChildItem -Path $led -Filter "LEDGER_REAL_*.jsonl" -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending | Select-Object -First 1
  if($lf){
    $m=[regex]::Match($lf.Name,"^LEDGER_REAL_(\d{4})(\d{2})(\d{2})")
    if($m.Success){ $IsoDayOverride = "{0}-{1}-{2}" -f $m.Groups[1].Value,$m.Groups[2].Value,$m.Groups[3].Value }
  }
  if([string]::IsNullOrWhiteSpace($IsoDayOverride)){ $IsoDayOverride=(Get-Date).ToString("yyyy-MM-dd") }
}
$ymd=$IsoDayOverride.Replace("-","")
$ledgerPath = Join-Path $led ("LEDGER_REAL_{0}.jsonl" -f $ymd)

if(!(Test-Path $ledgerPath)){
  "NO_LEDGER_REAL=$ledgerPath"
  exit 0
}

# Read known states to avoid dup spam
$seenPath = Join-Path $state ("order_seen_{0}.json" -f $ymd)
$seen=@{}
if(Test-Path $seenPath){
  try{ $seen = (Get-Content -Raw -Encoding UTF8 $seenPath | ConvertFrom-Json) } catch { $seen=@{} }
}
if(-not $seen){ $seen=@{} }

# Pull broker orders for the day (UTC window)
$after = "$IsoDayOverride" + "T00:00:00Z"
$until = "$IsoDayOverride" + "T23:59:59Z"

$orders=@()
try { $orders = @(List-ApcaOrders -Status "all" -After $after -Until $until -Limit 500) } catch { $orders=@() }

$ts=(Get-Date).ToString("s")
$updates=0

foreach($o in $orders){
  # Only track our client_order_id namespace (safety)
  $cid = [string]$o.client_order_id
  if([string]::IsNullOrWhiteSpace($cid)){ continue }
  if($cid -notmatch '^TBOT-PAPER-'){ continue }

  $oid = [string]$o.id
  $status = [string]$o.status
  $filled_qty = [string]$o.filled_qty
  $filled_avg = [string]$o.filled_avg_price
  $key = $cid

  $sig = "{0}|{1}|{2}|{3}" -f $status,$filled_qty,$filled_avg,$oid
  $prev = $seen.$key

  if($prev -ne $sig){
    $ev = @{
      ts=$ts; kind="order_state"
      isoday=$IsoDayOverride
      client_order_id=$cid
      order_id=$oid
      status=$status
      filled_qty=$filled_qty
      filled_avg_price=$filled_avg
    }
    ($ev | ConvertTo-Json -Compress) | Add-Content -Encoding UTF8 -Path $ledgerPath
    $seen | Add-Member -NotePropertyName $key -NotePropertyValue $sig -Force
    $updates++
  }
}

($seen | ConvertTo-Json -Depth 6) | Set-Content -Encoding UTF8 -Path $seenPath

"ISO_DAY_USED=$IsoDayOverride"
"ORDERS_FETCHED=$($orders.Count)"
"UPDATES_WRITTEN=$updates"
"LEDGER_REAL=$ledgerPath"
"OK=POLL_PAPER_ORDERS_DONE"



_ldr -Profile 'PAPER' -ProjectRoot $ProjectRoot -RunRoot $RunRoot | Out-Null
} catch { throw }


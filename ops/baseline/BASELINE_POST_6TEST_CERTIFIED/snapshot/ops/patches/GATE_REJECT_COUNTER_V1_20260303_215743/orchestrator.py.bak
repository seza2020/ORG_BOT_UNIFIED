# === LOCAL_LLM_GATE_V1 ===
from tbot.runtime.local_decision_client import request_decision
import time, uuid

def llm_gate(features, meta):
    trace_id = str(uuid.uuid4())
    t0 = time.time()
    try:
        r = request_decision(
            features=features,
            meta=meta,
            trace_id=trace_id,
            timeout=1.0
        )
        latency = time.time() - t0
        if r is None:
            return False, "llm_timeout", latency
        if r.get("decision") != "ALLOW":
            return False, r.get("reason","deny"), latency
        return True, "allow", latency
    except Exception as e:
        return False, f"llm_error:{e}", 0.0
# === END_LOCAL_LLM_GATE_V1 ===

# === LLM_GATE_DISABLE_FLAG_V1 ===
import os as _os
def llm_gate_is_disabled(runroot):
    try:
        return _os.path.exists(_os.path.join(runroot, "state", "LLM_GATE_DISABLED.flag"))
    except Exception:
        return False

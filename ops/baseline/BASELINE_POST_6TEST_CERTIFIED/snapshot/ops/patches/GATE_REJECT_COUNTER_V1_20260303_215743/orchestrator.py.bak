import os
def run_loop(


    *,


    meta: MetaWriter,


    announce: AnnounceWriter,


    ledger: TradeLedger,


    env: str,


    symbols: tuple[str, ...],


    session: SessionWindow,


    iterations: int,


    sleep_sec: float,


    daily_alpha_kill_r: float,


    weekly_kill_r: float,


    sim_daily_r: float | None = None,


    sim_week_r: float | None = None,


    sim_trade: bool = False,


    sim_symbol: str = "SPY",


    sim_sid: str = "SIM",


    sim_side: str = "LONG",


    sim_qty: int = 1,


    sim_entry: float = 100.0,


    sim_stop: float = 99.0,


    sim_tp: float = 102.0,


    sim_exit: float = 101.0,


    force_signal_sid: str | None = None,


    force_signal_repeat: int = 1,


    force_signal_ignore_session: int = 0,


    force_signal_ignore_pre_close: int = 0,


    shadow_enabled: bool = False,


    shadow_path: str = "",


    shadow_risk_usd: float = 250.0,


    shadow_max_qty: int = 5000,


    shadow_entry: float = 100.0,


    shadow_stop: float = 99.0,


    shadow_tp: float = 102.0,


    gate_min_rr: float = 1.0,


    gate_min_conf: float = 0.0,


    gate_cooldown_sec: int = 60,


    gate_max_plans_per_day: int = 20,


    gate_max_risk_usd: float = 500.0,


    now_fn: Callable[[], datetime] | None = None,


) -> int:





    # ORCH_JSONL_BRIDGE_INIT_v4 (observability only)


    # OBS_TICK_LOCALIMPORT_ENTER_V1
    try:
        from tbot.obs.telemetry import TELEM as _TELEM
        _TELEM.count(kind='hb')
        
        # --- FAILURE_DETECTOR_TICK (V3) ---
        try:
            _rr = str(getattr(env, "runroot", "")) if "env" in globals() else ""
            _prof = str(getattr(env, "profile", "")) if "env" in globals() else ""
            _tbot_failure_eval(meta, _rr, _prof)
        except SystemExit:
            raise
        except Exception:
            pass
        # --- /FAILURE_DETECTOR_TICK ---
        _TELEM.event(name='run_loop_enter', build='obs_v1', ctx=ctx if 'ctx' in locals() else None)
        _TELEM.flush_daily(ctx=ctx if 'ctx' in locals() else None)
    except Exception:
        pass

    bridge = None


    try:


        if os.environ.get("TBOT_ENABLE_ORCH","0")=="1" and os.environ.get("TBOT_ORCH_JSONL","0")=="1":


            try:


                if hasattr(OrchBridgeWriter, "from_env"):


                    bridge = OrchBridgeWriter.from_env()


                else:


                    bridge = OrchBridgeWriter()


            except Exception:


                bridge = None





            _jp = (os.environ.get("TBOT_ORCH_JSONL_PATH") or "").strip()


            if bridge is not None and _jp:


                try:


                    bridge.path = _jp


                    try:


                        bridge.enabled = True


                    except Exception:


                        pass


                except Exception:


                    pass


    except Exception:


        bridge = None





    now_fn = now_fn or _now_et





    st = RunState()


    rs = RiskState()





    strategies = load_strategies()


    limiter = PolicyLimiter()


    scorecard = RuntimeScorecard()





    shadow_writer = ShadowPlanWriter(shadow_path) if shadow_enabled else None


    gate = ShadowGate(GateConfig(


        min_rr=float(gate_min_rr),


        min_confidence=float(gate_min_conf),


        cooldown_sec=int(gate_cooldown_sec),


        max_plans_per_day=int(gate_max_plans_per_day),


        max_risk_usd=float(gate_max_risk_usd),


    )) if shadow_enabled else None





    # QA/OPS stats (no behavioral effect)


    stats = Stats()


    last_metrics_emit = time.time()

    # === META_HEARTBEAT_V1 ===
    last_hb = time.time()
    meta_hb_sec = float((__import__('os').getenv('TBOT_META_HEARTBEAT_SEC') or '10').strip() or '10')
    if meta_hb_sec < 1.0:
        meta_hb_sec = 1.0
    if meta_hb_sec > 60.0:
        meta_hb_sec = 60.0






    ev = make_event(


        level="INFO",


        kind="boot",


        payload={


            "iterations": iterations,


            "sleep_sec": sleep_sec,


            "daily_alpha_kill_r": daily_alpha_kill_r,


            "weekly_kill_r": weekly_kill_r,


            "sim_daily_r": sim_daily_r,


            "sim_week_r": sim_week_r,


            "sim_trade": sim_trade,


            "force_signal_sid": force_signal_sid,


            "shadow_enabled": shadow_enabled,


            "shadow_path": shadow_path if shadow_enabled else None,


            "shadow_risk_usd": shadow_risk_usd if shadow_enabled else None,


            "shadow_max_qty": shadow_max_qty if shadow_enabled else None,


            "gate": {


                "min_rr": gate_min_rr,


                "min_conf": gate_min_conf,


                "cooldown_sec": gate_cooldown_sec,


                "max_plans_per_day": gate_max_plans_per_day,


                "max_risk_usd": gate_max_risk_usd,


            } if shadow_enabled else None,


            "strategies": [{"sid": s.sid, "is_alpha": getattr(s, "is_alpha", False)} for s in strategies],


        },


    )


    meta.emit(ev); announce.emit(ev)
    # === LLM_GATE_HOOK_V1 ===
    # === LLM_GATE_PRECHECK_AST_V1 (observability-only)
    try:
        meta.emit({"kind":"llm_gate_precheck","shadow_enabled":bool(shadow_enabled),"has_shadow_writer":bool(shadow_writer is not None),"has_gate":bool(gate is not None),"has_sig_payload":bool(sig_payload is not None)})
    except Exception:
        pass
    # === END_LLM_GATE_PRECHECK_AST_V1
        # === LLM_GATE_HOOK_V1 (safe evaluate) ===
    try:
        import os as _os
        _sym = None
        _feat = {}
        if isinstance(sig_payload, dict):
            _sym = sig_payload.get("symbol") or sig_payload.get("sym")
            _feat = sig_payload.get("features") or sig_payload.get("feat") or {}
        if not _sym:
            _tbsy = (_os.getenv("TBOT_SYMBOLS") or "").strip()
            _sym = (_tbsy.split(",")[0].strip() if _tbsy else "UNKNOWN")
        if not isinstance(_feat, dict):
            _feat = {}
        # LlmGate has .evaluate(symbol, features, meta)
        res = llm_gate.evaluate(_sym, _feat, meta={"phase":"RUN_LOOP","symbol":_sym})
        ok = bool(getattr(res, "decision", "") == "ALLOW" or getattr(res, "ok", False))
        reason = str(getattr(res, "reason", "") or "")
        lat = float(getattr(res, "latency_ms", 0.0) or 0.0)
    except Exception:
        ok, reason, lat = True, "llm_gate_fail_open", 0.0
    # === END_LLM_GATE_HOOK_V1 ===
    try:
        meta.emit({"kind":"llm_gate","ok":ok,"reason":reason,"latency":lat})
    except Exception:
        pass
    if not ok:
        return None
    # === END_LLM_GATE_HOOK_V1 ===











    prev_alpha_kill = st.alpha_kill


    prev_portfolio_kill = st.portfolio_kill


    opened = False


    forced_remaining = int(force_signal_repeat) if force_signal_sid else 0









    # --- SHADOW_TOUCH_PATH_V1 (observability) ---
    try:
        if shadow_enabled and shadow_path:
            import os as _os
            _os.makedirs(_os.path.dirname(shadow_path) or ".", exist_ok=True)
            with open(shadow_path, "a", encoding="utf-8") as _f:
                _f.write("")  # touch file even if no accepts
    except Exception:
        pass
    # --- /SHADOW_TOUCH_PATH_V1 ---
    # --- TBOT_DISABLE_FORCED_SIGNAL_TEST_V1 BEGIN ---


    import os as _tbot_os


    if force_signal_sid and (_tbot_os.getenv('TBOT_ALLOW_FORCE_SIGNAL_TEST','0') != '1'):


        try:


            ev = make_event(level='WARN', kind='signal_skip', payload={'sid': str(force_signal_sid), 'reason': 'forced_signal_disabled'})


            meta.emit(ev); announce.emit(ev)


        except Exception:


            pass


        force_signal_sid = None


        forced_remaining = 0


    # --- TBOT_DISABLE_FORCED_SIGNAL_TEST_V1 END ---
    _stage4_last_sec = None





    for i in range(iterations):


        stats.iterations = int(i) + 1
        now = now_fn()
        # API_ROOTFIX_V1: meta heartbeat (always)
        try:
            if meta is not None and _meta_hb_sec > 0:
                __g = globals()
                __t = __import__('time').time()
                __last = float(__g.get('_meta_hb_last', 0.0) or 0.0)
                if (__t - __last) >= float(_meta_hb_sec):
                    __g['_meta_hb_last'] = __t
                    meta.write('heartbeat', {
                        'i': int(i) + 1,
                        'in_session': bool(getattr(st,'in_session',False)),
                        'pre_close': bool(getattr(st,'pre_close',False)),
                    })
                    # --- PERF_TICK_V1 BEGIN ---
                    try:
                        from tbot.analytics.perf_tracker import perf_tick as _perf_tick
                        _perf_tick(
                            meta=meta,
                            runroot=(os.environ.get("TBOT_RUNROOT") or ""),
                            profile=(os.environ.get("TBOT_PROFILE") or "paper"),
                        )
                    except Exception:
                        pass
                    # --- PERF_TICK_V1 END ---

                    # --- PNL_TICK_V1 BEGIN ---
                    try:
                        from tbot.obs.pnl_sampler import pnl_tick as _pnl_tick
                        _pnl_tick(meta=meta, runroot=(os.environ.get("TBOT_RUNROOT") or ""), profile=(os.environ.get("TBOT_PROFILE") or "paper"))
                    except Exception:
                        pass
                    # --- PNL_TICK_V1 END ---

        except Exception:
            pass
        # TZ_GUARD_AFTER_NOWFN (debug-only)
        if (__import__("os").getenv("TBOT_DEBUG_TIME") or "").strip() == "1":
            if now.tzinfo is None:
                now = now.replace(tzinfo=timezone.utc)

        # NOWDBG_ONCE (debug-only)
        if (__import__("os").getenv("TBOT_DEBUG_TIME") or "").strip() == "1" and i == 0:
            try:
                print(f"[NOWDBG] now={now!r} tz={getattr(now,'tzinfo',None)}")
            except Exception:
                pass
        st.in_session = session.in_session(now)


        st.pre_close = session.is_pre_close(now)





        if sim_daily_r is not None:


            rs.daily_r = float(sim_daily_r)


        if sim_week_r is not None:


            rs.week_r = float(sim_week_r)





        rs = apply_kill_rules(rs, daily_alpha_kill_r=daily_alpha_kill_r, weekly_kill_r=weekly_kill_r)


        st.daily_r = rs.daily_r


        st.week_r = rs.week_r


        st.alpha_kill = rs.alpha_kill


        st.portfolio_kill = rs.portfolio_kill





        if st.alpha_kill != prev_alpha_kill:


            ev = make_event(level="INFO", kind="alpha_kill_change",


                            payload={"value": st.alpha_kill, "daily_r": st.daily_r})


            meta.emit(ev); announce.emit(ev)


            prev_alpha_kill = st.alpha_kill





        if st.portfolio_kill != prev_portfolio_kill:


            ev = make_event(level="INFO", kind="portfolio_kill_change",


                            payload={"value": st.portfolio_kill, "week_r": st.week_r})


            meta.emit(ev); announce.emit(ev)


            prev_portfolio_kill = st.portfolio_kill





        force_override = bool(force_signal_sid and force_signal_ignore_session)


        force_override_pre_close = bool(force_signal_sid and int(force_signal_ignore_pre_close))


        in_session = bool(st.in_session or force_override)

        # keep state consistent for downstream checks
        st.in_session = in_session


        pre_close = bool(st.pre_close and (not force_override_pre_close))


        st.pre_close = pre_close





        # ROTATE_PRIMARY_SYMBOL


        try:


            if symbols:


                _k = int(i) % len(symbols)


                if _k:


                    symbols = tuple(symbols[_k:] + symbols[:_k])


        except Exception:


            pass





        market = build_market_snapshot(symbols=symbols)


        _fill_market_from_alpaca_if_needed(market)


        try:


            market = build_market_snapshot(symbols=symbols)


            _fill_market_from_alpaca_if_needed(market)


        except TypeError:


            market = build_market_snapshot(symbols=symbols)


            _fill_market_from_alpaca_if_needed(market)


        try:


            market = build_market_snapshot(symbols=symbols)


            _fill_market_from_alpaca_if_needed(market)


        except TypeError:


            market = build_market_snapshot(symbols=symbols)


            _fill_market_from_alpaca_if_needed(market)


        ctx = SignalContext(


            now=now,


            in_session=in_session,


            pre_close=pre_close,


            alpha_kill=st.alpha_kill,


            portfolio_kill=st.portfolio_kill,


            symbols=symbols,


            market=market,


        )





        rr = detect_regime(now=now, market=market)


        ov = overlay_for_regime(rr.regime)


        regime_overlay = ov


        ev = make_event(level="INFO", kind="regime", payload={


            "regime": rr.regime,


            "confidence": rr.confidence,


            "alpha_mode": ov.alpha_mode,


        })


        meta.emit(ev); announce.emit(ev)





        cc = detect_core_context(symbol=str(symbols[0] if symbols else 'NA'), snap=(_snap_get(market, symbols[0]) if symbols else object()))


        ev = make_event(level="INFO", kind="core_context", payload={


            "bias": cc.bias,


            "trend_strength": cc.trend_strength,


            "vwap_state": cc.vwap_state,


            "ema_sep": cc.ema_sep,


            "reason": cc.reason,


        })


        meta.emit(ev); announce.emit(ev)





        # Alpha mode decision (policy layer)


        try:


            _reg = rr.regime


        except Exception:


            _reg = "UNKNOWN"


        _adm = decide_alpha_mode(


            regime=str(_reg),


            bias=str(getattr(cc, "bias", "NEUTRAL")),


            trend_strength=float(getattr(cc, "trend_strength", 0.0)),


        )


        dec = _adm


        ev = make_event(level="INFO", kind="alpha_mode", payload={


            "mode": dec.mode,


            "cap_ratio": dec.cap_ratio,


            "reason": dec.reason,


        })


        meta.emit(ev); announce.emit(ev)





        # Attach core_context + alpha_mode to ctx for strategy access (frozen-safe via dataclasses.replace)


        try:


            _cc = cc if "cc" in locals() else None


            _mode = str(dec.mode) if "dec" in locals() else None


            _cap = float(getattr(dec, "cap_ratio", 1.0)) if "dec" in locals() else None


            ctx = replace(ctx, core_context=_cc, alpha_mode=_mode, alpha_cap_ratio=_cap)


        except Exception:


            pass





        # Standardized signal_skip reasons (enterprise QA)


        if (not ctx.in_session) or ctx.pre_close or ctx.portfolio_kill:


            if not ctx.in_session:


                _rsn = 'out_of_session'


            elif ctx.portfolio_kill:


                _rsn = 'portfolio_kill_active'


            else:


                _rsn = 'pre_close_active'


            stats.signal_skip += 1


            getattr(stats,'bump_reason',(lambda *_: None))(_rsn)


            ev = make_event(level='INFO', kind='signal_skip', payload={'reason': _rsn})


            meta.emit(ev); announce.emit(ev)


        else:


            # PATCH_CTX_ATTACH_BEFORE_STRATEGY_LOOP=1


            # Ensure ctx has core_context + alpha_mode for strategy access (safe)


            try:


                cc = detect_core_context(symbol=str(symbols[0] if symbols else 'NA'), snap=(_snap_get(market, symbols[0]) if symbols else object()))


                try:


                    setattr(ctx, 'core_context', cc)


                except Exception:


                    pass


            except Exception:


                pass


            try:


                dec = decide_alpha_mode(regime=str(getattr(rr, 'regime', 'TREND')))


                try:


                    setattr(ctx, 'alpha_mode', dec.mode)


                except Exception:


                    pass


                ev = make_event(level='INFO', kind='alpha_mode', payload={'mode': dec.mode, 'cap_ratio': float(getattr(dec,'cap_ratio',0.0)), 'reason': str(getattr(dec,'reason',''))})


                meta.emit(ev); announce.emit(ev)


            except Exception:


                pass





            for strat in strategies:


                is_alpha = bool(getattr(strat, "is_alpha", False))


                if is_alpha and ctx.alpha_kill:


                    # For alpha strategies, we still record evaluation but block plan creation via gate


                    pass





                ev = make_event(level="INFO", kind="signal_eval", payload={"sid": strat.sid})


                meta.emit(ev); announce.emit(ev)





                sig_payload = None
                sig_forced = False  # init each strategy evaluation pass
                sig = None  # init to avoid UnboundLocalError
                # Forced signal (test)
                if force_signal_sid and (forced_remaining > 0) and strat.sid.upper() == force_signal_sid:
                    # guard: alpha kill blocks alpha signals (forced)
                    if is_alpha and bool(ctx.alpha_kill):
                        forced_remaining -= 1
                        stats.signal_skip += 1
                        stats.bump_reason('alpha_kill_active')
                        ev = make_event(level='WARN', kind='signal_skip', payload={'sid': strat.sid, 'reason': 'alpha_kill_active'})
                        meta.emit(ev); announce.emit(ev)
                        continue

                    forced_remaining -= 1

                    # IMPORTANT: create a real Signal so normal pipeline (gate/shadow) is exercised.
                    sig = Signal(
                        sid=strat.sid,
                        symbol=(symbols[0] if symbols else 'SPY'),
                        side='LONG',
                        confidence=0.99,
                        reason='forced_signal_test',
                    )
                    sig_forced = True

                    # forced payload so shadow pipeline can run (and cap_ratio bypass works)
                    if sig_payload is None:
                        sig_payload = {
                            'sid': sig.sid,
                            'symbol': sig.symbol,
                            'side': sig.side,
                            'confidence': float(sig.confidence),
                            'reason': str(sig.reason),
                            'source': 'forced',
                        }

                    stats.signal_fire += 1
                    ev = make_event(level='INFO', kind='signal_fire', payload={
                        'sid': sig.sid,
                        'symbol': sig.symbol,
                        'side': sig.side,
                        'confidence': sig.confidence,
                        'reason': sig.reason,
                        'source': 'forced',
                    })
                    meta.emit(ev); announce.emit(ev)

                    # forced: keep generated sig; do not overwrite with strat.evaluate(ctx)
                else:
                    sig = strat.evaluate(ctx)

                # Strategy result telemetry (self-contained, safe)


                try:


                    _mvp = str(__import__("os").getenv("TBOT_ENABLE_S11_MVP", "0")).strip()


                    _has_cc = (getattr(ctx, "core_context", None) is not None)


                    _has_am = (getattr(ctx, "alpha_mode", None) is not None)


                    _sig = sig


                    ev = make_event(level="INFO", kind="strategy_result", payload={


                        "sid": str(strat.sid),


                        "mvp_env": _mvp,


                        "has_core_context": bool(_has_cc),


                        "has_alpha_mode": bool(_has_am),


                        "returned": ("NONE" if _sig is None else "SIGNAL"),


                        "symbol": (None if _sig is None else str(getattr(_sig, "symbol", None))),


                        "side": (None if _sig is None else str(getattr(_sig, "side", None))),


                        "confidence": (None if _sig is None else float(getattr(_sig, "confidence", 0.0))),


                        "reason": (None if _sig is None else str(getattr(_sig, "reason", ""))),


                    })
                    # === SIG_PAYLOAD_MISSING_AST_V1 (observability-only)
                    try:
                        if sig_payload is None:
                            meta.emit({"kind":"sig_payload_missing","sid":sid if 'sid' in locals() else None,"alpha_mode":getattr(ctx,'alpha_mode',None) if 'ctx' in locals() else None,"confidence":float(confidence or 0.0) if 'confidence' in locals() else 0.0,"rr":float(rr or 0.0) if 'rr' in locals() else 0.0,"reason":"strategy_did_not_emit_payload"})
                    except Exception:
                        pass
                    # === END_SIG_PAYLOAD_MISSING_AST_V1


                    meta.emit(ev); announce.emit(ev)


                except Exception:


                    pass





                if sig is not None:


                    # guard: alpha kill blocks alpha signals (real)


                    if is_alpha and bool(ctx.alpha_kill):


                        stats.signal_skip += 1


                        stats.bump_reason("alpha_kill_active")


                        ev = make_event(level="WARN", kind="signal_skip", payload={"sid": strat.sid, "reason": "alpha_kill_active"})


                        meta.emit(ev); announce.emit(ev)


                        continue





                    sig_payload = {


                        "sid": sig.sid,


                        "symbol": sig.symbol,


                        "side": sig.side,


                        "confidence": sig.confidence,


                        "reason": sig.reason,


                        "source": "strategy",


                    }


                    stats.signal_fire += 1


                    if not sig_forced:
                        ev = make_event(level="INFO", kind="signal_fire", payload=sig_payload)
                        meta.emit(ev); announce.emit(ev)





                    # Alpha mode enforcement (policy)


                    if bool(is_alpha):


                        try:


                            _mode = str(getattr(locals().get("dec", None), "mode", "ON")).upper()


                            if _mode == "OFF":


                                stats.signal_skip += 1


                                stats.bump_reason("regime_alpha_off")


                                ev = make_event(level="INFO", kind="signal_skip", payload={"sid": str(sig_payload["sid"]), "reason": "regime_alpha_off"})


                                meta.emit(ev); announce.emit(ev)


                                continue


                        except Exception:


                            pass





                if shadow_enabled and (shadow_writer is not None) and (gate is not None) and (sig_payload is not None):


                    # Scorecard overlay (alpha admission) - MVP


                    try:


                        scorecard.record_fire(str(sig_payload["sid"]))


                    except Exception:


                        pass





                    if bool(is_alpha):


                        sc = AlphaScore(


                            fires=int(scorecard.get_fires(str(sig_payload["sid"]))),


                            accepts=int(scorecard.get_accepts(str(sig_payload["sid"]))),


                            avg_r=float(scorecard.get_avg_r(str(sig_payload["sid"]))),


                            pf=float(scorecard.get_pf(str(sig_payload["sid"]))),


                            dd=float(scorecard.get_dd(str(sig_payload["sid"]))),


                        )


                        dec = decide_alpha(sc)



                        # --- TBOT_SHADOW_SOFT_NEGEXP_V1 BEGIN ---
                        try:
                            import os as _tbot_os
                            import datetime as _tbot_dt

                            if bool(shadow_enabled) and str(_tbot_os.getenv("TBOT_SHADOW_SOFT_NEGEXP","0")).strip() == "1":
                                _soft_cap = float(str(_tbot_os.getenv("TBOT_SHADOW_SOFT_NEGEXP_CAP_RATIO","0.10")).strip() or "0.10")
                                _min_acc  = int(str(_tbot_os.getenv("TBOT_SHADOW_SOFT_NEGEXP_MIN_ACCEPTS","120")).strip() or "120")
                                _soft_cd  = int(str(_tbot_os.getenv("TBOT_SHADOW_SOFT_NEGEXP_COOLDOWN_SEC","180")).strip() or "180")
                                _until_s  = str(_tbot_os.getenv("TBOT_SHADOW_SOFT_NEGEXP_SOFT_UNTIL_PT","13:00")).strip()

                                # local machine time (PT on your box)
                                _now = _tbot_dt.datetime.now()
                                _now_min = int(_now.hour) * 60 + int(_now.minute)

                                _until_min = None
                                try:
                                    _hh, _mm = [int(x) for x in _until_s.split(":")[:2]]
                                    _until_min = _hh * 60 + _mm
                                except Exception:
                                    _until_min = None

                                _acc_today = 0
                                try:
                                    _acc_today = int(getattr(stats, "shadow_accept", 0) or 0)
                                except Exception:
                                    _acc_today = 0

                                # If alpha admission wants to hard-block due to negative_expectancy,
                                # shadow should switch to "soft mode" (allow but tiny risk + slower).
                                if (not bool(getattr(dec, "allow", True))) and str(getattr(dec, "reason", "")).strip() == "negative_expectancy":
                                    _forbid_hard_off = False
                                    if _acc_today < _min_acc:
                                        _forbid_hard_off = True
                                    if (_until_min is not None) and (_now_min < _until_min):
                                        _forbid_hard_off = True

                                    if _forbid_hard_off:
                                        # 1) allow with small cap_ratio (reduces shadow risk)
                                        try:
                                            dec = type(dec)(allow=True, cap_ratio=float(_soft_cap), reason="negative_expectancy_soft")
                                        except Exception:
                                            dec = type(dec)(True, float(_soft_cap), "negative_expectancy_soft")

                                        # 2) optional: slow down via gate cooldown if possible
                                        try:
                                            if "gate" in locals() and hasattr(gate, "cooldown_sec"):
                                                gate.cooldown_sec = max(int(getattr(gate, "cooldown_sec", 0) or 0), int(_soft_cd))
                                        except Exception:
                                            pass
                        except Exception:
                            pass
                        # --- TBOT_SHADOW_SOFT_NEGEXP_V1 END ---

                        try:


                            ev = make_event(level="INFO", kind="alpha_admission", payload={


                                "sid": str(sig_payload.get("sid")),


                                "fires": int(getattr(sc, "fires", 0)),


                                "accepts": int(getattr(sc, "accepts", 0)),


                                "avg_r": float(getattr(sc, "avg_r", 0.0)),


                                "pf": float(getattr(sc, "pf", 0.0)),


                                "dd": float(getattr(sc, "dd", 0.0)),


                                "allow": bool(getattr(dec, "allow", False)),


                                "cap_ratio": float(getattr(dec, "cap_ratio", 0.0)),


                                "reason": str(getattr(dec, "reason", "")),


                            })


                            meta.emit(ev); announce.emit(ev)


                        except Exception:


                            pass


                        if not bool(dec.allow):


                            stats.signal_skip += 1


                            stats.bump_reason(str(dec.reason))


                            ev = make_event(level="INFO", kind="signal_skip", payload={"sid": str(sig_payload["sid"]), "reason": str(dec.reason)})


                            meta.emit(ev); announce.emit(ev)


                            continue





                    _entry_eff = float(shadow_entry)


                    _stop_eff  = float(shadow_stop)


                    _tp_eff    = float(shadow_tp)


                    prices = _tbot_safe_shadow_prices(


                        sig_payload=sig_payload,


                        market=market,


                        default_entry=float(_entry_eff),


                        default_stop=float(_stop_eff),


                        default_tp=float(_tp_eff),


                    )





                    prices = _tbot_safe_shadow_prices(


                        sig_payload=sig_payload,


                        market=market,


                        default_entry=float(prices.entry),


                        default_stop=float(prices.stop),


                        default_tp=float(prices.tp),


                    )





                    if regime_enabled() and bool(is_alpha):


                        sig2, rsn2 = apply_alpha_overlay(is_alpha=True, sig_payload=sig_payload, overlay=regime_overlay)


                        if sig2 is None:


                            stats.signal_skip += 1


                            stats.bump_reason(str(rsn2))


                            ev = make_event(level="INFO", kind="signal_skip", payload={"sid": str(sig_payload["sid"]), "reason": rsn2})


                            meta.emit(ev); announce.emit(ev)


                            continue


                        sig_payload = sig2





                    alpha_tier = classify_alpha(str(sig_payload["sid"]))


                    sid_for_plan = str(sig_payload["sid"])


                    ok_fire, rsn_fire = limiter.can_fire(sid_for_plan, now)


                    if not ok_fire:


                        stats.signal_skip += 1


                        stats.bump_reason(f"{rsn_fire}:{alpha_tier}")


                        ev = make_event(level="INFO", kind="signal_skip", payload={"sid": sid_for_plan, "reason": f"{rsn_fire}:{alpha_tier}"})


                        meta.emit(ev); announce.emit(ev)


                        continue


                    limiter.record_fire(sid_for_plan, now)





                    _entry_eff = float(shadow_entry)


                    _stop_eff = float(shadow_stop)


                    _tp_eff = float(shadow_tp)


                    try:


                        _side = str(sig_payload.get("side","")).upper()


                        if _side == "SHORT":


                            _stop_dist = abs(_entry_eff - _stop_eff)


                            _tp_dist = abs(_tp_eff - _entry_eff)


                            _stop_eff = _entry_eff + _stop_dist


                            _tp_eff = _entry_eff - _tp_dist


                    except Exception:


                        pass





                    try:


                        ev = make_event(level='INFO', kind='signal_eval', payload={


                            'probe': 'SHADOW_BUILD_ENTER',


                            'shadow_enabled': bool(shadow_enabled),


                            'shadow_path': str(shadow_path),


                            'shadow_risk_usd': float(shadow_risk_usd),


                            'shadow_max_qty': int(shadow_max_qty),


                            'has_sig_payload': bool('sig_payload' in locals()),


                            'sid': (None if 'sig_payload' not in locals() else str(sig_payload.get('sid'))),


                            'symbol': (None if 'sig_payload' not in locals() else str(sig_payload.get('symbol'))),


                            'side': (None if 'sig_payload' not in locals() else str(sig_payload.get('side'))),


                            'confidence': (None if 'sig_payload' not in locals() else float(sig_payload.get('confidence', 0.0))),


                        })


                        meta.emit(ev); announce.emit(ev)


                    except Exception:


                        pass





                    try:


                        plan = build_shadow_plan(


                            env=env,


                            sid=sig_payload["sid"],


                            symbol=sig_payload["symbol"],


                            side=sig_payload["side"],


                            confidence=float(sig_payload["confidence"]),


                            max_qty=int(shadow_max_qty),


                            reason=str(sig_payload["reason"]),


                            entry=float(prices.entry),


                            stop=float(prices.stop),


                            tp=float(prices.tp),


                            risk_usd=float(shadow_risk_usd) * (float(getattr(locals().get('dec', None), 'cap_ratio', 1.0)) if (bool(is_alpha) and (str(sig_payload.get('source','')).lower() != 'forced')) else 1.0),


                            notes="shadow_only:no_orders",


                        )


                    except Exception as e:


                        try:


                            ev = make_event(level='ERROR', kind='shadow_build_error', payload={


                                'err': repr(e),


                                'sid': (None if 'sig_payload' not in locals() else str(sig_payload.get('sid'))),


                                'symbol': (None if 'sig_payload' not in locals() else str(sig_payload.get('symbol'))),


                                'side': (None if 'sig_payload' not in locals() else str(sig_payload.get('side'))),


                                'confidence': (None if 'sig_payload' not in locals() else float(sig_payload.get('confidence', 0.0))),


                                'prices_entry': (None if 'prices' not in locals() else float(getattr(prices,'entry',0.0))),


                                'prices_stop': (None if 'prices' not in locals() else float(getattr(prices,'stop',0.0))),


                                'prices_tp':   (None if 'prices' not in locals() else float(getattr(prices,'tp',0.0))),


                                'shadow_entry': (None if 'shadow_entry' not in locals() else float(shadow_entry)),


                                'shadow_stop':  (None if 'shadow_stop' not in locals() else float(shadow_stop)),


                                'shadow_tp':    (None if 'shadow_tp' not in locals() else float(shadow_tp)),


                                'shadow_risk_usd': (None if 'shadow_risk_usd' not in locals() else float(shadow_risk_usd)),


                                'shadow_max_qty': (None if 'shadow_max_qty' not in locals() else int(shadow_max_qty)),


                            })


                            meta.emit(ev); announce.emit(ev)


                        except Exception:


                            pass


                        plan = None





                    alpha_kill_for_gate = bool(ctx.alpha_kill and is_alpha)





                    # --- TBOT_HARD_BLOCK_FAKE_PRICE_V1 BEGIN ---
                    try:
                        import os as _tbot_os
                        from tbot.runtime.gate_state import is_fake_payload as _tbot_is_fake
                        _p = {
                            'reason': getattr(plan, 'reason', None),
                            'entry':  getattr(plan, 'entry',  None),
                            'stop':   getattr(plan, 'stop',   None),
                            'tp':     getattr(plan, 'tp',     None),
                        }
                        if plan is not None and _tbot_is_fake(_p) and (_tbot_os.getenv('TBOT_HARD_STOP_ON_FAKE_PRICE','1') == '1'):
                            try:
                                ev = make_event(level='ERROR', kind='shadow_reject', payload={
                                    'sid': getattr(plan,'sid',None),
                                    'symbol': getattr(plan,'symbol',None),
                                    'side': getattr(plan,'side',None),
                                    'qty': getattr(plan,'qty',None),
                                    'entry': getattr(plan,'entry',None),
                                    'stop': getattr(plan,'stop',None),
                                    'tp': getattr(plan,'tp',None),
                                    'risk_usd': getattr(plan,'risk_usd',None),
                                    'rr': getattr(plan,'rr',None),
                                    'confidence': getattr(plan,'confidence',None),
                                    'reason': getattr(plan,'reason',None),
                                    'reasons': ['fake_price_blocked'],
                                })
                                meta.emit(ev); announce.emit(ev)
                            except Exception:
                                pass
                            raise SystemExit('[FAKE_PRICE] hard-stop: forced/template pricing detected; refusing to accept any plan.')
                    except SystemExit:
                        raise
                    except Exception:
                        pass
                    # --- TBOT_HARD_BLOCK_FAKE_PRICE_V1 END ---
                    # --- TBOT_ENTRY_DEVIATION_GUARD_V1 BEGIN ---
                    try:
                        import os as _tbot_os
                        _pct = float(_tbot_os.getenv('TBOT_MAX_ENTRY_DEVIATION_PCT','0.02'))
                        _hard = (_tbot_os.getenv('TBOT_HARD_STOP_ON_ENTRY_DEVIATION','1') == '1')
                        _sym = getattr(plan,'symbol',None)
                        _entry = getattr(plan,'entry',None)
                        _last = None
                        if _sym:
                            try:
                                _snap = getattr(market, _sym, None)
                                _last = getattr(_snap, 'last', None)
                            except Exception:
                                _last = None
                        if _last is not None and _entry is not None:
                            _lf = float(_last); _ef = float(_entry)
                            if _lf > 0 and abs(_ef - _lf)/_lf > _pct:
                                try:
                                    ev = make_event(level='ERROR', kind='shadow_reject', payload={
                                        'sid': getattr(plan,'sid',None),
                                        'symbol': _sym,
                                        'side': getattr(plan,'side',None),
                                        'qty': getattr(plan,'qty',None),
                                        'entry': _ef,
                                        'stop': getattr(plan,'stop',None),
                                        'tp': getattr(plan,'tp',None),
                                        'risk_usd': getattr(plan,'risk_usd',None),
                                        'rr': getattr(plan,'rr',None),
                                        'confidence': getattr(plan,'confidence',None),
                                        'reason': getattr(plan,'reason',None),
                                        'reasons': ['entry_off_market'],
                                        'last': _lf,
                                        'max_entry_dev_pct': _pct,
                                    })
                                    meta.emit(ev); announce.emit(ev)
                                except Exception:
                                    pass
                                if _hard:
                                    raise SystemExit(f"[ENTRY_OFF_MARKET] hard-stop: entry={_ef} last={_lf} dev_pct={abs(_ef-_lf)/_lf:.4f} > {_pct}")
                    except SystemExit:
                        raise
                    except Exception:
                        pass
                    # --- TBOT_ENTRY_DEVIATION_GUARD_V1 END ---

                    ok, reasons = gate.evaluate(


                        now=now,


                        plan=plan,


                        alpha_kill=alpha_kill_for_gate,


                        portfolio_kill=bool(ctx.portfolio_kill),


                        in_session=bool(ctx.in_session),


                        pre_close=bool(ctx.pre_close),


                    )





                    if not ok:


                        stats.shadow_reject += 1


                        try:


                            for r in (reasons or []):


                                stats.bump_reason(str(r))


                        except Exception:


                            pass





                        ev = make_event(level="WARN", kind="shadow_reject", payload={


                            "sid": plan.sid,


                            "symbol": plan.symbol,


                            "side": plan.side,


                            "qty": plan.qty,


                            "entry": plan.entry,


                            "stop": plan.stop,


                            "tp": plan.tp,


                            "risk_usd": plan.risk_usd,


                            "rr": round(plan.rr, 4),


                            "confidence": plan.confidence,


                            "reason": plan.reason,


                            "reasons": reasons,


                        })


                        meta.emit(ev); announce.emit(ev)


                    else:


                        ok_acc, rsn_acc = limiter.can_accept(plan.sid, now)


                        if not ok_acc:


                            stats.shadow_reject += 1


                            stats.bump_reason(str(rsn_acc))


                            ev = make_event(level="WARN", kind="shadow_reject", payload={


                                "sid": plan.sid,


                                "symbol": plan.symbol,


                                "side": plan.side,


                                "qty": plan.qty,


                                "entry": plan.entry,


                                "stop": plan.stop,


                                "tp": plan.tp,


                                "risk_usd": plan.risk_usd,


                                "rr": round(plan.rr, 4),


                                "confidence": plan.confidence,


                                "reason": plan.reason,


                                "reasons": [rsn_acc],


                            })


                            meta.emit(ev); announce.emit(ev)


                            continue





                        limiter.record_accept(plan.sid, now); (getattr(scorecard,'record_accept',lambda *_: None))(str(plan.sid))


                        gate.commit_accept(now=now, plan=plan)
                        # ------------------------------
                        # SHADOW DEDUPE GUARD (prevents identical plan spam)
                        # Env: TBOT_SHADOW_DEDUPE_WINDOW_SEC (e.g. 1800 = 30min). 0 disables.
                        # ------------------------------
                        try:
                            import time as _time
                            try:
                                _dedupe_w = float(os.getenv("TBOT_SHADOW_DEDUPE_WINDOW_SEC", "0") or 0)
                            except Exception:
                                _dedupe_w = 0.0

                            if _dedupe_w > 0:
                                if not hasattr(stats, "_shadow_dedupe_last"):
                                    stats._shadow_dedupe_last = {}

                                _sid  = str(plan.get("sid", ""))
                                _sym  = str(plan.get("symbol", ""))
                                _side = str(plan.get("side", ""))
                                _key  = f"{_sid}|{_sym}|{_side}|{plan.get('entry')}|{plan.get('stop')}|{plan.get('tp')}|{plan.get('qty')}"

                                _now = _time.time()
                                _last = stats._shadow_dedupe_last.get(_key)

                                if (_last is not None) and ((_now - _last) < _dedupe_w):
                                    stats.shadow_reject += 1
                                    ev = make_event(level="WARN", kind="shadow_reject", payload={
                                        "sid": plan.get("sid"),
                                        "symbol": plan.get("symbol"),
                                        "side": plan.get("side"),
                                        "qty": plan.get("qty"),
                                        "entry": plan.get("entry"),
                                        "stop": plan.get("stop"),
                                        "tp": plan.get("tp"),
                                        "risk_usd": plan.get("risk_usd"),
                                        "rr": plan.get("rr"),
                                        "confidence": plan.get("confidence"),
                                        "reason": plan.get("reason"),
                                        "reasons": ["duplicate_plan"],
                                    })
                                    logger.warning(ev)
                                    continue

                                stats._shadow_dedupe_last[_key] = _now
                        except Exception:
                            pass
                        stats.shadow_accept += 1
                        ev = make_event(level="INFO", kind="shadow_accept", payload={


                            "sid": plan.sid,


                            "symbol": plan.symbol,


                            "side": plan.side,


                            "qty": plan.qty,


                            "entry": plan.entry,


                            "stop": plan.stop,


                            "tp": plan.tp,


                            "risk_usd": plan.risk_usd,


                            "per_share_risk": plan.per_share_risk,


                            "rr": round(plan.rr, 4),


                            "confidence": plan.confidence,


                            "reason": plan.reason,


                        })


                        meta.emit(ev); announce.emit(ev)





                        from tbot.runtime.shadow_pricing import price_shadow_plan
                        plan = price_shadow_plan(plan)
                        shadow_writer.append(plan)

                        ev = make_event(level="INFO", kind="shadow_plan", payload={


                            "sid": plan.sid,


                            "symbol": plan.symbol,


                            "side": plan.side,


                            "qty": plan.qty,


                            "entry": plan.entry,


                            "stop": plan.stop,


                            "tp": plan.tp,


                            "risk_usd": plan.risk_usd,


                            "per_share_risk": plan.per_share_risk,


                            "rr": round(plan.rr, 4),


                            "confidence": plan.confidence,


                            "reason": plan.reason,


                            "path": shadow_path,


                        })


                        meta.emit(ev); announce.emit(ev)





        # Simulated trade wiring (kept for testing only)


        if sim_trade and (not opened) and i == 0:


            opened = True


            payload = {


                "symbol": sim_symbol,


                "sid": sim_sid,


                "side": sim_side,


                "qty": sim_qty,


                "entry": sim_entry,


                "stop": sim_stop,


                "tp": sim_tp,


                "exit": None,


                "r": None,


                "reason": "sim_open",


            }


            ev = make_event(level="INFO", kind="trade_open", payload=payload)


            meta.emit(ev); announce.emit(ev)





            tr = make_trade_record(


                event="OPEN",


                env=env,


                symbol=sim_symbol,


                sid=sim_sid,


                side=sim_side,


                qty=sim_qty,


                entry=sim_entry,


                stop=sim_stop,


                tp=sim_tp,


                exit=None,


                r=None,


                reason="sim_open",


            )


            ledger.append(tr)


            st.active = f"{sim_sid}:{sim_symbol}"





        if sim_trade and opened and i == (iterations - 1):


            denom = abs(sim_entry - sim_stop) if abs(sim_entry - sim_stop) > 0 else 1.0


            r_val = (sim_exit - sim_entry) / denom


            if sim_side.upper() == "SHORT":


                r_val = (sim_entry - sim_exit) / denom





            payload = {


                "symbol": sim_symbol,


                "sid": sim_sid,


                "side": sim_side,


                "qty": sim_qty,


                "entry": sim_entry,


                "stop": sim_stop,


                "tp": sim_tp,


                "exit": sim_exit,


                "r": round(float(r_val), 4),


                "reason": "sim_close",


            }


            ev = make_event(level="INFO", kind="trade_close", payload=payload)


            meta.emit(ev); announce.emit(ev)





            tr = make_trade_record(


                event="CLOSE",


                env=env,


                symbol=sim_symbol,


                sid=sim_sid,


                side=sim_side,


                qty=sim_qty,


                entry=sim_entry,


                stop=sim_stop,


                tp=sim_tp,


                exit=sim_exit,


                r=float(r_val),


                reason="sim_close",


            )


            ledger.append(tr)


            st.active = None





        heartbeat = {


            "i": i,


            "now": now.strftime("%Y-%m-%d %H:%M:%S"),


            "in_session": st.in_session,


            "pre_close": st.pre_close,


            "alpha_kill": st.alpha_kill,


            "portfolio_kill": st.portfolio_kill,


            "pending": st.pending,


            "active": st.active,


            "daily_r": st.daily_r,


            "week_r": st.week_r,


        }


        ev = make_event(level="INFO", kind="heartbeat", payload=heartbeat)


        meta.emit(ev); announce.emit(ev)





        # ORCH_STAGE2_IDLE_BRIDGE_MIN_v2 (observability only)


        # SESSION_DEBUG


        try:


            if not getattr(state, 'in_session', False):


                logger.info('SESSION_DEBUG %s', _session_debug_dump(state))


        except Exception:


            pass


        # ORCH_STAGE4_HEARTBEAT_BRIDGE_MIN_v2 (observability only)


        try:


            if bridge is not None:


                bridge.emit_stage2_idle(in_session=st.in_session, pre_close=st.pre_close)


                if hasattr(bridge, 'emit_stage4_heartbeat'):


                    try:


                        bridge.emit_stage4_heartbeat(in_session=st.in_session, pre_close=st.pre_close, loop_i=i)


                    except TypeError:


                        bridge.emit_stage4_heartbeat(in_session=st.in_session, pre_close=st.pre_close)


        except Exception:


            pass





        # ORCH_STAGE2_IDLE_BRIDGE_MIN_v2 (observability only)


        # ORCH_STAGE4_HEARTBEAT_BRIDGE_MIN_v2 (observability only)


        try:


            if bridge is not None:


                bridge.emit_stage2_idle(in_session=st.in_session, pre_close=st.pre_close)


                if hasattr(bridge, 'emit_stage4_heartbeat'):


                    bridge.emit_stage4_heartbeat(in_session=st.in_session, pre_close=st.pre_close)


        except Exception:


            pass








        # ORCH_STAGE2_IDLE_BRIDGE_v3 (observability only)


        try:


            if bridge is not None:


                bridge.emit_stage2_idle(in_session=st.in_session, pre_close=st.pre_close)


        except Exception:


            pass





        # periodic metrics (anti-spam: once per ~30 seconds)


        try:


            now_epoch = time.time()


            if (now_epoch - last_metrics_emit) >= 30.0:


                last_metrics_emit = now_epoch


                ev = make_event(level="INFO", kind="metrics", payload={


                    "loop_i": int(i),


                    "stats": {


                        "iterations": int(stats.iterations),


                        "signal_fire": int(stats.signal_fire),


                        "signal_skip": int(stats.signal_skip),


                        "shadow_accept": int(stats.shadow_accept),


                        "shadow_reject": int(stats.shadow_reject),


                    },


                    "top_reasons": top_reasons(stats.reasons, n=8),


                    "proc": get_process_metrics(),


                })


                meta.emit(ev); announce.emit(ev)


        except Exception:


            pass
        # HEARTBEAT_FILE_V1 (observability)
        # Writes: <runroot>\state\heartbeat.json and <runroot>\state\pid.txt
        try:
            import os, json, tempfile
            from pathlib import Path as _P

            runroot = None
            # HB_FORCE_RUNROOT_ENV_V1 (ops)
            try:
                _rr_env = (os.getenv("TBOT_RUNROOT") or os.getenv("TBOT_RUNTIME") or "").strip()
                if _rr_env:
                    runroot = _P(_rr_env).resolve()
            except Exception:
                pass
            # ENV-first runroot (stable + auditable)
            _rr = (os.getenv("TBOT_RUNROOT") or os.getenv("TBOT_RUNTIME") or "").strip()
            if _rr:
                runroot = _P(_rr).resolve()
            else:
                mp = getattr(self, "meta_path", None) or getattr(self, "meta", None)
            if mp:
                p = _P(str(mp)).resolve()
                # expect ...\runroot\logs\meta.jsonl
                if p.parent.name.lower() == "logs" and p.name.lower().startswith("meta") and p.name.lower().endswith(".jsonl"):
                    runroot = p.parent.parent
                else:
                    # fallback: if ...\logs\something then parent of logs; else parent
                    runroot = p.parent.parent if p.parent.name.lower() == "logs" else p.parent

            if runroot is not None:
                state_dir = _P(runroot) / "state"
                state_dir.mkdir(parents=True, exist_ok=True)

                hb_path = state_dir / "heartbeat.json"

                # HB_WRITE_AUDIT_V1 (ops)
                try:
                    if int(i) % 10 == 0:
                        meta.emit({
                            "ts": __import__("datetime").datetime.utcnow().isoformat(timespec="seconds") + "Z",
                            "level": "INFO",
                            "kind": "hb_write_audit_pre",
                            "payload": {
                                "env_TBOT_RUNROOT": (os.getenv("TBOT_RUNROOT") or ""),
                                "env_TBOT_RUNTIME": (os.getenv("TBOT_RUNTIME") or ""),
                                "resolved_runroot": str(runroot) if runroot is not None else None,
                                "state_dir": str(state_dir),
                                "hb_path": str(hb_path),
                                "state_dir_exists": state_dir.exists(),
                            }
                        })
                except Exception:
                    pass                # HB_PATH_AUDIT_TO_META_V1 (ops)
                try:
                    if int(i) % 60 == 0:
                        meta.emit({
                            "ts": __import__("datetime").datetime.utcnow().isoformat(timespec="seconds") + "Z",
                            "level": "INFO",
                            "kind": "hb_path_audit",
                            "payload": {
                                "env_TBOT_RUNROOT": (os.getenv("TBOT_RUNROOT") or ""),
                                "env_TBOT_RUNTIME": (os.getenv("TBOT_RUNTIME") or ""),
                                "resolved_runroot": str(runroot) if runroot is not None else None,
                                "state_dir": str(state_dir),
                                "hb_path": str(hb_path),
                            }
                        })
                except Exception:
                    pass
                # HB_PATH_AUDIT_V1 (ops)
                try:
                    _rr = str(runroot)
                    _ops = _P(_rr) / "logs" / "ops"
                    _ops.mkdir(parents=True, exist_ok=True)
                    (_ops / "HB_PATH_AUDIT.log").write_text(
                        f"ts={payload.get('ts_utc')} pid={payload.get('pid')} runroot={_rr} hb_path={hb_path}\n",
                        encoding="utf-8",
                        errors="ignore",
                    )
                except Exception:
                    pass
                pid_path = state_dir / "pid.txt"

                payload = {
                    "ts_utc": __import__("datetime").datetime.utcnow().isoformat(timespec="seconds") + "Z",
                    "pid": os.getpid(),
                    "loop_i": int(i) if isinstance(i, int) or str(i).isdigit() else i,
                    "in_session": bool(getattr(st, "in_session", False)),
                    "pre_close": bool(getattr(st, "pre_close", False)),
                    "alpha_kill": bool(getattr(st, "alpha_kill", False)),
                    "portfolio_kill": bool(getattr(st, "portfolio_kill", False)),
                    "daily_r": float(getattr(st, "daily_r", 0.0) or 0.0),
                    "week_r": float(getattr(st, "week_r", 0.0) or 0.0),
                }

                tmp = None
                try:
                    fd, tmp = tempfile.mkstemp(prefix="heartbeat_", suffix=".json", dir=str(state_dir))
                    with os.fdopen(fd, "w", encoding="utf-8") as f:
                        json.dump(payload, f)
                    os.replace(tmp, str(hb_path))
                finally:
                    try:
                        if tmp and os.path.exists(tmp):
                            os.remove(tmp)
                    except Exception as _e:
                        pass
            try:
                # Best-effort: persist error for ops
                _rr = (os.getenv("TBOT_RUNROOT") or os.getenv("TBOT_RUNTIME") or "").strip()
                if _rr:
                    _sd = _P(_rr) / "state"
                    _sd.mkdir(parents=True, exist_ok=True)
                    (_sd / "heartbeat_err.txt").write_text(repr(_e), encoding="utf-8")
            except Exception:
                pass
                try:
                    pid_path.write_text(str(os.getpid()), encoding="utf-8")
                except Exception:
                    pass
        except Exception:
            pass





        time.sleep(sleep_sec)





    # QA summary + archive (no effect on trading)


    try:


        qa = {


            "ok": True,


            "duration_sec": round(float(stats.duration_sec()), 3),


            "stats": {


                "iterations": int(stats.iterations),


                "signal_fire": int(stats.signal_fire),


                "signal_skip": int(stats.signal_skip),


                "shadow_accept": int(stats.shadow_accept),


                "shadow_reject": int(stats.shadow_reject),


            },


            "top_reasons": top_reasons(stats.reasons, n=12),


        }


        ev = make_event(level="INFO", kind="qa_summary", payload=qa)


        meta.emit(ev); announce.emit(ev)


    except Exception:


        pass





    try:


        # archive to logs/archive/<run_id>/


        rid = getattr(ev, "run_id", "") or ""


        archive_dir = archive_run_outputs(


            run_id=rid,


            meta_path=getattr(meta, "path", ""),


            announce_path=getattr(announce, "path", ""),


            shadow_path=(shadow_path if shadow_enabled else None),


            ledger_dir=getattr(ledger, "base_dir", None),


        )


        if archive_dir:


            ev2 = make_event(level="INFO", kind="qa_summary", payload={"archive_dir": archive_dir})


            meta.emit(ev2); announce.emit(ev2)


    except Exception:


        pass





    ev = make_event(level="INFO", kind="shutdown", payload={"ok": True, "final_state": asdict(st)})


    meta.emit(ev); announce.emit(ev)


    return 0




























































# --- FAILSAFE_EXIT_AUDIT_V1 BEGIN ---
# Write any uncaught exception / SystemExit reason into <RUNROOT>\logs\ops\EXIT_AUDIT_*.txt
try:
    import os as _ea_os, sys as _ea_sys, time as _ea_time, traceback as _ea_tb
    from pathlib import Path as _ea_P
    def _ea_runroot():
        rr = (_ea_os.getenv("TBOT_RUNROOT") or _ea_os.getenv("TBOT_RUNTIME") or "").strip()
        return rr
    def _ea_write(tag: str, msg: str) -> None:
        try:
            rr=_ea_runroot()
            if not rr:
                return
            ops=_ea_P(rr)/"logs"/"ops"
            ops.mkdir(parents=True, exist_ok=True)
            fn=ops/f"EXIT_AUDIT_{tag}_{int(_ea_time.time())}.txt"
            fn.write_text(msg, encoding="utf-8")
        except Exception:
            pass

    _orig_hook = _ea_sys.excepthook
    def _hook(exctype, value, tb):
        _ea_write("EXC", "EXCEPTION\\nargv="+str(_ea_sys.argv)+"\\n\\n"+ "".join(_ea_tb.format_exception(exctype, value, tb)))
        _orig_hook(exctype, value, tb)
    _ea_sys.excepthook = _hook

    _orig_exit = _ea_sys.exit
    def _exit(code=0):
        try:
            _ea_write("EXIT", "SYS_EXIT\\nargv="+str(_ea_sys.argv)+"\\ncode="+repr(code)+"\\n")
        except Exception:
            pass
        return _orig_exit(code)
    _ea_sys.exit = _exit
except Exception:
    pass
# --- FAILSAFE_EXIT_AUDIT_V1 END ---
# --- DEBUG_SPAWN_HOOK_V1 BEGIN ---
# If TBOT_DEBUG_SPAWN=1, log every multiprocessing.Process.start() call with stack trace.
try:
    import os as _ds_os
    if _ds_os.getenv("TBOT_DEBUG_SPAWN") == "1":
        import multiprocessing as _ds_mp
        import traceback as _ds_tb
        import time as _ds_time
        import pathlib as _ds_pl

        _orig_start = _ds_mp.Process.start

        def _start_wrapped(self, *a, **k):
            try:
                rr = (_ds_os.getenv("TBOT_RUNROOT") or "").strip()
                if rr:
                    p = _ds_pl.Path(rr) / "state" / "locks"
                    p.mkdir(parents=True, exist_ok=True)
                    fn = p / f"SPAWN_TRACE_{int(_ds_time.time())}.txt"
                    fn.write_text("".join(_ds_tb.format_stack(limit=80)), encoding="utf-8")
            except Exception:
                pass
            return _orig_start(self, *a, **k)

        _ds_mp.Process.start = _start_wrapped
except Exception:
    pass
# --- DEBUG_SPAWN_HOOK_V1 END ---


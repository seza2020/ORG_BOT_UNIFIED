from tbot.runtime.market_provider import build_market_snapshot



import os
from tbot.market.market_provider import build_market_snapshot



import os
def _snap_get(market, symbol: str):


    """


    Market snapshot adapter:


      - if market is dict: _snap_get(market, symbol)


      - if market is object: getattr(market, symbol, None)


    """


    if market is None:


        return None


    if isinstance(market, dict):


        return _snap_get(market, symbol)


    return getattr(market, symbol, None)








# ORCH_MARKET_FILL_ALPACA_v1


# Safe, dependency-free Alpaca Data fetch to populate MarketSnap when provider returns Nones.


# Reads keys from env: APCA_API_KEY_ID/APCA_API_SECRET_KEY or ALPACA_API_KEY/ALPACA_API_SECRET_KEY


# Optional env: TBOT_ALPACA_DATA_FEED (default: iex), TBOT_ALPACA_TIMEOUT_SEC (default: 3)


def _alpaca_headers():


    kid = (os.environ.get("APCA_API_KEY_ID") or os.environ.get("ALPACA_API_KEY") or "").strip()


    sec = (os.environ.get("APCA_API_SECRET_KEY") or os.environ.get("ALPACA_API_SECRET_KEY") or "").strip()


    if not kid or not sec:


        return None


    return {


        "APCA-API-KEY-ID": kid,


        "APCA-API-SECRET-KEY": sec,


        "Accept": "application/json",


        "User-Agent": "tbot-market-fill/1.0",


    }





def _http_get_json(url: str, headers: dict, timeout: float):


    import json


    from urllib.request import Request, urlopen


    req = Request(url, headers=headers, method="GET")


    with urlopen(req, timeout=timeout) as r:


        raw = r.read().decode("utf-8", errors="replace")


    return json.loads(raw)





def _ema(vals, span: int):


    # vals: list[float]


    if not vals:


        return None


    alpha = 2.0 / (span + 1.0)


    e = vals[0]


    for x in vals[1:]:


        e = alpha * x + (1.0 - alpha) * e


    return e





def _fill_market_from_alpaca_if_needed(market: dict):


    try:


        if not isinstance(market, dict) or not market:


            return


        # If already populated, do nothing


        if any(getattr(v, "last", None) is not None for v in market.values()):


            return





        headers = _alpaca_headers()


        if headers is None:


            return





        feed = (os.environ.get("TBOT_ALPACA_DATA_FEED") or "iex").strip()


        timeout = float((os.environ.get("TBOT_ALPACA_TIMEOUT_SEC") or "3").strip())





        # Pull enough bars to compute EMA


        for sym, snap in market.items():


            try:


                # latest trade -> last


                url_t = f"https://data.alpaca.markets/v2/stocks/{sym}/trades/latest?feed={feed}"


                jt = _http_get_json(url_t, headers=headers, timeout=timeout)


                last = None


                if isinstance(jt, dict):


                    tr = jt.get("trade") or jt.get("trades")


                    if isinstance(tr, dict):


                        last = tr.get("p") or tr.get("price")


                if last is not None:


                    try: snap.last = float(last)


                    except Exception: pass





                # recent bars -> vwap + ema


                url_b = f"https://data.alpaca.markets/v2/stocks/{sym}/bars?timeframe=1Min&limit=80&feed={feed}"


                jb = _http_get_json(url_b, headers=headers, timeout=timeout)


                bars = []


                if isinstance(jb, dict):


                    bars = jb.get("bars") or []


                closes = []


                vwaps = []


                if isinstance(bars, list):


                    for b in bars:


                        if not isinstance(b, dict):


                            continue


                        c = b.get("c")


                        vw = b.get("vw")


                        if c is not None:


                            try: closes.append(float(c))


                            except Exception: pass


                        if vw is not None:


                            try: vwaps.append(float(vw))


                            except Exception: pass





                if vwaps:


                    try: snap.vwap = float(vwaps[-1])


                    except Exception: pass


                elif closes:


                    try: snap.vwap = float(closes[-1])


                    except Exception: pass





                if closes:


                    ef = _ema(closes, 9)


                    es = _ema(closes, 21)


                    if ef is not None:


                        try: snap.ema_fast = float(ef)


                        except Exception: pass


                    if es is not None:


                        try: snap.ema_slow = float(es)


                        except Exception: pass





            except Exception:


                # never crash run_loop because of market fill


                continue


    except Exception:


        return






$ErrorActionPreference="Stop"

# --- Canonical roots (single source of truth) ---
$ROOT    = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$CODE    = Join-Path $ROOT "code"
$RUNROOT = Join-Path $ROOT "runtime\paper"
$LOGDIR  = Join-Path $RUNROOT "logs"
$OPSLOG  = Join-Path $LOGDIR "ops"

New-Item -ItemType Directory -Force -Path $OPSLOG | Out-Null

# --- Env hard bind (no legacy writes) ---
Set-Location $CODE
$env:PYTHONPATH    = $CODE
$env:TBOT_ROOT     = $ROOT
$env:TBOT_CODE     = $CODE
$env:TBOT_RUNROOT  = $RUNROOT
$env:TBOT_LOG_ROOT = $LOGDIR
$env:TBOT_OPS_LOG  = $OPSLOG

# --- Daily append logs (no log explosion) ---
$day = Get-Date -Format "yyyyMMdd"
$OUT = Join-Path $OPSLOG ("PAPER_EXEC_OUT_{0}.txt" -f $day)
$ERR = Join-Path $OPSLOG ("PAPER_EXEC_ERR_{0}.txt" -f $day)

function WL([string]$s){
  $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
  ("[{0}] {1}" -f $ts, $s) | Add-Content -LiteralPath $OUT -Encoding utf8
}

WL "EXECUTOR_TASK_START"
WL ("CWD=" + (Get-Location))
WL ("RUNROOT=" + $RUNROOT)

# --- Target script ---
$target = Join-Path $ROOT "code\tools\paper\EXECUTE_PLAN_SELECTION_PAPER_V2.ps1"
if(!(Test-Path -LiteralPath $target)){ throw "MISSING_TARGET=$target" }

# --- Run args (dry-run safe defaults) ---
$args = @(
  "-NoProfile","-ExecutionPolicy","Bypass",
  "-File", $target,
  "-ProjectRoot", $ROOT,
  "-RunRoot", $RUNROOT,
  "-MaxOrdersPerDay", "1",
  "-MaxOrdersPerRun", "1",
  "-DefaultQty", "1",
  "-DryRun", "1"
)

# --- Process execution with timeout ---
$timeoutSec = 25
WL ("LAUNCH pwsh target timeoutSec=" + $timeoutSec)

$p = Start-Process -FilePath "C:\Program Files\PowerShell\7\pwsh.exe" 
      -ArgumentList $args 
      -NoNewWindow 
      -PassThru 
      -RedirectStandardOutput $OUT 
      -RedirectStandardError  $ERR

$ok = $p.WaitForExit($timeoutSec * 1000)

if(-not $ok){
  WL "EXECUTOR_TIMEOUT -> terminating child"
  try{ Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue } catch {}
  "EXECUTOR_TIMEOUT pid=$($p.Id) timeoutSec=$timeoutSec" | Add-Content -LiteralPath $ERR -Encoding utf8
  exit 124
}

WL ("CHILD_EXITCODE=" + $p.ExitCode)
exit $p.ExitCode

from __future__ import annotations

import os
import sys
import json
import time
import hashlib
import atexit

_EXIT_CODE = 86

def _log(msg: str) -> None:
    try:
        sys.stderr.write(msg.rstrip() + "\n")
        sys.stderr.flush()
    except Exception:
        pass

def _is_pid_alive_windows(pid: int) -> bool:
    # No subprocess usage (avoid spawning). Use WinAPI.
    try:
        import ctypes
        from ctypes import wintypes
        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        OpenProcess = kernel32.OpenProcess
        OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        OpenProcess.restype = wintypes.HANDLE

        CloseHandle = kernel32.CloseHandle
        CloseHandle.argtypes = [wintypes.HANDLE]
        CloseHandle.restype = wintypes.BOOL

        h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, int(pid))
        if not h:
            return False
        try:
            return True
        finally:
            CloseHandle(h)
    except Exception:
        return False

def _safe_mutex_name(profile: str, runroot: str) -> str:
    # IMPORTANT: Never embed full paths (":", "\") into mutex name.
    # Build a short safe hash.
    p = (profile or "UNKNOWN").upper().strip()
    rr = (runroot or "").lower().strip()
    h = hashlib.sha1((p + "|" + rr).encode("utf-8")).hexdigest()[:16]
    # Only [A-Za-z0-9_]
    return f"Local\\TBOT_ORG_UNIFIED_{p}_{h}"

def _try_mutex(profile: str, runroot: str) -> bool:
    """
    Returns True if mutex acquired OR mutex unsupported (fail-open).
    Returns False only when mutex indicates another instance exists.
    """
    try:
        import ctypes
        from ctypes import wintypes

        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        CreateMutexW = kernel32.CreateMutexW
        CreateMutexW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.LPCWSTR]
        CreateMutexW.restype = wintypes.HANDLE

        GetLastError = kernel32.GetLastError
        GetLastError.argtypes = []
        GetLastError.restype = wintypes.DWORD

        name = _safe_mutex_name(profile, runroot)
        h = CreateMutexW(None, False, name)
        if not h:
            err = ctypes.get_last_error()
            _log(f"[SINGLE_INSTANCE] CreateMutexW failed err={err} name={name} -> allow")
            return True  # fail-open

        # If already exists => another instance
        ERROR_ALREADY_EXISTS = 183
        err = GetLastError()
        if int(err) == ERROR_ALREADY_EXISTS:
            _log(f"[SINGLE_INSTANCE] MUTEX_EXISTS name={name} -> exit {_EXIT_CODE}")
            return False

        _log(f"[SINGLE_INSTANCE] MUTEX_ACQUIRED name={name}")
        return True
    except Exception as e:
        _log(f"[SINGLE_INSTANCE] MUTEX_EXCEPTION -> allow ({type(e).__name__}: {e})")
        return True  # fail-open

def _lock_path(runroot: str, profile: str) -> str:
    lockdir = os.path.join(runroot, "state", "locks")
    os.makedirs(lockdir, exist_ok=True)
    p = (profile or "UNKNOWN").upper().strip()
    return os.path.join(lockdir, f"TBOT_SINGLE_INSTANCE_{p}.lock")

def _acquire_file_lock(lockpath: str) -> None:
    pid = os.getpid()
    ppid = os.getppid()

    def write_lock(fd: int) -> None:
        payload = {"pid": pid, "ppid": ppid, "ts": time.time(), "argv": sys.argv}
        os.write(fd, json.dumps(payload).encode("utf-8"))

    try:
        fd = os.open(lockpath, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
    except FileExistsError:
        owner = "UNREADABLE"
        try:
            with open(lockpath, "r", encoding="utf-8") as f:
                owner = f.read().strip()
        except Exception:
            pass

        # Try stale cleanup (one shot)
        stale = False
        try:
            j = json.loads(owner) if owner else {}
            opid = int(j.get("pid", -1))
            if opid > 0 and not _is_pid_alive_windows(opid):
                stale = True
        except Exception:
            # If malformed owner, do not delete automatically
            stale = False

        if stale:
            try:
                os.remove(lockpath)
            except Exception:
                pass
            # retry once
            fd = os.open(lockpath, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            write_lock(fd)
            os.close(fd)
            _log(f"[SINGLE_INSTANCE] FILE_LOCK_ACQUIRED_AFTER_STALE path={lockpath}")
            return

        _log(f"[SINGLE_INSTANCE] FILE_LOCK_EXISTS path={lockpath} owner={owner} -> exit {_EXIT_CODE}")
        raise SystemExit(_EXIT_CODE)

    write_lock(fd)
    os.close(fd)
    _log(f"[SINGLE_INSTANCE] FILE_LOCK_ACQUIRED path={lockpath}")

    def _cleanup() -> None:
        try:
            with open(lockpath, "r", encoding="utf-8") as f:
                cur = f.read()
            if f'"pid": {pid}' not in cur:
                return
            os.remove(lockpath)
        except Exception:
            pass
    atexit.register(_cleanup)

def enforce_single_instance(profile: str = "PAPER", runroot: str | None = None) -> None:
    # 1) Block multiprocessing "spawn" child processes (root cause of dual PID in Windows)
    try:
        import multiprocessing as _mp
        if _mp.current_process().name != "MainProcess":
            _log(f"[SINGLE_INSTANCE] NON_MAIN_PROCESS name={_mp.current_process().name} pid={os.getpid()} -> exit {_EXIT_CODE}")
            raise SystemExit(_EXIT_CODE)
    except SystemExit:
        raise
    except Exception:
        pass

    # 2) Resolve runroot from env
    rr = runroot or os.environ.get("TBOT_RUNROOT") or os.environ.get("TBOT_RUNROOT".lower())
    if not rr:
        # Fail-safe: without runroot we cannot enforce file lock; better exit than run uncontrolled
        _log("[SINGLE_INSTANCE] TBOT_RUNROOT missing -> exit 90")
        raise SystemExit(90)

    # 3) Mutex (auxiliary, fail-open)
    if not _try_mutex(profile, rr):
        raise SystemExit(_EXIT_CODE)

    # 4) File lock (primary enforcement)
    lp = _lock_path(rr, profile)
    _acquire_file_lock(lp)

import os, json, time, uuid

def _today():
    return time.strftime("%Y-%m-%d")

def _lock_acquire(lock_path, timeout_sec=5.0, poll=0.05):
    t0 = time.time()
    while True:
        try:
            fd = os.open(lock_path, os.O_CREAT | os.O_EXCL | os.O_RDWR)
            os.write(fd, str(os.getpid()).encode("utf-8", "ignore"))
            return fd
        except FileExistsError:
            if time.time() - t0 >= timeout_sec:
                raise TimeoutError(f"LOCK_TIMEOUT:{lock_path}")
            time.sleep(poll)

def _lock_release(fd, lock_path):
    try:
        os.close(fd)
    finally:
        try:
            os.remove(lock_path)
        except Exception:
            pass

def _atomic_write_json(path, obj):
    tmp = path + ".tmp." + uuid.uuid4().hex
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)

def _load_or_init(ledger_path, max_day_risk_default=500.0):
    if not os.path.exists(ledger_path):
        obj = {
            "date": _today(),
            "max_day_risk": float(max_day_risk_default),
            "used_risk": 0.0,
            "reserved_risk": 0.0,
            "trades": []
        }
        _atomic_write_json(ledger_path, obj)
        return obj
    with open(ledger_path, "r", encoding="utf-8") as f:
        return json.load(f)

def _resolve_ledger_path(runroot):
    # expects Stage1 layout:
    # <runroot>\state\risk\risk_ledger.json
    return os.path.join(runroot, "state", "risk", "risk_ledger.json")

def charge_preaccept(runroot, risk_usd, sid=None, symbol=None, meta=None):
    """
    Hard enforcement: charge risk BEFORE accept is emitted.
    Conservative by design (used_risk is incremented immediately).
    Returns: (ok:bool, reason:str|None, snapshot:dict)
    """
    if runroot is None:
        return (False, "RISK_LEDGER_NO_RUNROOT", None)

    try:
        r = float(risk_usd)
    except Exception:
        return (False, "RISK_MISSING_OR_INVALID", None)

    if r <= 0:
        return (False, "RISK_NONPOSITIVE", None)

    ledger_path = _resolve_ledger_path(runroot)
    lock_path = ledger_path + ".lock"

    fd = _lock_acquire(lock_path, timeout_sec=5.0)
    try:
        led = _load_or_init(ledger_path)
        # day rollover
        if str(led.get("date")) != _today():
            led["date"] = _today()
            led["used_risk"] = 0.0
            led["reserved_risk"] = 0.0
            led["trades"] = []

        max_day = float(led.get("max_day_risk", 0.0))
        used = float(led.get("used_risk", 0.0))
        if used + r > max_day + 1e-9:
            return (False, "DAILY_RISK_CAP_REJECT", {"date": led.get("date"), "max_day_risk": max_day, "used_risk": used})

        led["used_risk"] = used + r
        led.setdefault("trades", []).append({
            "ts": time.time(),
            "sid": sid,
            "symbol": symbol,
            "risk_usd": r,
            "kind": "preaccept_charge"
        })
        _atomic_write_json(ledger_path, led)
        snap = {"date": led.get("date"), "max_day_risk": max_day, "used_risk": float(led.get("used_risk", 0.0))}
        return (True, None, snap)
    finally:
        _lock_release(fd, lock_path)

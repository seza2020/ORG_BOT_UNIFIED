$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$U        = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$OPS      = Join-Path $U "ops"
$CODE     = Join-Path $U "code"
$RUNTIME  = Join-Path $U "runtime\paper"
$LOGS     = Join-Path $RUNTIME "logs"
$SECDIR   = Join-Path $OPS "secrets"
$TASKDIR  = Join-Path $OPS "tasks"
$PYTHON   = Join-Path $CODE ".venv\Scripts\python.exe"

if (!(Test-Path -LiteralPath $CODE))    { throw "CODE_ROOT_NOT_FOUND=$CODE" }
if (!(Test-Path -LiteralPath $RUNTIME)) { throw "RUNTIME_ROOT_NOT_FOUND=$RUNTIME" }
if (!(Test-Path -LiteralPath $LOGS))    { New-Item -ItemType Directory -Force -Path $LOGS | Out-Null }
if (!(Test-Path -LiteralPath $PYTHON))  { throw "CANONICAL_PYTHON_NOT_FOUND=$PYTHON" }

$loaderLog = Join-Path $LOGS "canonical_loader_wrapper_v1.jsonl"

function Write-LoaderLog {
  param(
    [string]$Kind,
    [hashtable]$Payload
  )
  try {
    $obj = [ordered]@{
      ts      = (Get-Date).ToString("o")
      kind    = $Kind
      payload = $Payload
    }
    ($obj | ConvertTo-Json -Depth 8 -Compress) | Add-Content -LiteralPath $loaderLog -Encoding UTF8
  } catch {}
}

function Invoke-BestEffortScript {
  param([string]$Path)

  if (!(Test-Path -LiteralPath $Path)) {
    Write-LoaderLog -Kind "loader_candidate_missing" -Payload @{ path = $Path }
    return
  }

  try {
    Write-LoaderLog -Kind "loader_candidate_invoking" -Payload @{ path = $Path }
    & $Path
    $ec = $LASTEXITCODE
    Write-LoaderLog -Kind "loader_candidate_completed" -Payload @{ path = $Path; exit_code = $ec }
  } catch {
    Write-LoaderLog -Kind "loader_candidate_exception" -Payload @{ path = $Path; error = $_.Exception.Message }
  }
}

Write-LoaderLog -Kind "wrapper_start" -Payload @{
  whoami       = "$env:USERNAME"
  computer     = "$env:COMPUTERNAME"
  userprofile  = "$env:USERPROFILE"
}

Set-Location $CODE
$env:PYTHONPATH   = $CODE
$env:TBOT_RUNROOT = $RUNTIME

Write-LoaderLog -Kind "context_set" -Payload @{
  cwd          = (Get-Location).Path
  python       = $PYTHON
  pythonpath   = $env:PYTHONPATH
  tbot_runroot = $env:TBOT_RUNROOT
}

# -------------------------------
# BEST-EFFORT LOADER CANDIDATES
# -------------------------------
$loaderCandidates = @(
  (Join-Path $SECDIR "secrets_ps1.ps1"),
  (Join-Path $SECDIR "loader.ps1"),
  (Join-Path $SECDIR "vault_loader.ps1"),
  (Join-Path $SECDIR "profile_loader.ps1"),
  (Join-Path $SECDIR "bootstrap_loader.ps1"),
  (Join-Path $TASKDIR "TBOT_SUPERVISOR_RUNNER.ps1"),
  (Join-Path $TASKDIR "TBOT_SUPERVISOR_DAEMON_PAPER_V3.ps1")
)

foreach ($cand in $loaderCandidates) {
  Invoke-BestEffortScript -Path $cand
}

Write-LoaderLog -Kind "prelaunch_env_snapshot" -Payload @{
  cwd          = (Get-Location).Path
  python       = $PYTHON
  pythonpath   = $env:PYTHONPATH
  tbot_runroot = $env:TBOT_RUNROOT
  path         = $env:PATH
}

& $PYTHON -m tbot.main --run

$exitCode = $LASTEXITCODE
Write-LoaderLog -Kind "python_exit" -Payload @{
  exit_code = $exitCode
}

exit $exitCode

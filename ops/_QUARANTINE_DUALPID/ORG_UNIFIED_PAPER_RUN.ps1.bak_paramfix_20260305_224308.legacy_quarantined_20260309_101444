# ---- single runtime guard ----
$running = Get-CimInstance Win32_Process |
Where-Object {
  $_.Name -eq "python.exe" -and
  $_.CommandLine -match "tbot\.main"
}

if($running){
  Write-Host "TBOT_ALREADY_RUNNING_EXIT_WRAPPER"
  exit 0
}
# -------------------------------
param()

$ErrorActionPreference = "Stop"
Set-StrictMode -Version Latest

$root = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$mgr  = Join-Path $root "ops\task_wrappers\ORG_UNIFIED_RUNTIME_MANAGER.ps1"

Write-Host ("SHIM_MANAGER_PATH=" + $mgr)
Write-Host ("SHIM_MANAGER_EXISTS=" + (Test-Path -LiteralPath $mgr))

if(!(Test-Path -LiteralPath $mgr)){
    throw "RUNTIME_MANAGER_NOT_FOUND=$mgr"
}

& $mgr -Profile PAPER -UnifiedRoot $root
exit $LASTEXITCODE


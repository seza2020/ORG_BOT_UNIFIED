$ErrorActionPreference="Stop"
$logDir="C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\logs\tasks"
New-Item -ItemType Directory -Force -Path $logDir | Out-Null
$log=Join-Path $logDir ("ORG_UNIFIED_SHADOW_RUN.log")

# --- ORG_UNIFIED_SHADOW_RUN_MUTEX (prevent queued/duplicate instances) ---
$mutexName = "Global\ORG_UNIFIED_SHADOW_RUN_MUTEX"
$mutex = New-Object System.Threading.Mutex($false, $mutexName)
$hasLock = $false
try {
  # Try immediate lock (0ms). If can't, exit cleanly.
  $hasLock = $mutex.WaitOne(0)
  if(-not $hasLock){
    $ts0 = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Add-Content -Encoding UTF8 -LiteralPath $log -Value ("[@{0}] SKIP duplicate run (mutex busy): {1}" -f $ts0, $mutexName)
    exit 0
  }
} catch { throw } finally {
  if($hasLock){
    try { $mutex.ReleaseMutex() } catch {}
  }
  try { $mutex.Dispose() } catch {}
}
.Exception.Message)
  exit 0
}
# --- /ORG_UNIFIED_SHADOW_RUN_MUTEX ---

$ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
Add-Content -Encoding UTF8 -LiteralPath $log -Value ("[@{0}] START ORG_UNIFIED_SHADOW_RUN profile=SHADOW" -f $ts)

try {
  & "C:\alpaca-bot\ORG_BOT_UNIFIED\ops\RUN_PROFILE.ps1" -Profile "SHADOW" 2>&1 |
    Tee-Object -FilePath $log -Append | Out-Null

  $ec = $LASTEXITCODE
  $ts2 = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
  Add-Content -Encoding UTF8 -LiteralPath $log -Value ("[@{0}] EXITCODE ORG_UNIFIED_SHADOW_RUN = {1}" -f $ts2, $ec)
  Add-Content -Encoding UTF8 -LiteralPath $log -Value ("[@{0}] DONE ORG_UNIFIED_SHADOW_RUN" -f $ts2)
  exit $ec
} catch { throw } finally {
  if($hasLock){
    try { $mutex.ReleaseMutex() } catch {}
  }
  try { $mutex.Dispose() } catch {}
}


# TBOT_SUPERVISOR_DAEMON_PAPER_V4.ps1
# Institutional Supervisor (V4.2): self-mutex + anti-storm + fast-exit detection.
# English-only strings/comments.

$ErrorActionPreference = "Stop"

# ---- Paths / runtime
$U       = "C:\alpaca-bot\ORG_BOT_UNIFIED"
$CODE    = "C:\alpaca-bot\ORG_BOT_UNIFIED\code"
$PY      = "C:\alpaca-bot\ORG_BOT_UNIFIED\code\.venv\Scripts\python.exe"
$RUNROOT = "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper"
$LOGS    = "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\logs"

$REG_PATH = "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\state\runtime_registry.json"
$REG_LOG  = Join-Path $LOGS "runtime_registry.log"

# ---- Single-instance for Supervisor itself (prevents overlap)
$SUPERV_MUTEX_NAME = "Global\ORG_BOT_UNIFIED_SUPERV_PAPER_V4"
Add-Type -AssemblyName System.Threading
$created = $false
$supMutex = New-Object System.Threading.Mutex($true, $SUPERV_MUTEX_NAME, [ref]$created)
if(-not $created){
  "$(Get-Date -Format o)	SUPERV_BLOCK: another supervisor instance is running => exit" | Out-File -FilePath $REG_LOG -Append -Encoding utf8
  exit 0
}

# ---- Spawn policy (anti-storm)
$LOOP_SEC = 15
$SPAWN_MIN_INTERVAL_SEC = 60
$FAST_EXIT_WINDOW_SEC = 3
$FAST_EXIT_MAX = 3
$BACKOFF_SEC = 600  # 10 minutes

$lastSpawnUtc = [DateTime]::MinValue
$fastExitCount = 0
$backoffUntil = [DateTime]::MinValue

$TBOT_ARGS = @("-m","tbot.main","--run")

function LogLine([string]$msg){
  $ts = (Get-Date).ToUniversalTime().ToString("o")
  "$ts	$msg" | Out-File -FilePath $REG_LOG -Append -Encoding utf8
}

function LoadRegistry(){
  if(Test-Path $REG_PATH){
    try { return (Get-Content -LiteralPath $REG_PATH -Raw -Encoding utf8 | ConvertFrom-Json) } catch { return $null }
  }
  return $null
}

function SaveRegistry([object]$r){
  try {
    $r.last_action_utc = (Get-Date).ToUniversalTime().ToString("o")
    ($r | ConvertTo-Json -Depth 10) | Set-Content -LiteralPath $REG_PATH -Encoding utf8
  } catch {}
}

function GetTbotProcs(){
  Get-CimInstance Win32_Process -Filter "Name='python.exe'" |
    Where-Object { $_.CommandLine -match "tbot\.main" -or $_.CommandLine -match "\-m\s+tbot\.main" } |
    Select-Object ProcessId,ParentProcessId,CommandLine
}

function SpawnRuntime(){
  if([DateTime]::UtcNow -lt $backoffUntil){
    LogLine ("SPAWN_SKIP: backoff active until=" + $backoffUntil.ToString("o"))
    return 0
  }

  $delta = ([DateTime]::UtcNow - $lastSpawnUtc).TotalSeconds
  if($delta -lt $SPAWN_MIN_INTERVAL_SEC){
    LogLine ("SPAWN_SKIP: throttle delta_sec=" + [int]$delta)
    return 0
  }

  $lastSpawnUtc = [DateTime]::UtcNow

   = Join-Path $LOGS ("tbot_stdout_superv_v4_" + (Get-Date -Format "yyyyMMdd_HHmmss") + ".txt")
   = Join-Path $LOGS ("tbot_stderr_superv_v4_" + (Get-Date -Format "yyyyMMdd_HHmmss") + ".txt")

  $env:PYTHONPATH = $CODE
  $env:TBOT_RUNROOT = $RUNROOT

  LogLine ("SPAWN: " + $PY + " " + ($TBOT_ARGS -join " "))

  $p = Start-Process -FilePath $PY -WorkingDirectory $CODE -ArgumentList $TBOT_ARGS -PassThru 
         

  Start-Sleep -Seconds $FAST_EXIT_WINDOW_SEC

  $alive = $true
  try { $alive = -not $p.HasExited } catch { $alive = $true }

  if(-not $alive){
    $fastExitCount++
    try { LogLine ("SPAWN_EXIT_FAST pid=" + $p.Id + " exit=" + $p.ExitCode + " fastExitCount=" + $fastExitCount) } catch { LogLine ("SPAWN_EXIT_FAST pid=" + $p.Id) }
    if($fastExitCount -ge $FAST_EXIT_MAX){
      $backoffUntil = [DateTime]::UtcNow.AddSeconds($BACKOFF_SEC)
      LogLine ("BACKOFF_SET sec=" + $BACKOFF_SEC)
    }
  } else {
    $fastExitCount = 0
    LogLine ("SPAWN_OK pid=" + $p.Id)
  }

  $r = LoadRegistry
  if($r){
    $r.pid = $p.Id
    $r.status = "RUNNING"
    $r.last_action = "SPAWN"
    SaveRegistry $r
  }

  return $p.Id
}

LogLine "SUPERV_V4_START"

while($true){
  try {
    # enforce single TBOT runtime (kill duplicates)
    $procs = @(GetTbotProcs)
    if($procs.Count -gt 1){
      $keep = ($procs | Sort-Object ProcessId -Descending | Select-Object -First 1).ProcessId
      foreach($x in $procs){
        if($x.ProcessId -ne $keep){
          try { Stop-Process -Id $x.ProcessId -Force -ErrorAction SilentlyContinue } catch {}
        }
      }
      LogLine ("KILL_DUPLICATES keep=" + $keep + " killed=" + ($procs.Count - 1))
    }

    # if none running -> consider spawn
    $procs2 = @(GetTbotProcs)
    if($procs2.Count -eq 0){
      SpawnRuntime | Out-Null
    } else {
      # healthy enough: do nothing
    }

  } catch {
    LogLine ("SUPERV_LOOP_ERR=" + $_.Exception.Message)
  }

  Start-Sleep -Seconds $LOOP_SEC
}






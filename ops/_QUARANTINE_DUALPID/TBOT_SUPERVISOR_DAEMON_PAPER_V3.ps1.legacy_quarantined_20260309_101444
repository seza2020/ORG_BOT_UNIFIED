$ErrorActionPreference="Stop"
Add-Type -AssemblyName System.Threading

function Try-AcquireMutex([string]$name){
  $createdNew = $false
  $m = New-Object System.Threading.Mutex($true, $name, [ref]$createdNew)
  if(-not $createdNew){
    return @($false, $null)
  }
  return @($true, $m)
}

function Try-AtomicLock([string]$path){
  New-Item -ItemType Directory -Force (Split-Path $path -Parent) | Out-Null
  try {
    $fs = [System.IO.File]::Open($path,[System.IO.FileMode]::CreateNew,[System.IO.FileAccess]::Write,[System.IO.FileShare]::None)
    $sw = New-Object System.IO.StreamWriter($fs)
    $sw.WriteLine("TS=2026-03-05T11:31:40.7003084-08:00")
    $sw.WriteLine("SUPERV_PWSH_PID=19820")
    $sw.Flush(); $sw.Dispose(); $fs.Dispose()
    return $true
  } catch { return $false }
}


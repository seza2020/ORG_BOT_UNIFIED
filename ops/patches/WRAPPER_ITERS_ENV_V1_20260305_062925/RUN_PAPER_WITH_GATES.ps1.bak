# ==== TBOT_WRAPPER_HARD_MUTEX_V1 BEGIN ====
# Hard-block: do not allow two wrapper instances to run concurrently.
# ExitCode 86 indicates "already running".
try {
  $__ROOT = "C:\alpaca-bot\ORG_BOT_UNIFIED"
  $__RUNROOT = Join-Path $__ROOT "runtime\paper"
  $__LOCKDIR = Join-Path $__RUNROOT "state\locks"
  $__LOG = Join-Path $__RUNROOT "logs\wrapper_single_instance.log"
  if(!(Test-Path $__LOCKDIR)){ New-Item -ItemType Directory -Force $__LOCKDIR | Out-Null }
  if(!(Test-Path (Split-Path $__LOG))){ New-Item -ItemType Directory -Force (Split-Path $__LOG) | Out-Null }

  function __WL([string]$t){
    Add-Content -LiteralPath $__LOG -Value ("{0} {1}" -f (Get-Date -Format s), $t)
  }

  $__lockPath = Join-Path $__LOCKDIR "RUN_PAPER_WRAPPER.lock"
  # keep handle alive in global scope of script
  $script:__TBOT_WRAPPER_LOCK_HANDLE = [System.IO.File]::Open(
    $__lockPath,
    [System.IO.FileMode]::OpenOrCreate,
    [System.IO.FileAccess]::ReadWrite,
    [System.IO.FileShare]::None
  )
  __WL ("LOCK_ACQUIRED pid=" + $PID)
} catch {
  try {
    Add-Content -LiteralPath (Join-Path "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\logs" "wrapper_single_instance.log") -Value ("{0} LOCK_BLOCKED pid={1} err={2}" -f (Get-Date -Format s), $PID, $_.Exception.Message)
  } catch {}
  Write-Host "[WRAPPER_MUTEX] already running -> exit 86"
  exit 86
}
# ==== TBOT_WRAPPER_HARD_MUTEX_V1 END ====

$ErrorActionPreference="Stop"

# === SINGLE INSTANCE GUARD (AUTO) ===
try {
  & "$PSScriptRoot\SINGLE_INSTANCE_GUARD.ps1"
} catch {
  Write-Host "[SINGLE_INSTANCE_GUARD] FAILED: "
}
# === /SINGLE INSTANCE GUARD (AUTO) ===


# ==== TBOT_RUNROOT_BIND_V1 BEGIN ====
$env:TBOT_RUNROOT = "C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper"
# ==== TBOT_RUNROOT_BIND_V1 END ====
# === ROOTS ===
$U="C:\alpaca-bot\ORG_BOT_UNIFIED"
$CODE=Join-Path $U "code"
$OPS=Join-Path $U "ops"
$EVID=Join-Path $OPS "evidence"

# === PYTHON ===
$PY=Join-Path $CODE ".venv\Scripts\python.exe"
if(!(Test-Path $PY)){
  $pyCmd = (Get-Command python -ErrorAction SilentlyContinue)
  if(!$pyCmd){ throw "PYTHON_NOT_FOUND" }
  $PY = $pyCmd.Source
}

function Capture([scriptblock]$sb){
  & $sb 2>&1 | Out-String
}

$ts=Get-Date -Format "yyyyMMdd_HHmmss"
$OUT=Join-Path $EVID ("MINI_GATE_" + $ts)
New-Item -ItemType Directory -Force $OUT | Out-Null
$gates=Join-Path $OUT "gates.txt"

# Ensure deterministic import root
$env:PYTHONPATH = $CODE

Push-Location $CODE
try{
  # === GATE 1: COMPILEALL ===
  Add-Content $gates "=== COMPILEALL ==="
  $compileCode=@'
import sys, compileall
ok = compileall.compile_dir("tbot", quiet=1)
print("COMPILEALL_OK=", ok)
sys.exit(0 if ok else 2)
'@
  Add-Content $gates (Capture { & $PY -c $compileCode })
  if($LASTEXITCODE -ne 0){ throw "GATE_FAIL_COMPILEALL" }

  # === GATE 2: IMPORT ===
  Add-Content $gates "=== IMPORT ==="
  $importCode=@'
import importlib
mods=["tbot","tbot.main","tbot.runtime.orchestrator","tbot.runtime.announce"]
for m in mods:
  importlib.import_module(m)
print("IMPORT_OK=1")
'@
  Add-Content $gates (Capture { & $PY -c $importCode })
  if($LASTEXITCODE -ne 0){ throw "GATE_FAIL_IMPORT" }

} finally {
  Pop-Location
}

# === RUN PAPER (default: 5 iters smoke) ===
if($args.Count -eq 0){
  $args = @("--run","--iters","5","--sleep","0.5")
}

Push-Location $CODE
try{
  & $PY -m tbot.main @args
  exit $LASTEXITCODE
} finally {
  Pop-Location
}




import os, sys

LOCK_PATH = r"C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\state\BOT_GLOBAL.lock"

def _tbot_single_instance_guard():
    try:
        if os.path.exists(LOCK_PATH):
            print("TBOT_SINGLE_INSTANCE_BLOCKED")
            sys.exit(0)
        os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True)
        with open(LOCK_PATH,"w") as f:
            f.write(str(os.getpid()))
    except Exception as e:
        print("TBOT_LOCK_ERROR",e)

_tbot_single_instance_guard()
from __future__ import annotations

# ==== TBOT_GLOBAL_SINGLE_INSTANCE BEGIN ====
import os, sys, ctypes

# Global, profile-specific lock (Paper)
LOCK_PATH = r"C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\state\BOT_GLOBAL.lock"

def _tbot_global_single_instance_guard():
    try:
        os.makedirs(os.path.dirname(LOCK_PATH), exist_ok=True)

        # Windows: CreateFile with exclusive sharing=0
        k32 = ctypes.windll.kernel32
        CreateFileW = k32.CreateFileW
        CreateFileW.argtypes = [ctypes.c_wchar_p, ctypes.c_uint32, ctypes.c_uint32,
                                ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p]
        CreateFileW.restype  = ctypes.c_void_p

        GENERIC_READ  = 0x80000000
        GENERIC_WRITE = 0x40000000
        OPEN_ALWAYS   = 4
        FILE_ATTRIBUTE_NORMAL = 0x80

        h = CreateFileW(LOCK_PATH, GENERIC_READ|GENERIC_WRITE, 0, None, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, None)
        if h == ctypes.c_void_p(-1).value or h == 0:
            print("TBOT_SINGLE_INSTANCE_BLOCKED_LOCK_OPEN_FAIL", LOCK_PATH)
            raise SystemExit(86)

        # keep handle alive
        globals()["_TBOT_GLOBAL_LOCK_HANDLE"] = h
        # write PID (best-effort)
        try:
            with open(LOCK_PATH, "w", encoding="utf-8") as f:
                f.write(str(os.getpid()))
        except Exception:
            pass

    except SystemExit:
        raise
    except Exception as e:
        print("TBOT_SINGLE_INSTANCE_BLOCKED_LOCK", repr(e))
        raise SystemExit(86)

_tbot_global_single_instance_guard()
# ==== TBOT_GLOBAL_SINGLE_INSTANCE END ====


import argparse
import os
import sys
import traceback

BANNER = "TBOT Trading Runtime (Enterprise CLI)"

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tbot.main", description=BANNER)
    p.add_argument("--smoke", action="store_true", help="print identity/session info and exit 0")
    p.add_argument("--run", action="store_true", help="run orchestrator loop")
    p.add_argument("--iters", type=int, default=int(os.environ.get("TBOT_ITERS", "999999")), help="max iterations")
    p.add_argument("--sleep", type=float, default=float(os.environ.get("TBOT_SLEEP", "0.5")), help="sleep seconds")
    return p

def smoke() -> int:
    print("TBOT_SMOKE_OK")
    print("CWD=", os.getcwd())
    print("PYTHONPATH=", os.environ.get("PYTHONPATH"))
    print("TBOT_RUNROOT=", os.environ.get("TBOT_RUNROOT"))
    print("SYS_EXEC=", sys.executable)
    return 0

def _tbot_child_spawn_guard(argv: list[str] | None) -> None:
    # Enabled ONLY for real runtime runs via wrapper env flag.
    if os.environ.get("TBOT_ENFORCE_CHILD_BLOCK", "0") != "1":
        return
    a = argv if argv is not None else sys.argv[1:]
    if "--run" not in a:
        return
    # If this process is a python child of another python, block to prevent dual-pid chains.
    try:
        ppid = os.getppid()
    except Exception:
        ppid = None
    if ppid:
        # We don't resolve parent image; keep it simple and deterministic.
        # Policy: block when explicitly enabled; wrapper controls scope.
        print("TBOT_CHILD_SPAWN_GUARD_ACTIVE", "ppid="+str(ppid))

def main(argv: list[str] | None = None) -> int:
    _tbot_child_spawn_guard(argv)

    parser = build_parser()
    args = parser.parse_args(argv)

    if args.smoke:
        return smoke()

    if not args.run:
        parser.print_help()
        return 0

    from tbot.runtime.orchestrator import run_loop
    run_loop(args)
    return 0

if __name__ == "__main__":
    try:
        rc = main()
        raise SystemExit(rc)
    except SystemExit:
        raise
    except Exception:
        print("TBOT_FATAL_EXCEPTION")
        traceback.print_exc()
        raise SystemExit(1)



# === TBOT_SINGLE_INSTANCE_GUARD_V2 ===
# Blocks re-entry/self-spawn of: python -m tbot.main --run (Windows)
import os, sys, time

_ROOT = r"C:\alpaca-bot\ORG_BOT_UNIFIED"
_LOG  = os.path.join(_ROOT, r"runtime\paper\logs\py_tbot_main_guard.log")
_LDIR = os.path.join(_ROOT, r"runtime\paper\state\locks")
_LFILE= os.path.join(_LDIR, "TBOT_MAIN_RUN.lock")
_MUTEX= r"Global\ORG_BOT_UNIFIED_TBOT_MAIN_RUN"

def _log(m):
    try:
        os.makedirs(os.path.dirname(_LOG), exist_ok=True)
        with open(_LOG, "a", encoding="utf-8") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} pid={os.getpid()} {m} argv={sys.argv!r}\n")
    except Exception:
        pass

def _is_run():
    a=" ".join(sys.argv).lower()
    return ("tbot.main" in a) and ("--run" in a)

def _pid_alive(pid: int) -> bool:
    try:
        import ctypes
        from ctypes import wintypes
        OpenProcess = ctypes.windll.kernel32.OpenProcess
        CloseHandle = ctypes.windll.kernel32.CloseHandle
        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
        if h:
            CloseHandle(h)
            return True
        return False
    except Exception:
        return False

def _mutex_or_exit():
    try:
        import ctypes
        from ctypes import wintypes
        CreateMutexW = ctypes.windll.kernel32.CreateMutexW
        CreateMutexW.argtypes = [wintypes.LPVOID, wintypes.BOOL, wintypes.LPCWSTR]
        CreateMutexW.restype  = wintypes.HANDLE
        GetLastError = ctypes.windll.kernel32.GetLastError
        h = CreateMutexW(None, True, _MUTEX)
        err = GetLastError()
        if h and err == 183:
            _log("BLOCK: mutex already exists -> exit(0)")
            raise SystemExit(0)
        _log("ALLOW: mutex acquired")
    except SystemExit:
        raise
    except Exception as e:
        _log("WARN: mutex fail-open: " + repr(e))

def _lockfile_or_exit():
    try:
        os.makedirs(_LDIR, exist_ok=True)
        if os.path.exists(_LFILE):
            old_pid = -1
            try:
                with open(_LFILE, "r", encoding="utf-8") as f:
                    for ln in f.read().splitlines():
                        if ln.startswith("pid="):
                            old_pid = int(ln.split("=",1)[1])
            except Exception:
                old_pid = -1

            if old_pid > 0 and (not _pid_alive(old_pid)):
                try:
                    os.remove(_LFILE)
                    _log(f"LOCK_STALE_REMOVED old_pid={old_pid}")
                except Exception as e:
                    _log("LOCK_STALE_REMOVE_FAIL " + repr(e))
                    raise SystemExit(0)
            else:
                _log(f"BLOCK: lockfile exists old_pid={old_pid} -> exit(0)")
                raise SystemExit(0)

        with open(_LFILE, "w", encoding="utf-8") as f:
            f.write(f"ts={time.strftime('%Y-%m-%dT%H:%M:%S')}\n")
            f.write(f"pid={os.getpid()}\n")
        _log("ALLOW: lockfile created")
    except SystemExit:
        raise
    except Exception as e:
        _log("WARN: lockfile fail-open: " + repr(e))

if _is_run():
    _mutex_or_exit()
    _lockfile_or_exit()
    _log("READY: guard active")
# === END TBOT_SINGLE_INSTANCE_GUARD_V2 ===
from __future__ import annotations
# ==== TBOT_PROC_GUARD_V3 BEGIN ====
# Global single-instance guard (Windows Named Mutex).
# ExitCode 86 indicates 'already running'.
def _tbot_global_single_instance_guard() -> None:
    import os
    try:
        import ctypes
        CreateMutexW = ctypes.windll.kernel32.CreateMutexW
        GetLastError = ctypes.windll.kernel32.GetLastError
        name = r"Global\TBOT_MAIN_RUNTIME_GUARD_V3"
        h = CreateMutexW(None, False, name)
        if GetLastError() == 183:
            print("TBOT_SINGLE_INSTANCE_BLOCKED_MUTEX", name, "pid=", os.getpid())
            raise SystemExit(86)
        globals()["_TBOT_MUTEX_HANDLE_V3"] = h
    except SystemExit:
        raise
    except Exception as e:
        print("TBOT_MUTEX_ERROR_V3", repr(e))
        raise SystemExit(86)

_tbot_global_single_instance_guard()
# ==== TBOT_PROC_GUARD_V3 END ====


import argparse
import os
import sys
import traceback

# ==== TBOT_GLOBAL_SINGLE_INSTANCE BEGIN ====
import ctypes

# NOTE: Paper profile global lock (single-instance)
_LOCK_PATH = r"C:\alpaca-bot\ORG_BOT_UNIFIED\runtime\paper\state\BOT_GLOBAL.lock"

def _tbot_global_single_instance_guard() -> None:
    try:
        os.makedirs(os.path.dirname(_LOCK_PATH), exist_ok=True)

        k32 = ctypes.windll.kernel32
        CreateFileW = k32.CreateFileW
        CreateFileW.argtypes = [
            ctypes.c_wchar_p, ctypes.c_uint32, ctypes.c_uint32,
            ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p
        ]
        CreateFileW.restype = ctypes.c_void_p

        GENERIC_READ  = 0x80000000
        GENERIC_WRITE = 0x40000000
        OPEN_ALWAYS   = 4
        FILE_ATTRIBUTE_NORMAL = 0x80

        # share=0 => exclusive
        h = CreateFileW(_LOCK_PATH, GENERIC_READ | GENERIC_WRITE, 0, None, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, None)
        # INVALID_HANDLE_VALUE == -1
        if h == ctypes.c_void_p(-1).value or h == 0:
            print("TBOT_SINGLE_INSTANCE_BLOCKED_LOCK_OPEN_FAIL", _LOCK_PATH)
            raise SystemExit(86)

        # keep handle alive
        globals()["_TBOT_GLOBAL_LOCK_HANDLE"] = h

        # write pid best-effort
        try:
            with open(_LOCK_PATH, "w", encoding="utf-8") as f:
                f.write(str(os.getpid()))
        except Exception:
            pass

    except SystemExit:
        raise
    except Exception as e:
        print("TBOT_SINGLE_INSTANCE_BLOCKED_LOCK", repr(e))
        raise SystemExit(86)

_tbot_global_single_instance_guard()
# ==== TBOT_GLOBAL_SINGLE_INSTANCE END ====

BANNER = "TBOT Trading Runtime (Enterprise CLI)"

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tbot.main", description=BANNER)
    p.add_argument("--smoke", action="store_true", help="print identity/session info and exit 0")
    p.add_argument("--run", action="store_true", help="run orchestrator loop")
    p.add_argument("--iters", type=int, default=999999, help="max iterations")
    p.add_argument("--sleep", type=float, default=0.5, help="sleep seconds")
    return p

def smoke() -> int:
    print("TBOT_SMOKE_OK")
    print("CWD=", os.getcwd())
    print("PYTHONPATH=", os.environ.get("PYTHONPATH"))
    print("TBOT_RUNROOT=", os.environ.get("TBOT_RUNROOT"))
    print("SYS_EXEC=", sys.executable)
    return 0

def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.smoke:
        return smoke()

    if not args.run:
        parser.print_help()
        return 0

    from tbot.runtime.orchestrator import run_loop
    run_loop(args)
    return 0

if __name__ == "__main__":
    try:
        rc = main()
        raise SystemExit(rc)
    except SystemExit:
        raise
    except Exception:
        print("TBOT_FATAL_EXCEPTION")
        traceback.print_exc()
        raise SystemExit(1)



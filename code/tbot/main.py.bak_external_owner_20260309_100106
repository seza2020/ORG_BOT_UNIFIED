from __future__ import annotations

import argparse
import atexit
import json
import os
import sys
import time
import traceback
from pathlib import Path

ROOT = Path(r"C:\alpaca-bot\ORG_BOT_UNIFIED")
RUNROOT = Path(os.environ.get("TBOT_RUNROOT", str(ROOT / r"runtime\paper")))
LOGDIR = RUNROOT / "logs"
LOCKDIR = RUNROOT / "state" / "locks"
BOOTFILE = LOGDIR / "dualpid_bootstrap_v2.jsonl"
OBSFILE = LOGDIR / "dualpid_fix_events_v2.jsonl"
LOCKFILE = LOCKDIR / "tbot_main_owner.lock"

_LOCK_OWNER = False

def _write_jsonl(path: Path, row: dict) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(row, ensure_ascii=False) + "\n")
    except Exception:
        pass

def _emit_boot(kind: str, **payload) -> None:
    _write_jsonl(BOOTFILE, {
        "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        "kind": kind,
        "pid": os.getpid(),
        "ppid": os.getppid(),
        "argv": sys.argv,
        "payload": payload,
    })

def _emit(kind: str, **payload) -> None:
    _write_jsonl(OBSFILE, {
        "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
        "kind": kind,
        "pid": os.getpid(),
        "ppid": os.getppid(),
        "argv": sys.argv,
        "payload": payload,
    })

def _is_run_mode() -> bool:
    return "--run" in sys.argv

def _parent_image() -> str:
    if os.name != "nt":
        return ""
    try:
        import ctypes
        from ctypes import wintypes

        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        OpenProcess = ctypes.windll.kernel32.OpenProcess
        CloseHandle = ctypes.windll.kernel32.CloseHandle
        QueryFullProcessImageNameW = ctypes.windll.kernel32.QueryFullProcessImageNameW

        OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        OpenProcess.restype = wintypes.HANDLE
        CloseHandle.argtypes = [wintypes.HANDLE]
        CloseHandle.restype = wintypes.BOOL
        QueryFullProcessImageNameW.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.LPWSTR, ctypes.POINTER(wintypes.DWORD)]
        QueryFullProcessImageNameW.restype = wintypes.BOOL

        h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, os.getppid())
        if not h:
            return ""
        try:
            size = wintypes.DWORD(32768)
            buf = ctypes.create_unicode_buffer(size.value)
            ok = QueryFullProcessImageNameW(h, 0, buf, ctypes.byref(size))
            return buf.value if ok else ""
        finally:
            CloseHandle(h)
    except Exception:
        return ""

def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        import ctypes
        PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
        STILL_ACTIVE = 259
        OpenProcess = ctypes.windll.kernel32.OpenProcess
        GetExitCodeProcess = ctypes.windll.kernel32.GetExitCodeProcess
        CloseHandle = ctypes.windll.kernel32.CloseHandle
        h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
        if not h:
            return False
        try:
            code = ctypes.c_ulong()
            ok = GetExitCodeProcess(h, ctypes.byref(code))
            return bool(ok and code.value == STILL_ACTIVE)
        finally:
            CloseHandle(h)
    except Exception:
        return False

def _is_child_reentry() -> bool:
    if not _is_run_mode():
        return False
    argv0 = Path(sys.argv[0]).name.lower() if sys.argv else ""
    parent_img = (_parent_image() or "").lower()
    return (
        argv0 == "main.py" and
        parent_img.endswith("\\python.exe") and
        os.environ.get("TBOT_RUNTIME_MANAGER", "0") != "1"
    )

def _install_single_owner_guard() -> None:
    global _LOCK_OWNER

    _emit_boot("guard_enter")

    if not _is_run_mode():
        _emit_boot("guard_skip_not_run_mode")
        return

    if _is_child_reentry():
        _emit_boot("child_reentry_block")
        raise SystemExit(0)

    LOCKDIR.mkdir(parents=True, exist_ok=True)

    if LOCKFILE.exists():
        try:
            txt = LOCKFILE.read_text(encoding="utf-8", errors="ignore")
            import re
            m = re.search(r"pid=(\d+)", txt)
            if m:
                old_pid = int(m.group(1))
                if _pid_alive(old_pid):
                    _emit_boot("lock_live_owner_block", old_pid=old_pid)
                    raise SystemExit(0)
                else:
                    LOCKFILE.unlink(missing_ok=True)
                    _emit_boot("lock_stale_removed", old_pid=old_pid)
            else:
                LOCKFILE.unlink(missing_ok=True)
                _emit_boot("lock_unparseable_removed")
        except SystemExit:
            raise
        except Exception as e:
            _emit_boot("lock_check_warn_fail_open", error=repr(e))

    try:
        with open(LOCKFILE, "x", encoding="utf-8") as f:
            f.write(f"pid={os.getpid()}\nppid={os.getppid()}\n")
        _LOCK_OWNER = True
        _emit_boot("lock_created", lockfile=str(LOCKFILE))
    except FileExistsError:
        _emit_boot("lock_exists_race_block", lockfile=str(LOCKFILE))
        raise SystemExit(0)

def _cleanup() -> None:
    try:
        if _LOCK_OWNER and LOCKFILE.exists():
            txt = LOCKFILE.read_text(encoding="utf-8", errors="ignore")
            if f"pid={os.getpid()}" in txt:
                LOCKFILE.unlink(missing_ok=True)
                _emit_boot("lock_removed")
    except Exception as e:
        _emit_boot("cleanup_warn", error=repr(e))

atexit.register(_cleanup)

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="tbot.main", description="ORG_BOT_UNIFIED Runtime")
    p.add_argument("--smoke", action="store_true")
    p.add_argument("--run", action="store_true")
    p.add_argument("--iters", type=int, default=999999)
    p.add_argument("--sleep", type=float, default=0.5)
    return p

def smoke() -> int:
    _emit_boot("smoke")
    print("TBOT_SMOKE_OK")
    print("CWD=", os.getcwd())
    print("PYTHONPATH=", os.environ.get("PYTHONPATH"))
    print("TBOT_RUNROOT=", os.environ.get("TBOT_RUNROOT"))
    print("SYS_EXEC=", sys.executable)
    return 0

def main(argv: list[str] | None = None) -> int:
    _emit_boot("main_enter")
    _install_single_owner_guard()

    parser = build_parser()
    args = parser.parse_args(argv)

    if args.smoke:
        _emit("smoke")
        return smoke()

    if not args.run:
        parser.print_help()
        _emit_boot("help_exit")
        return 0

    _emit_boot("before_orchestrator_import")
    from tbot.runtime.orchestrator import run_loop
    _emit_boot("after_orchestrator_import")

    _emit("run_loop_enter")
    rc = run_loop(args)
    _emit("run_loop_exit", rc=0 if rc is None else rc)
    return 0 if rc is None else int(rc)

if __name__ == "__main__":
    try:
        _emit_boot("if_main_enter")
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception:
        err = traceback.format_exc()
        _emit_boot("fatal_exception", error=err)
        print("TBOT_FATAL_EXCEPTION", flush=True)
        traceback.print_exc()
        raise SystemExit(1)

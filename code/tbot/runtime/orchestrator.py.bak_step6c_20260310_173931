def _safe_alpha_mode(core_ctx, regime, run_id=None):
    try:
        from tbot.runtime.alpha_mode import compute_alpha_mode
        return compute_alpha_mode(core_ctx, regime)
    except BaseException as e:
        _emit(
            "alpha_mode_fail",
            {
                "error_type": type(e).__name__,

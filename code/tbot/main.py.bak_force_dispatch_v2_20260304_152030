def _tbot_singleton_guard():
    import os, sys, time
    runroot = os.environ.get("TBOT_RUNROOT", "")
    if not runroot:
        return  # no runroot => don't block
    lock_dir = os.path.join(runroot, "state", "locks")
    os.makedirs(lock_dir, exist_ok=True)
    lock_path = os.path.join(lock_dir, "TBOT_MAIN_SINGLETON.lock")

    # if lock exists and pid is alive -> exit
    try:
        if os.path.exists(lock_path):
            try:
                with open(lock_path, "r", encoding="utf-8") as f:
                    txt = f.read()
                pid = None
                for line in txt.splitlines():
                    if line.startswith("pid="):
                        pid = int(line.split("=",1)[1].strip())
                        break
                if pid:
                    # Windows: os.kill(pid,0) works for existence check in py3.13
                    try:
                        os.kill(pid, 0)
                        # someone alive -> refuse duplicate
                        sys.exit(0)
                    except Exception:
                        pass
            except Exception:
                pass

        # claim lock
        with open(lock_path, "w", encoding="utf-8") as f:
            f.write(f"pid={os.getpid()}\n")
            f.write(f"ts={time.time()}\n")
    except Exception:
        return

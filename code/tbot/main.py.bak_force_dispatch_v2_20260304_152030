def _pop_force_signal_sid_inplace(argv: list[str]) -> Optional[str]:
    """
    Compatibility shim: allow passing raw arg like --force_signal_sid=SID
    without requiring argparse to know it.
    This function must NOT exit; it only edits argv in-place.
    """
    prefix = "--force_signal_sid="
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith(prefix):
            sid = a[len(prefix):].strip()
            del argv[i]
            return sid or None
        i += 1
    return None



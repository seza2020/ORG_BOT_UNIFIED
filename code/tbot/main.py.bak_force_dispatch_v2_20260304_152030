def __tbot_cli_entry__():

    parser = argparse.ArgumentParser(
        prog="tbot.main",
        description="TBOT Trading Runtime"
    )

    parser.add_argument(
        "--run",
        action="store_true",
        help="start orchestrator loop"
    )

    parser.add_argument(
        "--sleep",
        type=float,
        default=1.0,
        help="loop sleep seconds"
    )

    parser.add_argument(
        "--iters",
        type=int,
        default=None,
        help="max loop iterations"
    )

    args = parser.parse_args()
    if args.run:
        import sys
        print("TBOT_RUN_DISPATCH_ENTER"); sys.stdout.flush()
        __tbot_trace_write("RUN_DISPATCH_ENTER")
        from tbot.runtime.orchestrator import run_loop
        __tbot_trace_write("ABOUT_TO_CALL_RUN_LOOP")
        print("TBOT_CALLING_RUN_LOOP"); sys.stdout.flush()
        rc = run_loop(args)
        __tbot_trace_write("RUN_LOOP_RETURNED rc="+str(rc))
        print("TBOT_RUN_LOOP_RETURNED", rc); sys.stdout.flush()
        return 0



param(
  [int]$iters = 240,
  [double]$sleep = 0.25,
  [double]$gate_min_rr = 1.0,
  [double]$gate_min_conf = 0.0,
  [int]$gate_cooldown_sec = 300,
  [int]$gate_max_plans_per_day = 20,
  [double]$gate_max_risk_usd = 500
)

Set-StrictMode -Version Latest
$ErrorActionPreference = "Continue"

function Ensure-Dir([string]$p) {
  if (!(Test-Path $p)) { New-Item -ItemType Directory -Path $p -Force | Out-Null }
}

function Tail-File([string]$outFile, [string]$path, [int]$n) {
  if (Test-Path $path) {
    "" | Add-Content -LiteralPath $outFile -Encoding UTF8
    ("=== TAIL {0} : {1} ===" -f $n, $path) | Add-Content -LiteralPath $outFile -Encoding UTF8
    Get-Content -LiteralPath $path -Tail $n -ErrorAction SilentlyContinue | Add-Content -LiteralPath $outFile -Encoding UTF8
  } else {
    ("MISSING_FILE: {0}" -f $path) | Add-Content -LiteralPath $outFile -Encoding UTF8
  }
}

function Grep-Lines([string]$outFile, [string]$inFile, [string[]]$patterns, [int]$maxLines = 400) {
  "" | Set-Content -LiteralPath $outFile -Encoding UTF8
  ("INFILE={0}" -f $inFile) | Add-Content -LiteralPath $outFile -Encoding UTF8
  foreach ($pat in $patterns) {
    "" | Add-Content -LiteralPath $outFile -Encoding UTF8
    ("=== PATTERN: {0} ===" -f $pat) | Add-Content -LiteralPath $outFile -Encoding UTF8
    if (Test-Path $inFile) {
      Select-String -Path $inFile -Pattern $pat -AllMatches -ErrorAction SilentlyContinue |
        Select-Object -Last $maxLines |
        ForEach-Object { "{0}:{1}:{2}" -f $_.Path, $_.LineNumber, $_.Line } |
        Add-Content -LiteralPath $outFile -Encoding UTF8
    }
  }
}

function Build-Kpi([string]$outFile, [string]$inFile) {
  "" | Set-Content -LiteralPath $outFile -Encoding UTF8
  ("INFILE={0}" -f $inFile) | Add-Content -LiteralPath $outFile -Encoding UTF8
  if (!(Test-Path $inFile)) { "MISSING_INFILE" | Add-Content -LiteralPath $outFile -Encoding UTF8; return }

  $c_signal = @(Select-String -Path $inFile -Pattern "signal_fire" -AllMatches -ErrorAction SilentlyContinue).Count
  $c_accept = @(Select-String -Path $inFile -Pattern "shadow_accept" -AllMatches -ErrorAction SilentlyContinue).Count
  $c_reject = @(Select-String -Path $inFile -Pattern "shadow_reject" -AllMatches -ErrorAction SilentlyContinue).Count
  $c_plan   = @(Select-String -Path $inFile -Pattern "shadow_plan" -AllMatches -ErrorAction SilentlyContinue).Count
  $c_skip   = @(Select-String -Path $inFile -Pattern "signal_skip" -AllMatches -ErrorAction SilentlyContinue).Count

  "KPI_signal_fire=$c_signal" | Add-Content -LiteralPath $outFile -Encoding UTF8
  "KPI_shadow_accept=$c_accept" | Add-Content -LiteralPath $outFile -Encoding UTF8
  "KPI_shadow_reject=$c_reject" | Add-Content -LiteralPath $outFile -Encoding UTF8
  "KPI_shadow_plan=$c_plan" | Add-Content -LiteralPath $outFile -Encoding UTF8
  "KPI_signal_skip=$c_skip" | Add-Content -LiteralPath $outFile -Encoding UTF8
}

# Paths
$root = "C:\alpaca-bot\org_bot"
$opsDir = Join-Path $root "logs\ops"
Ensure-Dir $opsDir

$ts = Get-Date -Format "yyyyMMdd_HHmmss"
$outEnv  = Join-Path $opsDir ("ENV_{0}.txt" -f $ts)
$outComp = Join-Path $opsDir ("PYCOMPILE_{0}.txt" -f $ts)
$outRun  = Join-Path $opsDir ("RUN_{0}.txt" -f $ts)
$outGrep = Join-Path $opsDir ("GREP_{0}.txt" -f $ts)
$outKpi  = Join-Path $opsDir ("KPI_{0}.txt" -f $ts)

$announceLog = Join-Path $root "logs\announce.log"
$shadowJsonl = Join-Path $root "logs\shadow_plans.jsonl"

# 1) ENV dump
"=== ENV ===" | Set-Content -LiteralPath $outEnv -Encoding UTF8
Get-ChildItem Env:TBOT_* -ErrorAction SilentlyContinue |
  Sort-Object Name |
  ForEach-Object { "{0}={1}" -f $_.Name, $_.Value } |
  Add-Content -LiteralPath $outEnv -Encoding UTF8

# 2) py_compile key files (extend as needed)
"=== PY_COMPILE ===" | Set-Content -LiteralPath $outComp -Encoding UTF8
$pyFiles = @(
  "C:\alpaca-bot\org_bot\tbot\runtime\orchestrator.py",
  "C:\alpaca-bot\org_bot\tbot\strategies\s01_core.py",
  "C:\alpaca-bot\org_bot\tbot\strategies\s11_alpha.py",
  "C:\alpaca-bot\org_bot\tbot\strategies\registry.py"
)
foreach ($f in $pyFiles) {
  if (Test-Path $f) {
    ("PYCOMPILE: {0}" -f $f) | Add-Content -LiteralPath $outComp -Encoding UTF8
    python -m py_compile $f 2>&1 | Add-Content -LiteralPath $outComp -Encoding UTF8
    ("EXITCODE(py_compile)={0}" -f $LASTEXITCODE) | Add-Content -LiteralPath $outComp -Encoding UTF8
    "" | Add-Content -LiteralPath $outComp -Encoding UTF8
  } else {
    ("MISSING: {0}" -f $f) | Add-Content -LiteralPath $outComp -Encoding UTF8
  }
}

# 3) Run bot (robust)
$cmd = @(
  "python","-m","tbot.main",
  "--run",
  "--iters", "$iters",
  "--sleep", "$sleep",
  "--shadow",
  "--gate_min_rr", "$gate_min_rr",
  "--gate_min_conf", "$gate_min_conf",
  "--gate_cooldown_sec", "$gate_cooldown_sec",
  "--gate_max_plans_per_day", "$gate_max_plans_per_day",
  "--gate_max_risk_usd", "$gate_max_risk_usd"
)

("CMD: " + ($cmd -join " ")) | Set-Content -LiteralPath $outRun -Encoding UTF8

$exe  = $cmd[0]
$args = @($cmd[1..($cmd.Count-1)])

$runExit = 0
try {
  & $exe @args 2>&1 | Tee-Object -FilePath $outRun | Out-Null
  $runExit = $LASTEXITCODE
} catch {
  ("RUN_EXCEPTION=" + $_.Exception.Message) | Add-Content -LiteralPath $outRun -Encoding UTF8
  $runExit = 999
}
("EXITCODE(run)=$runExit") | Add-Content -LiteralPath $outRun -Encoding UTF8

# 4) Append tails
Tail-File $outRun $announceLog 200
Tail-File $outRun $shadowJsonl 80

# 5) Grep highlights
$patterns = @(
  "boot\s+\{",
  "regime\s+\{",
  "core_context\s+\{",
  "alpha_mode\s+\{",
  "signal_fire",
  "signal_skip",
  "strategy_result\s+\{'sid':\s*'S01'",
  "strategy_result\s+\{'sid':\s*'S11'",
  "shadow_accept",
  "shadow_reject",
  "shadow_plan",
  "cooldown_active",
  "TBOT_ENABLE_S01_LOGIC",
  "TBOT_S01_MIN_STRENGTH",
  "TBOT_ENABLE_S11_MVP",
  "\[S01DBG\]"
)
Grep-Lines $outGrep $outRun $patterns 300

# 6) KPI
Build-Kpi $outKpi $outRun

"OUT_RUN=$outRun"
"OUT_ENV=$outEnv"
"OUT_PYCOMPILE=$outComp"
"OUT_GREP=$outGrep"
"OUT_KPI=$outKpi"

